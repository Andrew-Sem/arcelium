+
+bool BrowserNativeWidgetMac::IsHandlingPlainCommandWKeyPress() const {
+  NSWindow* const window = GetNativeWindow().GetNativeNSWindow();
+  NSEvent* event = NSApp.currentEvent;
+  if (event.type != NSEventTypeKeyDown || event.keyCode != kVK_ANSI_W) {
+    return false;
+  }
+  const NSEventModifierFlags modifiers =
+      event.modifierFlags &
+      (NSEventModifierFlagCommand | NSEventModifierFlagShift |
+       NSEventModifierFlagOption | NSEventModifierFlagControl);
+  // NSApp.currentEvent stays set until the next event arrives, so ignore one
+  // that is no longer being handled.
+  return modifiers == NSEventModifierFlagCommand &&
+         NSProcessInfo.processInfo.systemUptime - event.timestamp < 1.0 &&
+         TopLevelWindow(event.window) == window;
+}
+
+std::string BrowserNativeWidgetMac::DescribeCurrentEventForCloseLog() const {
+  NSWindow* const window = GetNativeWindow().GetNativeNSWindow();
+  NSEvent* event = NSApp.currentEvent;
+  std::string description;
+  if (!event) {
+    description = "event=none";
+  } else {
+    description = base::StringPrintf(
+        "event=%lu age=%.2fs", static_cast<unsigned long>(event.type),
+        NSProcessInfo.processInfo.systemUptime - event.timestamp);
+    if (event.type == NSEventTypeKeyDown || event.type == NSEventTypeKeyUp) {
+      description += base::StringPrintf(
+          " keyCode=%d chars=%s modifiers=0x%lx repeat=%d", event.keyCode,
+          base::SysNSStringToUTF8(event.charactersIgnoringModifiers).c_str(),
+          static_cast<unsigned long>(
+              event.modifierFlags &
+              NSEventModifierFlagDeviceIndependentFlagsMask),
+          event.isARepeat);
+    } else if (event.type == NSEventTypeLeftMouseDown ||
+               event.type == NSEventTypeLeftMouseUp ||
+               event.type == NSEventTypeRightMouseUp ||
+               event.type == NSEventTypeOtherMouseUp) {
+      description += base::StringPrintf(
+          " location=(%.0f,%.0f) clicks=%ld", event.locationInWindow.x,
+          event.locationInWindow.y, static_cast<long>(event.clickCount));
+    }
+    description += base::StringPrintf(
+        " eventWindow=%s sameTopLevel=%d",
+        WindowClassName(event.window).c_str(),
+        TopLevelWindow(event.window) == window);
+  }
+  NSWindow* const key_window = NSApp.keyWindow;
+  description += base::StringPrintf(
+      " keyWindow=%s keyIsSelf=%d active=%d", WindowClassName(key_window).c_str(),
+      TopLevelWindow(key_window) == window, NSApp.active);
+  return description;
+}
