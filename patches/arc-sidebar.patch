+        kLittleWindowCornerRadius));
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(SkColorSetA(SK_ColorBLACK, 0x40));
+    canvas->DrawPath(shape, flags);
+    gfx::ScopedCanvas scoped_canvas(canvas);
+    canvas->ClipPath(shape, /*do_anti_alias=*/true);
+    for (views::Button* const part :
+         {static_cast<views::Button*>(open_button_.get()),
+          static_cast<views::Button*>(menu_button_.get())}) {
+      if (!part->GetVisible() ||
+          (part->GetState() != views::Button::STATE_HOVERED &&
+           part->GetState() != views::Button::STATE_PRESSED)) {
+        continue;
+      }
+      flags.setColor(SkColorSetA(
+          SK_ColorBLACK,
+          part->GetState() == views::Button::STATE_PRESSED ? 0x40 : 0x26));
+      canvas->DrawRect(gfx::RectF(part->bounds()), flags);
+    }
+  }
+  void AddedToWidget() override {
+    widget_observation_.Observe(GetWidget());
+    Update();
+  }
+  void RemovedFromWidget() override { widget_observation_.Reset(); }
+
+  // views::WidgetObserver:
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override {
+    // Another window may have become the last active one meanwhile.
+    if (active) {
+      Update();
+    }
+  }
+
+ private:
+  arc_spaces::SpacesController* GetTargetController() {
+    BrowserWindowInterface* const target =
+        arc_spaces::GetLittleWindowTarget(browser_);
+    arc_spaces::SpacesController* const controller =
+        target ? arc_spaces::SpacesController::From(target, /*create=*/false)
+               : nullptr;
+    return controller && controller->IsEnabled() &&
+                   !controller->spaces().empty()
+               ? controller
+               : nullptr;
+  }
+
+  void Update() {
+    arc_spaces::SpacesController* const controller = GetTargetController();
+    std::u16string text = u"Open in new window";
+    if (controller) {
+      const std::vector<arc_spaces::Space>& spaces = controller->spaces();
+      const auto it = std::ranges::find(spaces, controller->active_space_id(),
+                                        &arc_spaces::Space::id);
+      text = it == spaces.end()
+                 ? u"Open in window"
+                 : u"Open in " + arc_spaces::GetSpaceDisplayName(
+                                     *it, static_cast<size_t>(
+                                              it - spaces.begin()));
+    } else if (arc_spaces::GetLittleWindowTarget(browser_)) {
+      text = u"Open in window";
+    }
+    label_->SetText(text);
+    open_button_->SetTooltipText(text + u" (⌘O)");
+    open_button_->GetViewAccessibility().SetName(text);
+    const bool has_menu = controller && controller->spaces().size() > 1;
+    separator_->SetVisible(has_menu);
+    menu_button_->SetVisible(has_menu);
+  }
+
+  // Moves the page into the space with `space_id` of the window it moves into,
+  // else into the one showing there.
+  void Open(const std::string& space_id) {
+    if (!space_id.empty()) {
+      if (arc_spaces::SpacesController* const controller =
+              GetTargetController()) {
+        controller->SwitchTo(space_id);
+      }
+    }
+    // See BrowserCommandController, which moves the page on Cmd+O too.
+    chrome::ExecuteCommand(browser_, IDC_OPEN_FILE);
+  }
+
+  void ResetSpacesBubble() {
+    spaces_bubble_.reset();
+    spaces_bubble_delegate_.reset();
+  }
+
+  void ShowSpacesMenu() {
+    arc_spaces::SpacesController* const controller = GetTargetController();
+    if (!controller) {
+      return;
+    }
+    spaces_bubble_.reset();
+    spaces_bubble_delegate_ = CreateLittleWindowSpacesBubble(
+        menu_button_, browser_, controller->spaces(),
+        base::BindRepeating(&LittleWindowOpenButton::Open,
+                            weak_factory_.GetWeakPtr()));
+    spaces_bubble_ = views::BubbleDialogDelegate::CreateBubble(
+        spaces_bubble_delegate_.get(),
+        base::BindOnce(
+            [](base::WeakPtr<LittleWindowOpenButton> button,
+               views::Widget::ClosedReason) {
+              // Not from within the bubble's own closing.
+              base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+                  FROM_HERE,
+                  base::BindOnce(&LittleWindowOpenButton::ResetSpacesBubble,
+                                 button));
+            },
+            weak_factory_.GetWeakPtr()));
+#if BUILDFLAG(IS_MAC)
+    if (helium::ShouldUseNativeFrameMaterials(this)) {
+      helium::ShowNativeFrameMaterialBehindWidget(
+          spaces_bubble_.get(), GetWidget()->GetColorMode(),
+          GetLittleWindowTint(this, browser_), kLittleWindowCornerRadius);
+    }
+#endif
+    spaces_bubble_->Show();
+  }
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<views::Button> open_button_ = nullptr;
+  raw_ptr<views::Label> label_ = nullptr;
+  raw_ptr<views::View> separator_ = nullptr;
+  raw_ptr<views::ImageButton> menu_button_ = nullptr;
+  // The bubble outlives its delegate.
+  std::unique_ptr<views::BubbleDialogDelegate> spaces_bubble_delegate_;
+  std::unique_ptr<views::Widget> spaces_bubble_;
+  base::CallbackListSubscription spaces_changed_subscription_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      widget_observation_{this};
+  base::WeakPtrFactory<LittleWindowOpenButton> weak_factory_{this};
+};
