+// A bubble of the spaces of the window a little window's page moves into, to
+// move it into one of them: like the header, in the tint of the space showing
+// there. Rather than a menu, which macOS draws in its own colors.
+std::unique_ptr<views::BubbleDialogDelegate> CreateLittleWindowSpacesBubble(
+    views::View* anchor,
+    BrowserWindowInterface* browser,
+    const std::vector<arc_spaces::Space>& spaces,
+    base::RepeatingCallback<void(const std::string&)> open) {
+  auto bubble = std::make_unique<views::BubbleDialogDelegate>(
+      anchor, views::BubbleBorder::TOP_RIGHT,
+      views::BubbleBorder::DIALOG_SHADOW, /*autosize=*/true);
+  bubble->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  bubble->SetShowCloseButton(false);
+  bubble->SetEnableArrowKeyTraversal(true);
+  bubble->set_margins(gfx::Insets(4));
+  bubble->set_corner_radius(10);
+  // On the header's frame material, see ShowSpacesMenu(), if it has one.
+  const SkColor background = GetLittleWindowHeaderColor(anchor, browser);
+  bubble->SetBackgroundColor(helium::ShouldUseNativeFrameMaterials(anchor)
+                                 ? SK_ColorTRANSPARENT
+                                 : background);
+  const SkColor foreground =
+      SkColorSetA(color_utils::GetColorWithMaxContrast(background), 0xE6);
+
+  auto contents = std::make_unique<views::View>();
+  contents
+      ->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kVertical))
+      ->set_cross_axis_alignment(
+          views::BoxLayout::CrossAxisAlignment::kStretch);
+  for (size_t i = 0; i < spaces.size(); ++i) {
+    const gfx::VectorIcon* const icon =
+        arc_spaces::FindSpaceIcon(spaces[i].icon_id);
+    contents->AddChildView(std::make_unique<LittleWindowSpaceRow>(
+        base::BindRepeating(
+            [](views::View* contents,
+               base::RepeatingCallback<void(const std::string&)> open,
+               std::string id) {
+              // Closing, the page's window would close this too.
+              contents->GetWidget()->Close();
+              open.Run(id);
+            },
+            base::Unretained(contents.get()), open, spaces[i].id),
+        arc_spaces::GetSpaceDisplayName(spaces[i], i),
+        icon ? *icon : vector_icons::kHomeIcon, foreground));
+  }
+  bubble->SetContentsView(std::move(contents));
+  return bubble;
+}
