+SkColor GetFrameMaterialSurfaceColor(const views::View* view, SkColor color) {
+  const ui::ColorProvider* const color_provider =
+      view ? view->GetColorProvider() : nullptr;
+  if (!color_provider || !ShouldUseNativeFrameMaterials(view)) {
+    return color;
+  }
+  // The frame material takes the toolbar color as its tint, see
+  // UpdateNativeFrameMaterialBackgroundView(). Translucent surfaces count as
+  // they look over it.
+  const SkColor frame_color = color_provider->GetColor(kColorToolbar);
+  const float frame = GetLightness(frame_color);
+  const float surface = GetLightness(color_utils::AlphaBlend(
+      SkColorSetA(color, SK_AlphaOPAQUE), frame_color,
+      static_cast<SkAlpha>(SkColorGetA(color))));
+  const bool lighter = surface >= frame;
+  const float range = lighter ? 1 - frame : frame;
+  const float alpha =
+      range > 0 ? std::clamp(std::abs(surface - frame) / range, 0.0f, 1.0f)
+                : 0.0f;
+  return SkColorSetA(lighter ? SK_ColorWHITE : SK_ColorBLACK,
+                     static_cast<SkAlpha>(alpha * SK_AlphaOPAQUE + 0.5f));
+}
