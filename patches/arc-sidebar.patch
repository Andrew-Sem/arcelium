+
+// Saves the space with `space_id`, or a new one, opened only now, if empty.
+void SaveSpace(BrowserWindowInterface* browser,
+               std::string space_id,
+               ui::DialogModel* dialog_model,
+               SpaceIconPicker* icon_picker) {
+  arc_spaces::SpacesController* const controller =
+      arc_spaces::SpacesController::From(browser, /*create=*/false);
+  if (!controller || !controller->IsEnabled()) {
+    return;
+  }
+  if (space_id.empty()) {
+    space_id = controller->CreateSpace();
+  }
+  controller->SetSpaceName(
+      space_id,
+      dialog_model->GetTextfieldByUniqueId(kSpaceNameFieldId)->text());
+  controller->SetSpaceIcon(space_id, icon_picker->selected_id());
+  controller->SetSpaceIsolated(
+      space_id,
+      dialog_model->GetCheckboxByUniqueId(kSpaceIsolatedFieldId)->is_checked());
+}
