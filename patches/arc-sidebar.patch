+// The pill's surface on the frame, see CreateFrameMaterialSurfaceBackground():
+// `hover` of the way to the location bar's hovered color, a subtler hover.
+class AddressPillBackground : public views::Background {
+ public:
+  explicit AddressPillBackground(float hover) : hover_(hover) {}
+
+  // views::Background:
+  void Paint(gfx::Canvas* canvas, views::View* view) const override {
+    const ui::ColorProvider* const color_provider = view->GetColorProvider();
+    if (!color_provider) {
+      return;
+    }
+    const SkColor color = color_utils::AlphaBlend(
+        helium::GetFrameMaterialSurfaceColor(
+            view,
+            color_provider->GetColor(kColorLocationBarBackgroundHovered)),
+        helium::GetFrameMaterialSurfaceColor(
+            view, color_provider->GetColor(kColorLocationBarBackground)),
+        hover_);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(color);
+    canvas->DrawRoundRect(gfx::RectF(view->GetLocalBounds()),
+                          kAddressPillCornerRadius, flags);
+  }
+
+ private:
+  const float hover_;
+};
