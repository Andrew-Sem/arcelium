+                   radius);
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(SK_ColorWHITE);
+  canvas->DrawCircle(center, radius, flags);
+  flags.setColor(color);
+  canvas->DrawCircle(center, radius * 0.76f, flags);
+}
+
+enum class Glyph { kSystem, kLight, kDark, kRemove, kAdd, kPrevious, kNext };
+
+// A four-pointed star with curved sides.
+SkPath GetSparklePath(float x, float y, float radius) {
+  const float bend = radius * 0.14f;
+  SkPathBuilder sparkle;
+  sparkle.moveTo(x, y - radius)
+      .quadTo(x + bend, y - bend, x + radius, y)
+      .quadTo(x + bend, y + bend, x, y + radius)
+      .quadTo(x - bend, y + bend, x - radius, y)
+      .quadTo(x - bend, y - bend, x, y - radius)
+      .close();
+  return sparkle.detach();
+}
+
+// The glyphs of Arc's theme picker: filled, about 18 points across.
+void PaintGlyph(gfx::Canvas* canvas,
+                Glyph glyph,
+                const gfx::PointF& center,
+                SkColor color) {
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(color);
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(1.8f);
+  flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+  flags.setStrokeJoin(cc::PaintFlags::kRound_Join);
+  const float x = center.x();
+  const float y = center.y();
+  switch (glyph) {
+    case Glyph::kSystem:
+      flags.setStyle(cc::PaintFlags::kFill_Style);
+      canvas->DrawPath(GetSparklePath(x - 2, y + 2, 7), flags);
+      canvas->DrawPath(GetSparklePath(x + 5.5f, y - 5, 3.6f), flags);
+      canvas->DrawPath(GetSparklePath(x - 5.5f, y - 6.5f, 2.2f), flags);
+      return;
+    case Glyph::kLight:
+      for (int i = 0; i < 8; ++i) {
+        const float angle = ToRadians(i * 45);
+        const gfx::Vector2dF ray(std::sin(angle), -std::cos(angle));
+        canvas->DrawLine(center + gfx::ScaleVector2d(ray, 6.8f),
+                         center + gfx::ScaleVector2d(ray, 8.4f), flags);
+      }
+      flags.setStyle(cc::PaintFlags::kFill_Style);
+      canvas->DrawCircle(center, 4.4f, flags);
+      return;
+    case Glyph::kDark:
+      flags.setStyle(cc::PaintFlags::kFill_Style);
+      if (const std::optional<SkPath> moon =
+              Op(SkPath::Circle(x - 1, y + 1.5f, 7),
+                 SkPath::Circle(x + 3.5f, y - 3, 6), kDifference_SkPathOp)) {
+        canvas->DrawPath(*moon, flags);
+      }
+      canvas->DrawPath(GetSparklePath(x + 5.5f, y - 6, 2.8f), flags);
+      canvas->DrawPath(GetSparklePath(x + 8, y - 1, 1.8f), flags);
+      return;
+    case Glyph::kRemove:
+      canvas->DrawLine(gfx::PointF(x - 7, y), gfx::PointF(x + 7, y), flags);
+      return;
+    case Glyph::kAdd:
+      canvas->DrawLine(gfx::PointF(x - 7, y), gfx::PointF(x + 7, y), flags);
+      canvas->DrawLine(gfx::PointF(x, y - 7), gfx::PointF(x, y + 7), flags);
+      return;
+    case Glyph::kPrevious:
+    case Glyph::kNext: {
+      const float direction = glyph == Glyph::kNext ? 1 : -1;
+      SkPathBuilder chevron;
+      chevron.moveTo(x - 3 * direction, y - 7)
+          .lineTo(x + 3 * direction, y)
+          .lineTo(x - 3 * direction, y + 7);
+      canvas->DrawPath(chevron.detach(), flags);
+      return;
+    }
+  }
+}
+
+}  // namespace
