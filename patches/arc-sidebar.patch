+ArcSpaceTitleView::ArcSpaceTitleView(BrowserWindowInterface* browser)
+    : views::Button(base::BindRepeating(&ArcSpaceTitleView::OnPressed,
+                                        base::Unretained(this))),
+      browser_(browser) {
+  // Like the new tab button below it, see VerticalNewTabButton.
+  constexpr int kVerticalPadding = 4;
+  constexpr int kHorizontalPadding = 7;
+  constexpr int kIconSize = 20;
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+                       views::BoxLayout::Orientation::kHorizontal,
+                       gfx::Insets::TLBR(kVerticalPadding, kHorizontalPadding,
+                                         kVerticalPadding + kDividerAreaHeight,
+                                         kHorizontalPadding),
+                       kHorizontalPadding))
+      ->set_cross_axis_alignment(views::BoxLayout::CrossAxisAlignment::kCenter);
+  icon_image_ = AddChildView(std::make_unique<views::ImageView>());
+  icon_image_->SetImageSize(gfx::Size(kIconSize, kIconSize));
+  name_ = AddChildView(std::make_unique<views::Label>());
+  name_->SetFontList(gfx::FontList().DeriveWithSizeDelta(1).DeriveWithWeight(
+      gfx::Font::Weight::SEMIBOLD));
+  name_->SetEnabledColor(kColorToolbarButtonIcon);
+  name_->SetAutoColorReadabilityEnabled(false);
+  name_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  name_->SetElideBehavior(gfx::ELIDE_TAIL);
+  // The sidebar paints to a translucent layer.
+  name_->SetSubpixelRenderingEnabled(false);
+  for (views::View* const child : children()) {
+    child->SetCanProcessEventsWithinSubtree(false);
+  }
+  static_cast<views::BoxLayout*>(GetLayoutManager())
+      ->SetFlexForView(name_, 1);
+  SetPreferredSize(
+      gfx::Size(-1, GetLayoutConstant(LayoutConstant::kVerticalTabHeight) - 4 +
+                        kDividerAreaHeight));
+  // The highlight leaves out the divider.
+  ConfigureInkDrop(
+      this, std::make_unique<views::RoundRectHighlightPathGenerator>(
+                gfx::Insets::TLBR(0, 0, kDividerAreaHeight, 0),
+                GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius)));
+  set_context_menu_controller(this);
+  SetVisible(false);
+  spaces_changed_subscription_ =
+      arc_spaces::SpacesController::RegisterOnAnyChanged(base::BindRepeating(
+          [](ArcSpaceTitleView* title, BrowserWindowInterface* browser) {
+            if (browser == title->browser_) {
+              title->Update();
+            }
+          },
+          base::Unretained(this)));
+  Update();
+}
+
+ArcSpaceTitleView::~ArcSpaceTitleView() = default;
+
+void ArcSpaceTitleView::SetInSidebarMode(bool in_sidebar_mode) {
+  if (in_sidebar_mode_ != in_sidebar_mode) {
+    in_sidebar_mode_ = in_sidebar_mode;
+    Update();
+  }
+}
+
+void ArcSpaceTitleView::PaintButtonContents(gfx::Canvas* canvas) {
+  // A faint line between the title and the tabs, like Arc's, as wide as the
+  // title's contents.
+  constexpr int kDividerInset = 7;
+  constexpr int kDividerTopGap = 4;
+  constexpr SkAlpha kDividerAlpha = 0x26;
+  const gfx::Rect divider(
+      kDividerInset, height() - kDividerAreaHeight + kDividerTopGap,
+      std::max(0, width() - 2 * kDividerInset), 1);
+  canvas->FillRect(divider,
+                   SkColorSetA(GetColorProvider()->GetColor(
+                                   kColorToolbarButtonIcon),
+                               kDividerAlpha));
+}
+
+void ArcSpaceTitleView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  if (ArcSpacesBarView* const bar = ArcSpacesBarView::FindForView(this)) {
+    bar->ShowSpaceMenu(space_id_, point, source_type);
+  }
+}
+
+void ArcSpaceTitleView::Update() {
+  const arc_spaces::SpacesController* const controller =
+      arc_spaces::SpacesController::From(browser_, /*create=*/false);
+  const arc_spaces::Space* space = nullptr;
+  size_t index = 0;
+  if (controller && controller->IsEnabled()) {
+    for (; index < controller->spaces().size(); ++index) {
+      if (controller->spaces()[index].id == controller->shown_space_id()) {
+        space = &controller->spaces()[index];
+        break;
+      }
+    }
+  }
+  SetVisible(in_sidebar_mode_ && space);
+  if (!space) {
+    return;
+  }
+  // Swipes between spaces update often, mostly with nothing new here.
+  const std::u16string name = arc_spaces::GetSpaceDisplayName(*space, index);
+  if (space->id == space_id_ && space->icon_id == icon_id_ &&
+      name == name_->GetText()) {
+    return;
+  }
+  space_id_ = space->id;
+  icon_id_ = space->icon_id;
+  icon_image_->SetImage(ui::ImageModel::FromVectorIcon(
+      GetIconForSpace(space->icon_id), kColorToolbarButtonIcon,
+      kSpaceIconSize));
+  name_->SetText(name);
+  SetTooltipText(u"Edit Space");
+  GetViewAccessibility().SetName(name);
+}
+
+void ArcSpaceTitleView::OnPressed() {
+  if (!space_id_.empty()) {
+    ArcSpacesBarView::ShowSpaceEditor(browser_, space_id_);
+  }
+}
