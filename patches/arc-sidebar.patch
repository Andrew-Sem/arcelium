+// Rounded pill holding the address and the toolbar actions. Like the location
+// bar, it lightens while the cursor is over any part of it. Like Arc's, it
+// shows the actions only while the cursor is over the sidebar.
+class AddressPill : public views::FlexLayoutView {
+  METADATA_HEADER(AddressPill, views::FlexLayoutView)
+
+ public:
+  AddressPill() {
+    SetNotifyEnterExitOnChild(true);
+    UpdateBackground();
+  }
+
+  // The actions lie at the pill's end, which the address leaves them only
+  // while they show: see Layout().
+  void SetActionsView(views::View* actions) {
+    actions_ = actions;
+    actions_->SetProperty(views::kViewIgnoredByLayoutKey, true);
+    actions_->SetPaintToLayer();
+    actions_->layer()->SetFillsBoundsOpaquely(false);
+    actions_->layer()->SetOpacity(0);
+  }
+
+  // The actions show while the sidebar is hovered, like Arc's, see
+  // ArcSidebarHeaderView::SetSidebarHovered(). Hidden, they're only
+  // transparent, for bubbles of theirs to stay where they are.
+  void SetActionsShown(bool shown) {
+    if (!actions_ || actions_shown_ == shown) {
+      return;
+    }
+    actions_shown_ = shown;
+    actions_->layer()->SetOpacity(shown ? 1 : 0);
+    UpdateActionsMargin();
+  }
+
+  // views::View:
+  void Layout(PassKey) override {
+    LayoutSuperclass<views::FlexLayoutView>(this);
+    if (!actions_) {
+      return;
+    }
+    const gfx::Size size = actions_->GetPreferredSize();
+    actions_->SetBounds(
+        std::max(0, width() - kActionsTrailingPadding - size.width()),
+        (height() - size.height()) / 2, size.width(), size.height());
+  }
+  void ChildPreferredSizeChanged(views::View* child) override {
+    if (child == actions_) {
+      UpdateActionsMargin();
+    }
+    views::FlexLayoutView::ChildPreferredSizeChanged(child);
+  }
+  void OnMouseEntered(const ui::MouseEvent& event) override {
+    SetHovered(true);
+  }
+  void OnMouseExited(const ui::MouseEvent& event) override {
+    SetHovered(false);
+  }
+
+ private:
+  void SetHovered(bool hovered) {
+    if (hovered_ == hovered) {
+      return;
+    }
+    hovered_ = hovered;
+    UpdateBackground();
+  }
+
+  void UpdateBackground() {
+    // Translucent on native frame materials, which may be tinted. Hovered,
+    // half as much lighter as the location bar gets.
+    constexpr float kHover = 0.5f;
+    SetBackground(std::make_unique<AddressPillBackground>(hovered_ ? kHover : 0));
+  }
+
+  void UpdateActionsMargin() {
+    SetInteriorMargin(gfx::Insets::TLBR(
+        0, 0, 0,
+        kActionsTrailingPadding +
+            (actions_shown_ ? actions_->GetPreferredSize().width() : 0)));
+    InvalidateLayout();
+  }
+
+  bool hovered_ = false;
+  bool actions_shown_ = false;
+  raw_ptr<views::View> actions_ = nullptr;
+};
