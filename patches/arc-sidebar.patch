+void BrowserView::UpdateSidebarAddressBarState() {
+  // This is also reached while the browser view is still being built; wait for
+  // the widget and the initialized toolbar.
+  if (!GetWidget() || !top_container_ || !toolbar_ ||
+      !toolbar_->location_bar_view() || !vertical_tab_strip_region_view_ ||
+      !find_bar_host_view_) {
+    return;
+  }
+
+  // A hidden sidebar depends on the collapse state as well, see
+  // IsArcSidebarHidden(). Collapse changes are reported from the strip's
+  // animation callbacks, where zen mode must not start animations of its own.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&BrowserView::UpdateZenModeState,
+                                weak_ptr_factory_.GetWeakPtr()));
+
+  auto* const layout_controller = HeliumLayoutStateController::From(browser_);
+  auto* const vertical_tabs_controller =
+      tabs::VerticalTabStripStateController::From(browser_);
+  // The mode has no collapsed sidebar, see VerticalTabStripRegionView::
+  // OnResize(), so expand one collapsed before the mode got turned on or
+  // restored collapsed.
+  if (layout_controller && layout_controller->IsSidebarAddressBarEnabled() &&
+      vertical_tabs_controller &&
+      vertical_tabs_controller->GetCollapseState() ==
+          tabs::VerticalTabStripCollapseState::kCollapsed) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](base::WeakPtr<BrowserView> browser_view) {
+                         auto* const controller =
+                             browser_view
+                                 ? tabs::VerticalTabStripStateController::From(
+                                       browser_view->browser())
+                                 : nullptr;
+                         if (controller &&
+                             controller->GetCollapseState() ==
+                                 tabs::VerticalTabStripCollapseState::
+                                     kCollapsed) {
+                           controller->RequestCollapse(false);
+                         }
+                       },
+                       weak_ptr_factory_.GetWeakPtr()));
+  }
+  const ImmersiveModeController* const immersive_controller =
+      ImmersiveModeController::From(browser_);
+  const bool active =
+      layout_controller && layout_controller->IsSidebarAddressBarEnabled() &&
+      GetIsNormalType() && GetSupportsTabStrip() &&
+      ShouldDrawVerticalTabStrip() && !IsInContentFullscreenForSidebar() &&
+      !(immersive_controller && immersive_controller->IsEnabled()) &&
+      top_container_->parent() == this && vertical_tabs_controller &&
+      vertical_tabs_controller->GetCollapseState() ==
+          tabs::VerticalTabStripCollapseState::kExpanded;
+  if (active == sidebar_address_bar_active_) {
+    return;
+  }
+  sidebar_address_bar_active_ = active;
+
+  toolbar_->location_bar_view()
+      ->GetOmniboxController()
+      ->autocomplete_controller()
+      ->SetMaxMatches(active ? std::optional<size_t>(5) : std::nullopt);
+
+  if (active) {
+    // The command bar floats over the contents, so the top container needs its
+    // own layer stacked above them.
+    if (!top_container_->layer()) {
+      top_container_->SetPaintToLayer();
+      top_container_->layer()->SetFillsBoundsOpaquely(false);
+      command_bar_created_top_container_layer_ = true;
+    }
+    command_bar_top_container_index_ = GetIndexOf(top_container_.get());
+    ReorderChildView(top_container_,
+                     GetIndexOf(find_bar_host_view_.get()).value());
+    top_container_->layer()->SetRoundedCornerRadius(
+        gfx::RoundedCornersF(ArcCommandBarView::kCornerRadius));
+    top_container_->layer()->SetIsFastRoundedCorner(true);
+    command_bar_shadow_ = std::make_unique<views::ViewShadow>(
+        top_container_.get(), kCommandBarShadowElevation);
+    command_bar_shadow_->SetRoundedCornerRadius(ArcCommandBarView::kCornerRadius);
+
+    // The card lies under the toolbar, with the results below the omnibox.
+    ArcCommandBarView* command_bar = ArcCommandBarView::FindIn(top_container_);
+    if (!command_bar) {
+      command_bar = top_container_->AddChildViewAt(
+          std::make_unique<ArcCommandBarView>(), 0);
+    }
+    command_bar->SetVisible(true);
+    LocationBarView* const location_bar = toolbar_->location_bar_view();
+    location_bar->omnibox_view()->SetFontList(
+        ArcCommandBarView::GetOmniboxFontList(/*in_command_bar=*/true));
+    location_bar->InvalidateLayout();
+
+    ArcSidebarHeaderView* const header =
+        vertical_tab_strip_region_view_->sidebar_header();
+    toolbar_->SetSidebarHosts(header->navigation_host(),
+                              header->actions_host());
+    vertical_tab_strip_region_view_->SetSidebarHeaderVisible(true);
+    // The downloads button always shows at the bottom of the sidebar.
+    if (auto* const downloads = DownloadToolbarUIController::From(browser_)) {
+      downloads->Show();
+    }
+    UpdateToolbar(GetActiveWebContents());
+    // No outline around the page, but a shadow.
+    multi_contents_view_->MaybeUpdateContentsBorderAndOverlay();
+  } else {
+    command_bar_open_ = false;
+    if (layout_controller) {
+      layout_controller->set_command_bar_opens_new_tab(false);
+    }
+    toolbar_->SetSidebarHosts(nullptr, nullptr);
+    UpdateZenCollapseButtonVisibility();
+    vertical_tab_strip_region_view_->SetSidebarHeaderVisible(false);
+
+    // Any open results move back to the regular popup.
+    if (ArcCommandBarView* const command_bar =
+            ArcCommandBarView::FindIn(top_container_)) {
+      command_bar->SetClickOutsideCallback(base::RepeatingClosure());
+      command_bar->SetVisible(false);
+    }
+    LocationBarView* const location_bar = toolbar_->location_bar_view();
+    location_bar->omnibox_view()->SetFontList(
+        ArcCommandBarView::GetOmniboxFontList(/*in_command_bar=*/false));
+    location_bar->InvalidateLayout();
+    if (OmniboxPopupView* const popup_view =
+            location_bar->GetOmniboxPopupView()) {
+      popup_view->UpdatePopupAppearance();
+    }
+    command_bar_shadow_.reset();
+    UpdateToolbar(GetActiveWebContents());
+    multi_contents_view_->MaybeUpdateContentsBorderAndOverlay();
+    if (top_container_->layer()) {
+      top_container_->layer()->SetRoundedCornerRadius(gfx::RoundedCornersF());
+      top_container_->layer()->SetIsFastRoundedCorner(false);
+    }
+    if (top_container_->parent() == this) {
+      if (command_bar_top_container_index_) {
+        ReorderChildView(top_container_,
+                         command_bar_top_container_index_.value());
+      }
+      if (command_bar_created_top_container_layer_) {
+        top_container_->DestroyLayer();
+      }
+    }
+    command_bar_top_container_index_.reset();
+    command_bar_created_top_container_layer_ = false;
+  }
+
+  UpdateCommandBarState();
+  InvalidateLayout();
+}
