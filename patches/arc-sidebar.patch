+// SplitMix64, seeded per pixel so the grain is the same on every launch and
+// free of the lattice patterns of simpler generators.
+uint64_t GrainHash(uint64_t x) {
+  x += 0x9E3779B97F4A7C15ull;
+  x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ull;
+  x = (x ^ (x >> 27)) * 0x94D049BB133111EBull;
+  return x ^ (x >> 31);
