+// The toolbar's action buttons, drawn a bit smaller inside the pill. A view
+// transform keeps their hit targets in line with what is drawn.
+class ActionsHost : public views::BoxLayoutView {
+  METADATA_HEADER(ActionsHost, views::BoxLayoutView)
+
+ public:
+  static constexpr float kScale = 0.85f;
+
+  // views::View:
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override {
+    views::BoxLayoutView::OnBoundsChanged(previous_bounds);
+    // Shrink around the trailing edge's center, so the buttons stay at the
+    // pill's end.
+    gfx::Transform transform;
+    transform.Translate(width(), height() / 2.0f);
+    transform.Scale(kScale, kScale);
+    transform.Translate(-width(), -height() / 2.0f);
+    SetTransform(transform);
+  }
+};
