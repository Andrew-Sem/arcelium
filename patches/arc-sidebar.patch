+// The theme editor of a space, like Arc's: up to three colors, picked on a
+// field of hues around neutral gray, or from a palette, the window's color
+// mode, how strongly the colors tint the window and how much grain shows over
+// them. Changes show at once and are saved as the picker goes away.
+class ArcSpaceThemePicker : public views::View {
+  METADATA_HEADER(ArcSpaceThemePicker, views::View)
+
+ public:
+  ArcSpaceThemePicker(base::WeakPtr<arc_spaces::SpacesController> controller,
+                      std::string space_id,
+                      arc_spaces::SpaceTheme theme);
+  ArcSpaceThemePicker(const ArcSpaceThemePicker&) = delete;
+  ArcSpaceThemePicker& operator=(const ArcSpaceThemePicker&) = delete;
+  ~ArcSpaceThemePicker() override;
+
+ private:
+  void SetTheme(arc_spaces::SpaceTheme theme);
+  void SetColors(std::vector<SkColor> colors, size_t selected);
+  void SetMode(arc_spaces::SpaceTheme::Mode mode);
+  void SetIntensity(float intensity);
+  void SetGrain(float grain);
+  void AddColor();
+  void RemoveColor();
+  void PickPaletteColor(SkColor color);
+  void UpdateControls();
+
+  const base::WeakPtr<arc_spaces::SpacesController> controller_;
+  const std::string space_id_;
+  arc_spaces::SpaceTheme theme_;
+  // The color that the palette and removing go to.
+  size_t selected_color_ = 0;
+
+  raw_ptr<SpaceThemeColorField> field_ = nullptr;
+  std::vector<raw_ptr<SpaceThemeGlyphButton>> mode_buttons_;
+  raw_ptr<SpaceThemeGlyphButton> remove_button_ = nullptr;
+  raw_ptr<SpaceThemeGlyphButton> add_button_ = nullptr;
+  raw_ptr<SpaceThemePalette> palette_ = nullptr;
+  raw_ptr<SpaceThemeIntensitySlider> intensity_slider_ = nullptr;
+  raw_ptr<SpaceThemeGrainDial> grain_dial_ = nullptr;
+};
+
