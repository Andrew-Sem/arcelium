+// Helium: moves the page of a little window into the window it moves into,
+// in its space showing, like Little Arc's "Open in", see
+// arc_spaces::IsLittleWindow(). A new window if there's none.
+void MoveLittleWindowPage(base::WeakPtr<BrowserWindowInterface> popup) {
+  if (!popup || popup->GetTabStripModel()->empty()) {
+    return;
+  }
+  BrowserWindowInterface* const target =
+      arc_spaces::GetLittleWindowTarget(popup.get());
+  if (!target) {
+    ConvertPopupToTabbedBrowser(popup.get());
+    return;
+  }
+  // As ConvertPopupToTabbedBrowser(): the contents only, since tabs don't
+  // move between windows of different types. The popup closes once empty.
+  TabStripModel* const tab_strip = popup->GetTabStripModel();
+  std::unique_ptr<content::WebContents> contents =
+      tab_strip->DetachWebContentsAtForInsertion(tab_strip->active_index());
+  target->GetTabStripModel()->AppendWebContents(std::move(contents),
+                                                /*foreground=*/true);
+  target->GetWindow()->Activate();
+}
