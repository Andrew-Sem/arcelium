+namespace {
+
+constexpr int kInputFontSizeDelta = 6;
+constexpr int kResultsVerticalPadding = 8;
+constexpr int kBorderThickness = 1;
+// How much darker than the frame the card is, in dark mode.
+constexpr float kCardDarkening = 0.3f;
+
+constexpr int kTabSwitchSpacing = 12;
+constexpr int kTabSwitchTileSize = 28;
+constexpr int kTabSwitchTileCornerRadius = 7;
+constexpr int kTabSwitchArrowSize = 16;
+constexpr int kTabSwitchTrailingMargin = 8;
+
+void DisableSubpixelRendering(views::View* view) {
+  if (auto* label = views::AsViewClass<views::Label>(view)) {
+    label->SetSubpixelRenderingEnabled(false);
+  }
+  for (views::View* child : view->children()) {
+    DisableSubpixelRendering(child);
+  }
+}
+
+// White on dark cards, black on light ones.
+SkColor GetInkColor(const views::View& view) {
+  const ui::ColorProvider* const color_provider = view.GetColorProvider();
+  const bool dark =
+      !color_provider ||
+      color_utils::IsDark(
+          color_provider->GetColor(ArcCommandBarView::kBackgroundColorId));
+  return dark ? SK_ColorWHITE : SK_ColorBLACK;
+}
+
+}  // namespace
+
+ArcCommandBarView::ArcCommandBarView() = default;
+
+ArcCommandBarView::~ArcCommandBarView() = default;
+
+// static
+ArcCommandBarView* ArcCommandBarView::FindIn(const views::View* top_container) {
+  if (!top_container) {
+    return nullptr;
+  }
+  for (views::View* child : top_container->children()) {
+    if (auto* command_bar = views::AsViewClass<ArcCommandBarView>(child)) {
+      return command_bar;
+    }
+  }
+  return nullptr;
+}
+
+// static
+ArcCommandBarView* ArcCommandBarView::From(const views::View* location_bar) {
+  const views::View* const toolbar =
+      location_bar ? location_bar->parent() : nullptr;
+  ArcCommandBarView* const command_bar =
+      toolbar ? FindIn(toolbar->parent()) : nullptr;
+  return command_bar && command_bar->GetVisible() ? command_bar : nullptr;
+}
+
+// static
+SkColor ArcCommandBarView::GetCardColor(
+    const ui::ColorProvider* color_provider) {
+  if (!color_provider) {
+    return SK_ColorBLACK;
+  }
+  const SkColor frame = color_provider->GetColor(kBackgroundColorId);
+  return color_utils::IsDark(frame)
+             ? color_utils::AlphaBlend(SK_ColorBLACK, frame, kCardDarkening)
+             : frame;
+}
+
+// static
+bool ArcCommandBarView::IsFirstSuggestionImplicitlySelected(
+    const OmniboxController* controller) {
+  // Not IsPopupOpen(): this is also asked while the results are being shown,
+  // before the popup state is updated. In the command bar, results are shown
+  // whenever there are any.
+  const OmniboxEditModel* const edit_model = controller->edit_model();
+  return edit_model->user_input_in_progress() &&
+         edit_model->user_text().empty() &&
+         edit_model->GetPopupSelection().line ==
+             OmniboxPopupSelection::kNoMatch &&
+         !controller->autocomplete_controller()->result().empty();
+}
+
+// static
+bool ArcCommandBarView::IsInside(const views::View* view) {
+  for (const views::View* ancestor = view ? view->parent() : nullptr; ancestor;
+       ancestor = ancestor->parent()) {
+    if (views::IsViewClass<ArcCommandBarView>(ancestor)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// static
+gfx::FontList ArcCommandBarView::GetOmniboxFontList(bool in_command_bar) {
+  const gfx::FontList& font_list = views::TypographyProvider::Get().GetFont(
+      CONTEXT_OMNIBOX_PRIMARY, views::style::STYLE_PRIMARY);
+  return in_command_bar ? font_list.DeriveWithSizeDelta(kInputFontSizeDelta)
+                        : font_list;
+}
+
+void ArcCommandBarView::SetResults(views::View* results) {
+  if (results_ == results) {
+    return;
+  }
+  if (results_) {
+    RemoveChildView(results_);
+  }
+  results_ = results;
+  if (results_) {
+    AddChildViewAt(results_.get(), 0);
+  }
+  PreferredSizeChanged();
+}
+
+void ArcCommandBarView::SetClickOutsideCallback(
+    base::RepeatingClosure callback) {
+  if (!callback == !click_outside_callback_ && (!callback || click_monitor_)) {
+    return;
+  }
+  click_outside_callback_ = std::move(callback);
+  if (click_outside_callback_ && GetWidget()) {
+    click_monitor_ = views::EventMonitor::CreateWindowMonitor(
+        this, GetWidget()->GetNativeWindow(), {ui::EventType::kMousePressed});
+  } else {
+    click_monitor_.reset();
+  }
+}
+
+gfx::Size ArcCommandBarView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  // Without results, the card is just the omnibox row.
+  const int results_height = GetResultsHeight();
+  return gfx::Size(0, results_height > 0
+                          ? results_height + 2 * kResultsVerticalPadding +
+                                kBorderThickness
+                          : 0);
+}
+
+void ArcCommandBarView::Layout(PassKey) {
+  if (results_) {
+    results_->SetBounds(kBorderThickness,
+                        kInputRowHeight + kResultsVerticalPadding,
+                        width() - 2 * kBorderThickness, GetResultsHeight());
+  }
+}
+
+void ArcCommandBarView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  // Separate the results from the omnibox row above.
+  if (GetResultsHeight() > 0) {
+    canvas->FillRect(gfx::Rect(kBorderThickness, kInputRowHeight,
+                               width() - 2 * kBorderThickness, 1),
+                     separator_color_);
+  }
+  // A hairline edge, like Raycast's and Arc's.
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(kBorderThickness);
+  flags.setColor(border_color_);
+  gfx::RectF edge(GetLocalBounds());
+  edge.Inset(kBorderThickness / 2.0f);
+  canvas->DrawRoundRect(edge, kCornerRadius - kBorderThickness / 2.0f, flags);
+}
+
+void ArcCommandBarView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  const SkColor ink = GetInkColor(*this);
+  separator_color_ = SkColorSetA(ink, 0x14);
+  border_color_ = SkColorSetA(ink, 0x1F);
+  // Opaque, so text in the results needs no opaque layer.
+  SetBackground(views::CreateRoundedRectBackground(
+      GetCardColor(GetColorProvider()), kCornerRadius));
+  SchedulePaint();
+}
+
+void ArcCommandBarView::ViewHierarchyChanged(
+    const views::ViewHierarchyChangedDetails& details) {
+  if (details.is_add && Contains(details.child)) {
+    // The top container paints to a translucent layer.
+    DisableSubpixelRendering(details.child);
+  } else if (!details.is_add && details.parent == this &&
+             details.child == results_) {
+    results_ = nullptr;
+  }
+}
+
+void ArcCommandBarView::OnEvent(const ui::Event& event) {
+  // The card is the top container holding this view.
+  if (!click_outside_callback_ || !parent() ||
+      parent()->GetBoundsInScreen().Contains(
+          display::Screen::Get()->GetCursorScreenPoint())) {
+    return;
+  }
+  // Let the click land first; the callback stops this monitor.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, click_outside_callback_);
+}
+
+int ArcCommandBarView::GetResultsHeight() const {
+  return results_ && results_->GetVisible()
+             ? results_->GetPreferredSize().height()
+             : 0;
+}
+
+BEGIN_METADATA(ArcCommandBarView)
+END_METADATA
+
+ArcTabSwitchIndicator::ArcTabSwitchIndicator() {
+  SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+  SetCrossAxisAlignment(views::BoxLayout::CrossAxisAlignment::kCenter);
+  SetBetweenChildSpacing(kTabSwitchSpacing);
+  SetProperty(views::kMarginsKey,
+              gfx::Insets::TLBR(0, kTabSwitchSpacing, 0,
+                                kTabSwitchTrailingMargin));
+  SetCanProcessEventsWithinSubtree(false);
+
+  label_ = AddChildView(std::make_unique<views::Label>(u"Switch to Tab"));
+  label_->SetAutoColorReadabilityEnabled(false);
+  label_->SetSubpixelRenderingEnabled(false);
+
+  arrow_ = AddChildView(std::make_unique<views::ImageView>());
+  arrow_->SetPreferredSize(gfx::Size(kTabSwitchTileSize, kTabSwitchTileSize));
+}
+
+ArcTabSwitchIndicator::~ArcTabSwitchIndicator() = default;
+
+void ArcTabSwitchIndicator::SetSelected(bool selected) {
+  if (selected_ == selected) {
+    return;
+  }
+  selected_ = selected;
+  UpdateColors();
+}
+
+void ArcTabSwitchIndicator::OnThemeChanged() {
+  views::BoxLayoutView::OnThemeChanged();
+  UpdateColors();
+}
+
+void ArcTabSwitchIndicator::UpdateColors() {
+  if (!GetColorProvider()) {
+    return;
+  }
+  // Like Arc: a solid tile with a dark arrow on the highlighted row, a faint
+  // tile elsewhere.
+  const SkColor ink = GetInkColor(*this);
+  const SkColor background =
+      ArcCommandBarView::GetCardColor(GetColorProvider());
+  label_->SetEnabledColor(selected_ ? ink : SkColorSetA(ink, 0x80));
+  arrow_->SetImage(ui::ImageModel::FromVectorIcon(
+      vector_icons::kArrowForwardIcon,
+      selected_ ? background : SkColorSetA(ink, 0xCC), kTabSwitchArrowSize));
+  arrow_->SetBackground(views::CreateRoundedRectBackground(
+      selected_ ? SkColorSetA(ink, 0xF0) : SkColorSetA(ink, 0x14),
+      kTabSwitchTileCornerRadius));
+}
+
+BEGIN_METADATA(ArcTabSwitchIndicator)
+END_METADATA
