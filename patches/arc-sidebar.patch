+// Extra room around the traffic lights, which are centered in the first row.
+constexpr int kCaptionRowExtraHeight = 10;
+constexpr int kAddressPillHeight = 34;
+// The sidebar button, past the traffic lights, like Arc's, which fullscreen
+// shows with the menu bar instead.
+constexpr int kSidebarButtonX = 70;
+constexpr int kFullscreenSidebarButtonX = 0;
+constexpr int kSidebarButtonSize = 28;
+constexpr int kSidebarIconSize = 18;
+constexpr int kAddressPillCornerRadius = 10;
+constexpr int kAddressTextLeadingPadding = 12;
+// The site's info button among the actions, as big as theirs.
+constexpr int kPageInfoButtonSize = 28;
+constexpr int kPageInfoIconSize = 16;
+constexpr int kAddressTextTrailingPadding = 6;
+constexpr int kActionsTrailingPadding = 3;
+constexpr int kRowSpacing = 2;
+constexpr int kBottomPadding = 8;
+
+constexpr char16_t kWwwPrefix[] = u"www.";
+// Shown instead of the omnibox placeholder, which is too long for the pill.
+constexpr char16_t kEmptyAddressText[] = u"Search or Enter URL…";
+
+// How wide the actions in `actions_host` are to be once they're done
+// animating: as they animate in and out, their preferred width passes through
+// every width in between.
+int GetActionsTargetWidth(const views::View* actions_host) {
+  int width = 0;
+  for (const views::View* child : actions_host->children()) {
+    if (!child->GetVisible()) {
+      continue;
+    }
+    if (const auto* container =
+            views::AsViewClass<ToolbarIconContainerView>(child)) {
+      width += const_cast<ToolbarIconContainerView*>(container)
+                   ->GetAnimatingLayoutManager()
+                   ->target_layout_manager()
+                   ->GetPreferredSize(container)
+                   .width();
+    } else {
+      width += child->GetPreferredSize().width();
+    }
+  }
+  return width;
+}
+
+void DisableSubpixelRendering(views::View* view) {
+  if (auto* label = views::AsViewClass<views::Label>(view)) {
+    label->SetSubpixelRenderingEnabled(false);
+  }
+  for (views::View* child : view->children()) {
+    DisableSubpixelRendering(child);
+  }
+}
