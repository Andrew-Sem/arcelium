+class ArcSpacesBarView::SwipeHandler : public ui::EventHandler {
+ public:
+  explicit SwipeHandler(ArcSpacesBarView* bar) : bar_(bar) {}
+  SwipeHandler(const SwipeHandler&) = delete;
+  SwipeHandler& operator=(const SwipeHandler&) = delete;
+  ~SwipeHandler() override = default;
+
+  // ui::EventHandler:
+  void OnScrollEvent(ui::ScrollEvent* event) override {
+    // How far fingers move before the gesture counts as horizontal or not.
+    constexpr float kSlop = 8.0f;
+
+    if (event->type() != ui::EventType::kScroll) {
+      return;
+    }
+    // An unhandled scroll event goes to the ancestors of its target in turn,
+    // see ui::EventProcessor, and this handler of the root view sees it each
+    // time. Only the first, with the target under the fingers, counts.
+    if (event->time_stamp() == last_event_time_) {
+      return;
+    }
+    last_event_time_ = event->time_stamp();
+    // On macOS only the momentum phase is set: MAY_BEGIN when fingers touch,
+    // NONE while they move, END once they lift, then INERTIAL_UPDATE and END
+    // again for the momentum, if any. Phaseless events, such as mouse wheel
+    // ticks, are END too.
+    switch (event->momentum_phase()) {
+      case ui::EventMomentumPhase::MAY_BEGIN:
+      case ui::EventMomentumPhase::BEGAN: {
+        views::View* const area = bar_->GetSwipeArea();
+        views::View* const target = static_cast<views::View*>(event->target());
+        // A swipe the fingers didn't lift from, as far as events tell.
+        if (swiping_ && !fingers_lifted_) {
+          bar_->EndSwipe(dx_, 0);
+        }
+        Reset();
+        // Spaces that don't fit scroll under the fingers instead.
+        tracking_ = area && target && area->Contains(target) &&
+                    bar_->IsDrawn() && !bar_->IsScrollingSpacesAt(target);
+        return;
+      }
+      case ui::EventMomentumPhase::NONE:
+        if (!tracking_ || fingers_lifted_) {
+          return;
+        }
+        dx_ += event->x_offset();
+        dy_ += event->y_offset();
+        UpdateVelocity(event->x_offset(), event->time_stamp());
+        if (!decided_ && std::abs(dx_) + std::abs(dy_) > kSlop) {
+          decided_ = true;
+          swiping_ = std::abs(dx_) > 2 * std::abs(dy_);
+          if (swiping_) {
+            // Fingers moving left reveal the next space, like Arc's.
+            bar_->BeginSwipe(dx_ < 0 ? 1 : -1);
+          }
+        }
+        if (!swiping_) {
+          return;
+        }
+        event->StopPropagation();
+        bar_->UpdateSwipe(dx_);
+        return;
+      case ui::EventMomentumPhase::INERTIAL_UPDATE:
+        // The momentum of a swipe neither switches nor scrolls.
+        if (tracking_ && swiping_) {
+          event->StopPropagation();
+        }
+        return;
+      case ui::EventMomentumPhase::END:
+        if (tracking_ && swiping_) {
+          event->StopPropagation();
+          if (!fingers_lifted_) {
+            bar_->EndSwipe(dx_, velocity_);
+          }
+        }
+        if (fingers_lifted_) {
+          Reset();
+        } else {
+          fingers_lifted_ = true;
+        }
+        return;
+      default:
+        return;
+    }
+  }
+
+ private:
+  void Reset() {
+    tracking_ = false;
+    fingers_lifted_ = false;
+    decided_ = false;
+    swiping_ = false;
+    dx_ = 0.0f;
+    dy_ = 0.0f;
+    velocity_ = 0.0f;
+    last_move_time_ = base::TimeTicks();
+  }
+
+  // Follows how fast the fingers move, in DIPs per second, leaning on the
+  // latest moves.
+  void UpdateVelocity(float dx, base::TimeTicks time) {
+    if (!last_move_time_.is_null() && time > last_move_time_) {
+      const float seconds = (time - last_move_time_).InSecondsF();
+      constexpr float kSmoothing = 0.6f;
+      velocity_ = kSmoothing * (dx / seconds) + (1 - kSmoothing) * velocity_;
+    }
+    last_move_time_ = time;
+  }
+
+  const raw_ptr<ArcSpacesBarView> bar_;
+  // Whether this gesture began over the sidebar, and may switch spaces.
+  bool tracking_ = false;
+  bool fingers_lifted_ = false;
+  // Whether the gesture turned out horizontal, `swiping_`, or not.
+  bool decided_ = false;
+  bool swiping_ = false;
+  float dx_ = 0.0f;
+  float dy_ = 0.0f;
+  float velocity_ = 0.0f;
+  base::TimeTicks last_move_time_;
+  base::TimeTicks last_event_time_;
+};
+
+// Slides the tabs of the space showing out and those of the next one in, like
+// Arc's: with the fingers of a swipe, see SwipeHandler, or on its own as the
+// space switches otherwise. The tabs going out are a snapshot, those coming in
+// the tab strip, which lists them meanwhile, see
+// SpacesController::SetPreviewSpace(). The page switches once fingers lift.
+class ArcSpacesBarView::SpaceSlide : public ui::CompositorAnimationObserver {
+ public:
+  explicit SpaceSlide(ArcSpacesBarView* bar) : bar_(bar) {}
+  SpaceSlide(const SpaceSlide&) = delete;
+  SpaceSlide& operator=(const SpaceSlide&) = delete;
+  // The views may be going away as well, so this leaves the view tree and the
+  // spaces be.
+  ~SpaceSlide() override {
+    StopSettling();
+    weak_factory_.InvalidateWeakPtrs();
+    if (views::View* const snapshot = snapshot_view_.view()) {
+      snapshot->SetVisible(false);
+    }
+    if (views::View* const tab_strip = tab_strip_.view()) {
+      tab_strip->layer()->SetTransform(gfx::Transform());
+    }
+  }
+
+  bool IsActive() const { return phase_ != Phase::kIdle; }
+
+  // Fingers started to move the tabs towards the space `direction` places
+  // after the one showing. Returns whether the tabs follow them.
+  bool BeginTracking(int direction) {
+    FinishNow();
+    if (!Start(direction > 0 ? 1 : -1)) {
+      return false;
+    }
+    tracking_ = true;
+    if (!target_id_.empty()) {
+      RequestSnapshot();
+    } else {
+      // No space there: the tabs only give a little.
+      phase_ = Phase::kTracking;
+    }
+    return true;
+  }
+
+  // The fingers moved the tabs by `offset` DIPs, to the left if negative.
+  void UpdateTracking(float offset) {
+    if (!tracking_) {
+      return;
+    }
+    const float width = GetWidth();
+    if (target_id_.empty()) {
+      constexpr float kRubberBandFactor = 0.2f;
+      constexpr float kRubberBandMax = 32;
+      offset_ = std::clamp(offset * kRubberBandFactor, -kRubberBandMax,
+                           kRubberBandMax);
+    } else {
+      // Towards the space coming in only.
+      offset_ = direction_ > 0 ? std::clamp(offset, -width, 0.0f)
+                               : std::clamp(offset, 0.0f, width);
+    }
+    Apply();
+    UpdatePreview(/*tracking=*/true);
+  }
+
+  // The fingers lifted, moving at `velocity` DIPs per second.
+  void EndTracking(float velocity) {
+    if (!tracking_) {
+      return;
+    }
+    tracking_ = false;
+    if (target_id_.empty()) {
+      // The tabs gave a little only: they spring back from rest.
+      velocity = 0;
+    }
+    if (phase_ == Phase::kWaitingForSnapshot) {
+      pending_velocity_ = velocity;
+      return;
+    }
+    // Past a third of the way, or flicked towards the space coming in.
+    constexpr float kCommitFraction = 0.33f;
+    constexpr float kFlickVelocity = 350;
+    constexpr float kFlickMinFraction = 0.06f;
+    const float fraction = std::abs(offset_) / GetWidth();
+    const float towards = -velocity * direction_;
+    const bool commit =
+        !target_id_.empty() && towards > -kFlickVelocity &&
+        (fraction > kCommitFraction ||
+         (towards > kFlickVelocity && fraction > kFlickMinFraction));
+    Settle(commit, velocity);
+  }
+
+  // Switches to the space with `id`, sliding the tabs along if they show.
+  void SlideTo(const std::string& id) {
+    FinishNow();
+    arc_spaces::SpacesController* const controller = bar_->GetController();
+    if (!controller) {
+      return;
+    }
+    const std::vector<arc_spaces::Space>& spaces = controller->spaces();
+    const auto from = std::ranges::find(spaces, controller->active_space_id(),
+                                        &arc_spaces::Space::id);
+    const auto to = std::ranges::find(spaces, id, &arc_spaces::Space::id);
+    if (from == spaces.end() || to == spaces.end() || from == to ||
+        !Start(to > from ? 1 : -1, id)) {
+      controller->SwitchTo(id);
+      return;
+    }
+    RequestSnapshot();
+  }
+
+  // Ends the slide at once, in the space it slides to.
+  void FinishNow() {
+    if (phase_ == Phase::kIdle) {
+      return;
+    }
+    if (phase_ == Phase::kWaitingForSnapshot && !tracking_) {
+      // A switch without fingers.
+      committing_ = true;
+    } else if (phase_ == Phase::kTracking) {
+      committing_ = std::abs(offset_) / GetWidth() > 0.5f;
+    }
+    Finish();
+  }
+
+  // ui::CompositorAnimationObserver:
+  void OnAnimationStep(base::TimeTicks timestamp) override {
+    // Frames come evenly, but the first one after fingers lift any time.
+    if (first_step_time_.is_null()) {
+      first_step_time_ = timestamp;
+      first_step_elapsed_ =
+          std::clamp(base::TimeTicks::Now() - settle_time_, base::TimeDelta(),
+                     base::Hertz(60));
+    }
+    const float t =
+        (first_step_elapsed_ + (timestamp - first_step_time_)).InSecondsF();
+    // How far from the end the tabs are, and how fast they move.
+    const float decay = std::exp(-settle_rate_ * t);
+    const float b = settle_velocity_ + settle_rate_ * settle_distance_;
+    const float distance = (settle_distance_ + b * t) * decay;
+    const float velocity = (settle_velocity_ - settle_rate_ * b * t) * decay;
+    constexpr base::TimeDelta kMaxSettleDuration = base::Seconds(1);
+    if ((std::abs(distance) < 0.5f && std::abs(velocity) < 50) ||
+        t > kMaxSettleDuration.InSecondsF()) {
+      offset_ = settle_end_;
+      Apply();
+      StopSettling();
+      PostFinish();
+      return;
+    }
+    offset_ = settle_end_ + distance;
+    Apply();
+  }
+  void OnCompositingShuttingDown(ui::Compositor* compositor) override {
+    StopSettling();
+    PostFinish();
+  }
+
+ private:
+  enum class Phase { kIdle, kWaitingForSnapshot, kTracking, kSettling };
+
+  // How fast the spring of a slide pulls the tabs, per second, see Settle().
+  static constexpr float kSpringRate = 22;
+
+  // Finds the views to slide and the space coming in: `id`, else the one
+  // `direction` places after the one showing, if any.
+  bool Start(int direction, const std::string& id = std::string()) {
+    arc_spaces::SpacesController* const controller = bar_->GetController();
+    views::View* const content_area = bar_->GetSwipeArea();
+    views::View* tab_strip = nullptr;
+    if (content_area) {
+      for (views::View* const child : content_area->children()) {
+        if (child->GetProperty(views::kElementIdentifierKey) ==
+            kTabStripElementId) {
+          tab_strip = child;
+        }
+      }
+    }
+    if (!controller || !tab_strip || !tab_strip->layer() ||
+        !content_area->layer() || !tab_strip->IsDrawn() ||
+        tab_strip->width() == 0) {
+      return false;
+    }
+    target_id_ = id;
+    if (target_id_.empty()) {
+      const std::vector<arc_spaces::Space>& spaces = controller->spaces();
+      const auto from = std::ranges::find(
+          spaces, controller->active_space_id(), &arc_spaces::Space::id);
+      const auto index = from - spaces.begin() + direction;
+      if (from != spaces.end() && index >= 0 &&
+          index < static_cast<ptrdiff_t>(spaces.size())) {
+        target_id_ = spaces[static_cast<size_t>(index)].id;
+      }
+    }
+    direction_ = direction;
+    offset_ = 0;
+    committing_ = false;
+    pending_velocity_.reset();
+    tab_strip_.SetView(tab_strip);
+    content_area_.SetView(content_area);
+    // The tabs slide within the sidebar only.
+    content_area->layer()->SetMasksToBounds(true);
+    phase_ = Phase::kWaitingForSnapshot;
+    return true;
+  }
+
+  void RequestSnapshot() {
+    auto request = std::make_unique<viz::CopyOutputRequest>(
+        viz::CopyOutputRequest::ResultFormat::RGBA,
+        viz::CopyOutputRequest::ResultDestination::kSystemMemory,
+        base::BindOnce(&SpaceSlide::OnSnapshot, weak_factory_.GetWeakPtr()));
+    request->set_result_task_runner(
+        base::SequencedTaskRunner::GetCurrentDefault());
+    tab_strip_.view()->layer()->RequestCopyOfOutput(std::move(request));
+    // A window that doesn't draw, e.g. on another desktop, may never answer.
+    constexpr base::TimeDelta kSnapshotTimeout = base::Milliseconds(200);
+    snapshot_timeout_.Start(
+        FROM_HERE, kSnapshotTimeout,
+        base::BindOnce(&SpaceSlide::OnSnapshot, weak_factory_.GetWeakPtr(),
+                       nullptr));
+  }
+
+  void OnSnapshot(std::unique_ptr<viz::CopyOutputResult> result) {
+    views::View* const tab_strip = tab_strip_.view();
+    views::View* const content_area = content_area_.view();
+    arc_spaces::SpacesController* const controller = bar_->GetController();
+    if (phase_ != Phase::kWaitingForSnapshot || !tab_strip || !content_area ||
+        !controller) {
+      return;
+    }
+    snapshot_timeout_.Stop();
+    SkBitmap bitmap;
+    if (result) {
+      auto scoped_bitmap = result->ScopedAccessSkBitmap();
+      bitmap = scoped_bitmap.GetOutScopedBitmap();
+    }
+    if (!bitmap.readyToDraw()) {
+      // Without a snapshot, e.g. while the window is busy drawing pages, a
+      // switch without fingers still slides: the tabs coming in alone.
+      if (!tracking_ && !pending_velocity_ && !target_id_.empty()) {
+        SlideInAlone();
+        return;
+      }
+      committing_ = !tracking_;
+      Finish();
+      return;
+    }
+
+    auto snapshot = std::make_unique<views::ImageView>(
+        ui::ImageModel::FromImageSkia(gfx::ImageSkia::CreateFromBitmap(
+            bitmap, tab_strip->layer()->device_scale_factor())));
+    snapshot->SetImageSize(tab_strip->size());
+    snapshot->SetProperty(views::kViewIgnoredByLayoutKey, true);
+    snapshot->SetCanProcessEventsWithinSubtree(false);
+    snapshot->SetPaintToLayer();
+    snapshot->layer()->SetFillsBoundsOpaquely(false);
+    snapshot->SetBoundsRect(tab_strip->bounds());
+    snapshot_view_.SetView(content_area->AddChildView(std::move(snapshot)));
+
+    phase_ = Phase::kTracking;
+    if (tracking_ || pending_velocity_) {
+      UpdatePreview(tracking_);
+      Apply();
+      if (pending_velocity_) {
+        tracking_ = true;
+        EndTracking(*pending_velocity_);
+      }
+      return;
+    }
+    // A switch without fingers.
+    controller->SetPreviewSpace(target_id_, 0, /*tracking=*/true);
+    Apply();
+    Settle(/*commit=*/true, /*velocity=*/0);
+  }
+
+  // Switches at once and slides the tabs of the space coming in from the side
+  // they come from, as a spring like Settle()'s.
+  void SlideInAlone() {
+    views::View* const tab_strip = tab_strip_.view();
+    arc_spaces::SpacesController* const controller = bar_->GetController();
+    compositor_ = tab_strip ? tab_strip->layer()->GetCompositor() : nullptr;
+    if (!controller || !compositor_) {
+      compositor_ = nullptr;
+      committing_ = true;
+      Finish();
+      return;
+    }
+    controller->SwitchTo(target_id_);
+    // Switched already: finishing has nothing more to do.
+    committing_ = false;
+    phase_ = Phase::kSettling;
+    offset_ = direction_ * GetWidth();
+    Apply();
+    settle_end_ = 0;
+    settle_distance_ = offset_;
+    settle_velocity_ = 0;
+    settle_rate_ = kSpringRate;
+    settle_time_ = base::TimeTicks::Now();
+    first_step_time_ = base::TimeTicks();
+    compositor_->AddAnimationObserver(this);
+  }
+
+  // Lists the tabs coming in, blending the frame tint along.
+  void UpdatePreview(bool tracking) {
+    arc_spaces::SpacesController* const controller = bar_->GetController();
+    if (!controller || target_id_.empty() || !snapshot_view_.view()) {
+      return;
+    }
+    controller->SetPreviewSpace(target_id_, std::abs(offset_) / GetWidth(),
+                                tracking);
+  }
+
+  void Apply() {
+    views::View* const tab_strip = tab_strip_.view();
+    if (!tab_strip) {
+      return;
+    }
+    views::View* const snapshot = snapshot_view_.view();
+    tab_strip->layer()->SetTransform(GetTabStripTransform(offset_));
+    if (snapshot) {
+      snapshot->layer()->SetTransform(gfx::Transform::MakeTranslation(
+          offset_, 0));
+    }
+  }
+
+  // Where the tab strip goes with the tabs going out `offset` DIPs away: after
+  // them, once it lists those coming in.
+  gfx::Transform GetTabStripTransform(float offset) const {
+    const bool lists_next = snapshot_view_.view() != nullptr;
+    return gfx::Transform::MakeTranslation(
+        lists_next ? offset + direction_ * GetWidth() : offset, 0);
+  }
+
+  // Slides on to the space coming in if `commit`, else back, starting as fast
+  // as fingers lifting at `velocity` DIPs per second moved the tabs.
+  void Settle(bool commit, float velocity) {
+    views::View* const tab_strip = tab_strip_.view();
+    if (!tab_strip) {
+      Finish();
+      return;
+    }
+    committing_ = commit;
+    phase_ = Phase::kSettling;
+    // The space and its tab activate at once, before the slide starts, which
+    // their work would make stutter otherwise. The frame tint fades the rest of
+    // the way on its own, see BrowserNativeWidgetMac.
+    arc_spaces::SpacesController* const controller = bar_->GetController();
+    if (controller && !target_id_.empty() && snapshot_view_.view()) {
+      if (commit) {
+        controller->SwitchTo(target_id_);
+      } else {
+        controller->SetPreviewSpace(target_id_, 0, /*tracking=*/false);
+      }
+    }
+    // A critically damped spring to the end, setting off as fast as the fingers
+    // moved the tabs: they go on without a jolt, speeding up or slowing down.
+    // As stiff as it takes not to overshoot.
+    constexpr float kMaxVelocity = 8000;
+    settle_end_ = commit ? -direction_ * GetWidth() : 0;
+    settle_distance_ = offset_ - settle_end_;
+    settle_velocity_ = std::abs(settle_distance_) < 0.5f
+                           ? 0
+                           : std::clamp(velocity, -kMaxVelocity, kMaxVelocity);
+    settle_rate_ = kSpringRate;
+    if (settle_velocity_ * settle_distance_ < 0) {
+      settle_rate_ = std::max(
+          kSpringRate, std::abs(settle_velocity_ / settle_distance_));
+    }
+    settle_time_ = base::TimeTicks::Now();
+    first_step_time_ = base::TimeTicks();
+    compositor_ = tab_strip->layer()->GetCompositor();
+    if (!compositor_) {
+      offset_ = settle_end_;
+      Finish();
+      return;
+    }
+    compositor_->AddAnimationObserver(this);
+  }
+
+  void StopSettling() {
+    if (compositor_) {
+      compositor_->RemoveAnimationObserver(this);
+      compositor_ = nullptr;
+    }
+  }
+
+  // Finishes once the frame, which may be drawing a layer to remove, is done.
+  void PostFinish() {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&SpaceSlide::Finish, weak_factory_.GetWeakPtr(),
+                       /*update_controller=*/true));
+  }
+
+  // Puts everything back, switching to the space coming in if committing.
+  // Leaves the spaces be unless `update_controller`.
+  void Finish(bool update_controller = true) {
+    if (phase_ == Phase::kIdle) {
+      return;
+    }
+    phase_ = Phase::kIdle;
+    tracking_ = false;
+    StopSettling();
+    snapshot_timeout_.Stop();
+    weak_factory_.InvalidateWeakPtrs();
+    if (views::View* const tab_strip = tab_strip_.view()) {
+      tab_strip->layer()->SetTransform(gfx::Transform());
+    }
+    if (views::View* const snapshot = snapshot_view_.view()) {
+      snapshot_view_.SetView(nullptr);
+      snapshot->parent()->RemoveChildViewT(snapshot);
+    }
+    if (views::View* const content_area = content_area_.view()) {
+      content_area->layer()->SetMasksToBounds(false);
+    }
+    tab_strip_.SetView(nullptr);
+    content_area_.SetView(nullptr);
+    arc_spaces::SpacesController* const controller =
+        update_controller ? bar_->GetController() : nullptr;
+    if (controller) {
+      if (committing_ && !target_id_.empty()) {
+        controller->SwitchTo(target_id_);
+      } else {
+        controller->ClearPreviewSpace();
+      }
+    }
+    target_id_.clear();
+  }
+
+  float GetWidth() const {
+    const views::View* const tab_strip = tab_strip_.view();
+    return tab_strip ? std::max(1, tab_strip->width()) : 1;
+  }
+
+  const raw_ptr<ArcSpacesBarView> bar_;
+  Phase phase_ = Phase::kIdle;
+  // Whether fingers move the tabs.
+  bool tracking_ = false;
+  // The space coming in, none if there's none that way.
+  std::string target_id_;
+  // 1 if it comes in from the right, -1 from the left.
+  int direction_ = 1;
+  // How far the tabs going out are moved.
+  float offset_ = 0;
+  bool committing_ = false;
+  // The fingers lifted before the snapshot came.
+  std::optional<float> pending_velocity_;
+  views::ViewTracker tab_strip_;
+  views::ViewTracker content_area_;
+  views::ViewTracker snapshot_view_;
+  base::OneShotTimer snapshot_timeout_;
+  // While settling: the spring's end, how far from it the tabs set off and how
+  // fast, in DIPs per second, and how fast it pulls them, per second.
+  raw_ptr<ui::Compositor> compositor_ = nullptr;
+  float settle_end_ = 0;
+  float settle_distance_ = 0;
+  float settle_velocity_ = 0;
+  float settle_rate_ = 0;
+  base::TimeTicks settle_time_;
+  base::TimeTicks first_step_time_;
+  base::TimeDelta first_step_elapsed_;
+  base::WeakPtrFactory<SpaceSlide> weak_factory_{this};
+};
+
+class ArcSpacesBarView::DropTarget : public TabDragTarget {
+ public:
+  explicit DropTarget(ArcSpacesBarView* bar) : bar_(bar) {}
+  DropTarget(const DropTarget&) = delete;
+  DropTarget& operator=(const DropTarget&) = delete;
+  ~DropTarget() override { will_destroy_callbacks_.Notify(); }
+
+  // TabDragTarget:
+  void OnTabDragEntered() override {}
+  TabDragContext* OnTabDragUpdated(TabDragTarget::DragController& controller,
+                                   const gfx::Point& point_in_screen) override {
+    bar_->HighlightSpace(bar_->GetSpaceAt(point_in_screen));
+    // The tabs join this window, staying where they are if from it.
+    auto* const region = views::AsViewClass<VerticalTabStripRegionView>(
+        GetRegion());
+    return region ? region->GetDragContext()
+                  : const_cast<TabDragContext*>(controller.GetAttachedContext());
+  }
+  void OnTabDragExited(const gfx::Point& point_in_screen) override {
+    bar_->HighlightSpace(std::string());
+  }
+  void OnTabDragEnded() override { bar_->HighlightSpace(std::string()); }
+  bool CanDropTab() override { return !bar_->highlighted_space_.empty(); }
+  void HandleTabDrop(TabDragTarget::DragController& controller) override {
+    std::vector<base::WeakPtr<tabs::TabInterface>> tabs;
+    for (const TabDragData& data : controller.GetSessionData().tab_drag_data_) {
+      if (tabs::TabInterface* const tab =
+              data.contents
+                  ? tabs::TabInterface::MaybeGetFromContents(data.contents)
+                  : nullptr) {
+        tabs.push_back(tab->GetWeakPtr());
+      }
+    }
+    // Once the drag is over: moving the tabs changes what the sidebar lists.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<ArcSpacesBarView> bar, std::string space_id,
+               std::vector<base::WeakPtr<tabs::TabInterface>> tabs) {
+              arc_spaces::SpacesController* const controller =
+                  bar ? bar->GetController() : nullptr;
+              if (!controller || !controller->FindSpace(space_id)) {
+                return;
+              }
+              for (const base::WeakPtr<tabs::TabInterface>& tab : tabs) {
+                if (tab && tab->GetBrowserWindowInterface() == bar->browser_ &&
+                    controller->GetTabSpace(tab.get()) != space_id) {
+                  controller->MoveTabToSpace(tab.get(), space_id);
+                }
+              }
+            },
+            bar_->weak_factory_.GetWeakPtr(), bar_->highlighted_space_,
+            std::move(tabs)));
+  }
+  base::CallbackListSubscription RegisterWillDestroyCallback(
+      base::OnceClosure callback) override {
+    return will_destroy_callbacks_.Add(std::move(callback));
+  }
+
+ private:
+  views::View* GetRegion() {
+    views::View* view = bar_;
+    while (view && !views::IsViewClass<VerticalTabStripRegionView>(view)) {
+      view = view->parent();
+    }
+    return view;
+  }
+
+  const raw_ptr<ArcSpacesBarView> bar_;
+  base::OnceClosureList will_destroy_callbacks_;
+};
+
+ArcSpacesBarView::ArcSpacesBarView(BrowserWindowInterface* browser)
+    : browser_(browser),
+      slide_(std::make_unique<SpaceSlide>(this)),
+      drop_target_(std::make_unique<DropTarget>(this)) {
+  // Only the buttons take events, not the room between them.
+  SetEventTargeter(std::make_unique<views::ViewTargeter>(this));
+  strip_ = AddChildView(std::make_unique<SpacesStrip>(base::BindRepeating(
+      &ArcSpacesBarView::ScrollSpacesBy, base::Unretained(this))));
+  // On a layer of their own: the compositor only applies the strip's fade to
+  // a layer with others in it.
+  spaces_view_ = strip_->AddChildView(std::make_unique<views::View>());
+  spaces_view_->SetPaintToLayer();
+  spaces_view_->layer()->SetFillsBoundsOpaquely(false);
+  for (int i = 0; i < kSpaceShortcutCount; ++i) {
+    AddAccelerator(ui::Accelerator(
+        static_cast<ui::KeyboardCode>(ui::VKEY_1 + i), ui::EF_CONTROL_DOWN));
+  }
+  // The window isn't set up for the sidebar mode yet.
+  ScheduleUpdate();
+}
+
+ArcSpacesBarView::~ArcSpacesBarView() {
+  if (swipe_handler_host_) {
+    swipe_handler_host_->RemovePreTargetHandler(swipe_handler_.get());
+  }
+}
