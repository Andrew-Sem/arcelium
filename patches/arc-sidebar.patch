+// Where the bar keeps its space buttons, scrolled by horizontal swipes and
+// wheels while they don't fit.
+class SpacesStrip : public views::View {
+  METADATA_HEADER(SpacesStrip, views::View)
+
+ public:
+  // `scroll_by` scrolls by its delta and returns whether the strip scrolls.
+  explicit SpacesStrip(base::RepeatingCallback<bool(float)> scroll_by)
+      : scroll_by_(std::move(scroll_by)) {
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    layer()->SetMasksToBounds(true);
+  }
+  SpacesStrip(const SpacesStrip&) = delete;
+  SpacesStrip& operator=(const SpacesStrip&) = delete;
+  ~SpacesStrip() override = default;
+
+  // views::View:
+  void OnScrollEvent(ui::ScrollEvent* event) override {
+    if (event->type() != ui::EventType::kScroll) {
+      return;
+    }
+    // Fingers scroll the spaces sideways only, leaving vertical scrolls be.
+    // Mouse wheel ticks, which come without phases (see EventMomentumPhase),
+    // scroll them either way.
+    const float x = event->x_offset();
+    const float y = event->y_offset();
+    const bool wheel =
+        event->momentum_phase() == ui::EventMomentumPhase::END;
+    if (!wheel && std::abs(y) > std::abs(x)) {
+      return;
+    }
+    if (scroll_by_.Run(wheel && std::abs(y) > std::abs(x) ? y : x)) {
+      event->SetHandled();
+    }
+  }
+
+ private:
+  const base::RepeatingCallback<bool(float)> scroll_by_;
+};
