+FrameMaterialTint FrameMaterialTint::BlendedInto(
+    const FrameMaterialTint& other,
+    float progress) const {
+  FrameMaterialTint blended;
+  for (size_t i = 0; i < colors.size(); ++i) {
+    blended.colors[i] =
+        color_utils::AlphaBlend(other.colors[i], colors[i], progress);
+  }
+  blended.alpha = alpha + (other.alpha - alpha) * progress;
+  blended.grain = grain + (other.grain - grain) * progress;
+  return blended;
+}
+
+SkColor FrameMaterialTint::GetAverageColor() const {
+  return color_utils::AlphaBlend(
+      color_utils::AlphaBlend(colors[0], colors[2], 0.5f), colors[1], 0.5f);
+}
