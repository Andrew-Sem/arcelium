+// In sidebar address bar mode the new tab button sits below the pinned tabs and
+// above the others, like Arc's: it moves into the tab strip, which lays it out
+// between them. Otherwise it follows the tabs.
+void ArrangeBottomContainer(views::View* content_area,
+                            views::View* sidebar_header,
+                            views::View* tab_strip,
+                            views::View* bottom_container) {
+  // Room between the pinned tabs and the new tab button, and between the
+  // button and the tabs below it.
+  constexpr int kNewTabButtonTopGap = 8;
+  constexpr int kNewTabButtonBottomGap = 4;
+  const int horizontal_padding =
+      GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding);
+  if (tab_strip) {
+    for (views::View* const child : tab_strip->children()) {
+      if (auto* const title = views::AsViewClass<ArcSpaceTitleView>(child)) {
+        title->SetInSidebarMode(sidebar_header->GetVisible());
+      }
+    }
+  }
+  if (sidebar_header->GetVisible() && tab_strip) {
+    bottom_container->SetProperty(
+        views::kMarginsKey,
+        gfx::Insets::TLBR(kNewTabButtonTopGap, horizontal_padding,
+                          kNewTabButtonBottomGap, horizontal_padding));
+    if (bottom_container->parent() != tab_strip) {
+      tab_strip->AddChildView(
+          bottom_container->parent()->RemoveChildViewT(bottom_container));
+    }
+    return;
+  }
+
+  bottom_container->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kPreferred,
+                               views::MaximumFlexSizeRule::kUnbounded));
+  bottom_container->SetProperty(
+      views::kMarginsKey,
+      gfx::Insets::TLBR(kBottomContainerGap, horizontal_padding, 0,
+                        horizontal_padding));
+  const bool follows_tab_strip = tab_strip && tab_strip->parent() == content_area;
+  const size_t target =
+      content_area->GetIndexOf(follows_tab_strip ? tab_strip : sidebar_header)
+          .value() +
+      1;
+  if (bottom_container->parent() != content_area) {
+    content_area->AddChildViewAt(
+        bottom_container->parent()->RemoveChildViewT(bottom_container),
+        target);
+    return;
+  }
+  const size_t current = content_area->GetIndexOf(bottom_container).value();
+  content_area->ReorderChildView(bottom_container,
+                                 current < target ? target - 1 : target);
+}
