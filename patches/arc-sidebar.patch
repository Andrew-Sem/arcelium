+// Appends `line` to ~/Library/Logs/Helium/window-close.log, which records what
+// started closing each browser window that still had tabs.
+void AppendToWindowCloseLog(std::string line) {
+  base::Time::Exploded now;
+  base::Time::Now().LocalExplode(&now);
+  line = base::StringPrintf("%04d-%02d-%02d %02d:%02d:%02d.%03d ", now.year,
+                            now.month, now.day_of_month, now.hour, now.minute,
+                            now.second, now.millisecond) +
+         line + "\n";
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+       base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+      base::BindOnce(
+          [](const std::string& line) {
+            const base::FilePath dir =
+                base::apple::GetUserLibraryPath().Append("Logs").Append(
+                    "Helium");
+            const base::FilePath path = dir.Append("window-close.log");
+            // Start over rather than grow without bound.
+            if (base::GetFileSize(path).value_or(0) > 1024 * 1024) {
+              base::DeleteFile(path);
+            }
+            if (base::PathExists(path)) {
+              base::AppendToFile(path, line);
+            } else if (base::CreateDirectory(dir)) {
+              base::WriteFile(path, line);
+            }
+          },
+          std::move(line)));
+}
