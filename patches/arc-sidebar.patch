+void BrowserView::UpdateCommandBarState() {
+  bool open = false;
+  if (sidebar_address_bar_active_ && toolbar_ && GetWidget()) {
+    const views::FocusManager* const focus_manager = GetFocusManager();
+    const views::View* const focused_view =
+        focus_manager ? focus_manager->GetFocusedView() : nullptr;
+    open = focused_view && toolbar_->Contains(focused_view);
+
+    // Keep the command bar in place while a bubble anchored to it (e.g. page
+    // info) is open, so that the bubble does not follow it off-screen.
+    if (!open) {
+      for (views::Widget* widget :
+           views::Widget::GetAllOwnedWidgets(GetWidget()->GetNativeView())) {
+        if (IsOpenBubbleAnchoredInViewSubtree(widget, top_container_)) {
+          open = true;
+          break;
+        }
+      }
+    }
+  }
+
+  // Like Arc, clicking anywhere else, even where nothing takes focus, closes
+  // the command bar. SetFocusToLocationBar() opens it without coming here
+  // first, so this keeps up with `command_bar_open_` rather than `open`.
+  if (ArcCommandBarView* const command_bar =
+          ArcCommandBarView::FindIn(top_container_)) {
+    command_bar->SetClickOutsideCallback(
+        open || command_bar_open_
+            ? base::BindRepeating(&BrowserView::DismissCommandBar,
+                                  weak_ptr_factory_.GetWeakPtr())
+            : base::RepeatingClosure());
+  }
+
+  if (open == command_bar_open_) {
+    return;
+  }
+  command_bar_open_ = open;
+  if (!open) {
+    if (ArcCommandBarView* const command_bar =
+            ArcCommandBarView::FindIn(top_container_)) {
+      command_bar->SetClickOutsideCallback(base::RepeatingClosure());
+    }
+  }
+
+  if (!open && toolbar_ && toolbar_->location_bar_view()) {
+    // Like Arc, leaving the command bar discards whatever was typed into it.
+    if (auto* layout_controller = HeliumLayoutStateController::From(browser_)) {
+      layout_controller->set_command_bar_opens_new_tab(false);
+    }
+    toolbar_->location_bar_view()->Revert();
+  }
+
+  InvalidateLayout();
+}
+
+bool BrowserView::ShowCommandBar(bool for_new_tab) {
+  if (!sidebar_address_bar_active_ || !toolbar_ ||
+      !toolbar_->location_bar_view()) {
+    return false;
+  }
+
+  auto* const layout_controller = HeliumLayoutStateController::From(browser_);
+  LocationBarView* const location_bar = toolbar_->location_bar_view();
+
+  // A blank new tab page would be replaced anyway, so navigate it in place.
+  const bool opens_new_tab =
+      for_new_tab && !IsBlankNewTabPage(GetActiveWebContents());
+  if (layout_controller->command_bar_opens_new_tab() && !opens_new_tab) {
+    // Switching from a "new tab" command bar back to the current page.
+    location_bar->Revert();
+  }
+  layout_controller->set_command_bar_opens_new_tab(opens_new_tab);
+
+  SetFocusToLocationBar(/*is_user_initiated=*/true);
+  if (for_new_tab) {
+    // Start out empty, showing the same suggestions as after clearing the
+    // omnibox by hand.
+    location_bar->GetOmniboxView()->SetUserText(std::u16string(),
+                                                /*update_popup=*/false);
+    location_bar->GetOmniboxController()->edit_model()->StartZeroSuggestRequest(
+        /*user_clobbered_permanent_text=*/true);
+  }
+  UpdateCommandBarState();
+  return true;
+}
+
+bool BrowserView::ShowNewTabCommandBar() {
+  return ShowCommandBar(/*for_new_tab=*/true);
+}
+
+void BrowserView::DismissCommandBar() {
+  if (!command_bar_open_) {
+    return;
+  }
+  if (content::WebContents* const contents = GetActiveWebContents()) {
+    contents->Focus();
+  } else if (views::FocusManager* const focus_manager = GetFocusManager()) {
+    focus_manager->ClearFocus();
+  }
+  UpdateCommandBarState();
+}
