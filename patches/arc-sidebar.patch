+ArcSidebarHeaderView::ArcSidebarHeaderView(BrowserView* browser_view)
+    : browser_view_(browser_view) {
+  // Row 1: navigation buttons, right-aligned next to the caption buttons.
+  navigation_host_ = AddChildView(std::make_unique<views::BoxLayoutView>());
+  navigation_host_->SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+  navigation_host_->SetMainAxisAlignment(
+      views::BoxLayout::MainAxisAlignment::kEnd);
+  navigation_host_->SetCrossAxisAlignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+
+  // Also in row 1, before the navigation buttons: shows or hides the sidebar,
+  // as ⌘S does.
+  auto sidebar_button = std::make_unique<views::ImageButton>(
+      base::BindRepeating(&ArcSidebarHeaderView::OnSidebarPressed,
+                          base::Unretained(this)));
+  sidebar_button->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(kDockToLeftIcon, kColorToolbarButtonIcon,
+                                     kSidebarIconSize));
+  sidebar_button->SetImageHorizontalAlignment(views::ImageButton::ALIGN_CENTER);
+  sidebar_button->SetImageVerticalAlignment(views::ImageButton::ALIGN_MIDDLE);
+  sidebar_button->SetPreferredSize(
+      gfx::Size(kSidebarButtonSize, kSidebarButtonSize));
+  constexpr char16_t kSidebarText[] = u"Toggle Sidebar";
+  sidebar_button->SetTooltipText(kSidebarText);
+  sidebar_button->GetViewAccessibility().SetName(kSidebarText);
+  ConfigureInkDrop(sidebar_button.get());
+  sidebar_button_ = AddChildView(std::move(sidebar_button));
+
+  // Row 2: the address pill, with extensions and pinned actions inside it.
+  auto* address_pill = AddChildView(std::make_unique<AddressPill>());
+  address_pill->SetOrientation(views::LayoutOrientation::kHorizontal);
+  address_pill->SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+  address_pill->SetMinimumCrossAxisSize(kAddressPillHeight);
+  address_pill->SetInteriorMargin(
+      gfx::Insets::TLBR(0, 0, 0, kActionsTrailingPadding));
+  address_pill_ = address_pill;
+
+  auto address_button = std::make_unique<AddressButton>(base::BindRepeating(
+      &ArcSidebarHeaderView::OnAddressPressed, base::Unretained(this)));
+  address_button->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  // Fading out at the end like the spaces in the switcher, not elided.
+  address_button->SetElideBehavior(gfx::FADE_TAIL);
+  address_button->SetBorder(views::CreateEmptyBorder(gfx::Insets::TLBR(
+      0, kAddressTextLeadingPadding, 0, kAddressTextTrailingPadding)));
+  address_button->SetMinSize(gfx::Size(0, kAddressPillHeight));
+  views::InstallRoundRectHighlightPathGenerator(
+      address_button.get(), gfx::Insets(), kAddressPillCornerRadius);
+  address_button->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                               views::MaximumFlexSizeRule::kUnbounded));
+  address_button_ = address_pill->AddChildView(std::move(address_button));
+
+  actions_host_ = address_pill->AddChildView(std::make_unique<ActionsHost>());
+  actions_host_->SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+  actions_host_->SetCrossAxisAlignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  address_pill->SetActionsView(actions_host_);
+
+  // The site's info, first among the actions, which the toolbar's join, see
+  // ToolbarView::SetSidebarHosts().
+  auto page_info_button = std::make_unique<views::ImageButton>(
+      base::BindRepeating(&ArcSidebarHeaderView::OnPageInfoPressed,
+                          base::Unretained(this)));
+  page_info_button->SetImageHorizontalAlignment(
+      views::ImageButton::ALIGN_CENTER);
+  page_info_button->SetImageVerticalAlignment(
+      views::ImageButton::ALIGN_MIDDLE);
+  page_info_button->SetPreferredSize(
+      gfx::Size(kPageInfoButtonSize, kPageInfoButtonSize));
+  constexpr char16_t kPageInfoText[] = u"View site information";
+  page_info_button->SetTooltipText(kPageInfoText);
+  page_info_button->GetViewAccessibility().SetName(kPageInfoText);
+  ConfigureInkDrop(page_info_button.get());
+  page_info_button_ = actions_host_->AddChildView(std::move(page_info_button));
+
+  UpdateAddress();
+}
