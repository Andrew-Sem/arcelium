+// How strongly the colors tint the window, like Arc's: a wave that grows with
+// it, bright up to the thumb.
+class SpaceThemeIntensitySlider : public views::View {
+  METADATA_HEADER(SpaceThemeIntensitySlider, views::View)
+
+ public:
+  explicit SpaceThemeIntensitySlider(
+      base::RepeatingCallback<void(float)> on_changed)
+      : on_changed_(std::move(on_changed)) {
+    GetViewAccessibility().SetRole(ax::mojom::Role::kSlider);
+    GetViewAccessibility().SetName(u"Intensity");
+  }
+  SpaceThemeIntensitySlider(const SpaceThemeIntensitySlider&) = delete;
+  SpaceThemeIntensitySlider& operator=(const SpaceThemeIntensitySlider&) =
+      delete;
+  ~SpaceThemeIntensitySlider() override = default;
+
+  void SetValue(float value) {
+    if (value_ != value) {
+      value_ = value;
+      GetViewAccessibility().SetValue(
+          base::NumberToString16(std::round(value * 100)) + u"%");
+      SchedulePaint();
+    }
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(160, kControlHeight);
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const float center_y = height() / 2.0f;
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(GetForeground(this, 0x14));
+    canvas->DrawRoundRect(gfx::RectF(0, center_y - 9, width(), 18), 9, flags);
+
+    constexpr float kWaveInset = 8;
+    constexpr float kWaveLength = 22;
+    const float amplitude = 2 + 8 * value_;
+    SkPathBuilder wave;
+    for (float x = kWaveInset; x <= width() - kWaveInset; x += 1) {
+      const float y =
+          center_y + amplitude * std::sin(2 * std::numbers::pi_v<float> *
+                                          (x - kWaveInset) / kWaveLength);
+      if (x == kWaveInset) {
+        wave.moveTo(x, y);
+      } else {
+        wave.lineTo(x, y);
+      }
+    }
+    const SkPath path = wave.detach();
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(3.5f);
+    flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+    flags.setStrokeJoin(cc::PaintFlags::kRound_Join);
+    const float thumb_x = GetThumbCenterX();
+    canvas->Save();
+    canvas->ClipRect(gfx::RectF(0, 0, thumb_x, height()));
+    flags.setColor(GetForeground(this, 0xC0));
+    canvas->DrawPath(path, flags);
+    canvas->Restore();
+    canvas->Save();
+    canvas->ClipRect(gfx::RectF(thumb_x, 0, width() - thumb_x, height()));
+    flags.setColor(GetForeground(this, 0x40));
+    canvas->DrawPath(path, flags);
+    canvas->Restore();
+
+    const gfx::RectF thumb(thumb_x - kThumbWidth / 2,
+                           center_y - kThumbHeight / 2, kThumbWidth,
+                           kThumbHeight);
+    PaintThumbShadow(canvas, thumb, kThumbWidth / 2);
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    flags.setColor(SK_ColorWHITE);
+    canvas->DrawRoundRect(thumb, kThumbWidth / 2, flags);
+    // Outlined against light backgrounds.
+    if (!IsDark(this)) {
+      flags.setStyle(cc::PaintFlags::kStroke_Style);
+      flags.setStrokeWidth(1);
+      flags.setColor(SkColorSetA(SK_ColorBLACK, 0x26));
+      gfx::RectF outline = thumb;
+      outline.Inset(0.5f);
+      canvas->DrawRoundRect(outline, kThumbWidth / 2 - 0.5f, flags);
+    }
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (!event.IsOnlyLeftMouseButton()) {
+      return false;
+    }
+    SetFromX(event.location().x());
+    return true;
+  }
+
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    SetFromX(event.location().x());
+    return true;
+  }
+
+ private:
+  float GetThumbCenterX() const {
+    return kThumbWidth / 2 + value_ * std::max(0.0f, width() - kThumbWidth);
+  }
+
+  void SetFromX(float x) {
+    const float track = width() - kThumbWidth;
+    if (track <= 0) {
+      return;
+    }
+    const float value = std::clamp((x - kThumbWidth / 2) / track, 0.0f, 1.0f);
+    if (value != value_) {
+      on_changed_.Run(value);
+    }
+  }
+
+  const base::RepeatingCallback<void(float)> on_changed_;
+  float value_ = -1;
+};
