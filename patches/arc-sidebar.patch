+// The space switcher at the bottom of the sidebar, like Arc's: a button per
+// space of the window, the one showing highlighted, centered in the sidebar,
+// and one at its end that opens a new space. Spaces that don't fit scroll.
+// ⌃1…⌃9 and a horizontal two-finger swipe over the sidebar switch spaces as
+// well, and a space's context menu edits its name, icon and color, moves the
+// active tab there or closes the space. See arc_spaces.h.
+class ArcSpacesBarView : public views::View,
+                         public views::ViewTargeterDelegate,
+                         public views::ContextMenuController,
+                         public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(ArcSpacesBarView, views::View)
+
+ public:
+  explicit ArcSpacesBarView(BrowserWindowInterface* browser);
+  ArcSpacesBarView(const ArcSpacesBarView&) = delete;
+  ArcSpacesBarView& operator=(const ArcSpacesBarView&) = delete;
+  ~ArcSpacesBarView() override;
+
+  // Asks for the name and icon of the space with `space_id` of `browser`, or
+  // of a new one, which opens once saved, if `space_id` is empty.
+  static void ShowSpaceEditor(BrowserWindowInterface* browser,
+                              const std::string& space_id);
+
+  // The switcher of the sidebar holding `view`, if any.
+  static ArcSpacesBarView* FindForView(views::View* view);
+
+  // What takes tabs dragged to `point_in_screen`, if over a space: it moves
+  // them there.
+  TabDragTarget* GetTabDragTarget(const gfx::Point& point_in_screen);
+
+  // Shows the theme picker of the space with `space_id`, see
+  // ArcSpaceThemePicker, over its button.
+  void ShowThemePicker(const std::string& space_id);
+
+  // Shows the context menu of the space with `space_id` at `point`, in screen
+  // coordinates.
+  void ShowSpaceMenu(const std::string& space_id,
+                     const gfx::Point& point,
+                     ui::mojom::MenuSourceType source_type);
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void Layout(PassKey) override;
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override;
+  void VisibilityChanged(views::View* starting_from, bool is_visible) override;
+  void AddedToWidget() override;
+  void RemovedFromWidget() override;
+
+  // views::ViewTargeterDelegate:
+  bool DoesIntersectRect(const views::View* target,
+                         const gfx::Rect& rect) const override;
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdEnabled(int command_id) const override;
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  struct SpaceButtonState {
+    std::string id;
+    std::string icon_id;
+    std::u16string name;
+    bool operator==(const SpaceButtonState&) const = default;
+  };
+
+  // Switches spaces on a horizontal two-finger swipe over the sidebar.
+  class SwipeHandler;
+  // Slides the tabs of one space out and those of the next in.
+  class SpaceSlide;
+  // Moves tabs dragged onto a space there.
+  class DropTarget;
+
+  // The spaces of the window, if it shows them.
+  arc_spaces::SpacesController* GetController() const;
+  void OnSpacesChanged();
+  void ScheduleUpdate();
+  void Update();
+  // Lays out the tabs again, for those of the space showing.
+  void UpdateTabLists();
+  void SwitchToSpace(const std::string& id);
+  // A swipe towards the space `direction` places after the one showing
+  // started, moved the fingers `offset` DIPs, negative to the left, or ended
+  // with them moving at `velocity` DIPs per second.
+  void BeginSwipe(int direction);
+  void UpdateSwipe(float offset);
+  void EndSwipe(float offset, float velocity);
+  void CreateSpace();
+  // The sidebar column holding this bar, over which swipes switch spaces.
+  views::View* GetSwipeArea();
+  // Whether `target` is among the spaces, scrolling since they don't fit.
+  bool IsScrollingSpacesAt(const views::View* target) const;
+  // Scrolls the spaces by `delta`, if they scroll, and returns whether so.
+  bool ScrollSpacesBy(float delta);
+  // The space whose button shows at `point_in_screen`, if any.
+  std::string GetSpaceAt(const gfx::Point& point_in_screen) const;
+  // Highlights the button of the space with `id`, none if empty.
+  void HighlightSpace(const std::string& id);
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  std::vector<SpaceButtonState> button_states_;
+  std::string active_space_id_;
+  // Holds `spaces_view_`, which holds `space_buttons_`, see Layout().
+  raw_ptr<views::View> strip_ = nullptr;
+  raw_ptr<views::View> spaces_view_ = nullptr;
+  std::vector<raw_ptr<views::View>> space_buttons_;
+  raw_ptr<views::View> new_space_button_ = nullptr;
+  bool spaces_scroll_ = false;
+  int scroll_offset_ = 0;
