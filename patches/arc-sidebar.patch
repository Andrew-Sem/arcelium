+ArcSpaceThemePicker::ArcSpaceThemePicker(
+    base::WeakPtr<arc_spaces::SpacesController> controller,
+    std::string space_id,
+    SpaceTheme theme)
+    : controller_(std::move(controller)),
+      space_id_(std::move(space_id)),
+      theme_(std::move(theme)) {
+  constexpr int kRowSpacing = 10;
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), kRowSpacing));
+
+  // In the order of SpaceTheme::Mode.
+  struct ModeButton {
+    SpaceTheme::Mode mode;
+    Glyph glyph;
+    std::u16string_view name;
+  };
+  constexpr ModeButton kModeButtons[] = {
+      {SpaceTheme::Mode::kSystem, Glyph::kSystem, u"Auto"},
+      {SpaceTheme::Mode::kLight, Glyph::kLight, u"Light"},
+      {SpaceTheme::Mode::kDark, Glyph::kDark, u"Dark"},
+  };
+  auto modes = std::make_unique<views::BoxLayoutView>();
+  modes->SetBetweenChildSpacing(10);
+  for (const ModeButton& button : kModeButtons) {
+    mode_buttons_.push_back(
+        modes->AddChildView(std::make_unique<SpaceThemeGlyphButton>(
+            base::BindRepeating(&ArcSpaceThemePicker::SetMode,
+                                base::Unretained(this), button.mode),
+            button.glyph, button.name)));
+  }
+  auto counts = std::make_unique<views::BoxLayoutView>();
+  counts->SetBetweenChildSpacing(16);
+  remove_button_ = counts->AddChildView(std::make_unique<SpaceThemeGlyphButton>(
+      base::BindRepeating(&ArcSpaceThemePicker::RemoveColor,
+                          base::Unretained(this)),
+      Glyph::kRemove, u"Remove color"));
+  add_button_ = counts->AddChildView(std::make_unique<SpaceThemeGlyphButton>(
+      base::BindRepeating(&ArcSpaceThemePicker::AddColor,
+                          base::Unretained(this)),
+      Glyph::kAdd, u"Add color"));
+  field_ = AddChildView(std::make_unique<SpaceThemeColorField>(
+      base::BindRepeating(&ArcSpaceThemePicker::SetColors,
+                          base::Unretained(this)),
+      std::move(modes), std::move(counts)));
+
+  palette_ = AddChildView(std::make_unique<SpaceThemePalette>(
+      base::BindRepeating(&ArcSpaceThemePicker::PickPaletteColor,
+                          base::Unretained(this))));
+
+  auto controls = std::make_unique<views::BoxLayoutView>();
+  controls->SetBetweenChildSpacing(14);
+  controls->SetCrossAxisAlignment(views::BoxLayout::CrossAxisAlignment::kCenter);
+  intensity_slider_ =
+      controls->AddChildView(std::make_unique<SpaceThemeIntensitySlider>(
+          base::BindRepeating(&ArcSpaceThemePicker::SetIntensity,
+                              base::Unretained(this))));
+  controls->SetFlexForView(intensity_slider_, 1);
+  grain_dial_ = controls->AddChildView(std::make_unique<SpaceThemeGrainDial>(
+      base::BindRepeating(&ArcSpaceThemePicker::SetGrain,
+                          base::Unretained(this))));
+  AddChildView(std::move(controls));
+
+  UpdateControls();
+}
+
+ArcSpaceThemePicker::~ArcSpaceThemePicker() {
+  if (controller_) {
+    controller_->SetSpaceTheme(space_id_, theme_);
+  }
+}
+
+void ArcSpaceThemePicker::SetTheme(SpaceTheme theme) {
+  theme_ = std::move(theme);
+  if (controller_) {
+    controller_->SetSpaceTheme(space_id_, theme_, /*save=*/false);
+  }
+  UpdateControls();
+}
+
+void ArcSpaceThemePicker::SetColors(std::vector<SkColor> colors,
+                                    size_t selected) {
+  SpaceTheme theme = theme_;
+  theme.colors = std::move(colors);
+  selected_color_ = selected;
+  SetTheme(std::move(theme));
+}
+
+void ArcSpaceThemePicker::SetMode(SpaceTheme::Mode mode) {
+  SpaceTheme theme = theme_;
+  theme.mode = mode;
+  SetTheme(std::move(theme));
+}
+
+void ArcSpaceThemePicker::SetIntensity(float intensity) {
+  SpaceTheme theme = theme_;
+  theme.intensity = intensity;
+  SetTheme(std::move(theme));
+}
+
+void ArcSpaceThemePicker::SetGrain(float grain) {
+  SpaceTheme theme = theme_;
+  theme.grain = grain;
+  SetTheme(std::move(theme));
+}
+
+void ArcSpaceThemePicker::AddColor() {
+  std::vector<SkColor> colors = theme_.colors;
+  if (colors.size() >= SpaceTheme::kMaxColors) {
+    return;
+  }
+  if (colors.empty()) {
+    colors.push_back(kPalette.front().color);
+  } else if (IsGray(colors.front())) {
+    // A lighter or darker gray.
+    const float value = ToHsv(colors.front()).value;
+    colors.push_back(FromHsv(0, 0, value > 0.5f ? value - 0.35f : value + 0.35f));
+  } else {
+    // A neighbor of the first color on either side, like Arc's.
+    const Hsv first = ToHsv(colors.front());
+    colors.push_back(FromHsv(first.hue + (colors.size() == 1 ? 50 : -50),
+                             std::max(first.saturation, 0.5f), first.value));
+  }
+  SetColors(colors, colors.size() - 1);
+}
+
+void ArcSpaceThemePicker::RemoveColor() {
+  std::vector<SkColor> colors = theme_.colors;
+  if (colors.empty()) {
+    return;
+  }
+  colors.erase(colors.begin() +
+               std::min(selected_color_, colors.size() - 1));
+  const size_t selected =
+      colors.empty() ? 0 : std::min(selected_color_, colors.size() - 1);
+  SetColors(std::move(colors), selected);
+}
+
+void ArcSpaceThemePicker::PickPaletteColor(SkColor color) {
+  std::vector<SkColor> colors = theme_.colors;
+  if (colors.empty()) {
+    colors.push_back(color);
+    SetColors(std::move(colors), 0);
+    return;
+  }
+  const size_t selected = std::min(selected_color_, colors.size() - 1);
+  colors[selected] = color;
+  SetColors(std::move(colors), selected);
+}
+
+void ArcSpaceThemePicker::UpdateControls() {
+  const std::vector<SkColor>& colors = theme_.colors;
+  selected_color_ =
+      colors.empty() ? 0 : std::min(selected_color_, colors.size() - 1);
+  field_->SetColors(colors, selected_color_);
+  for (size_t i = 0; i < mode_buttons_.size(); ++i) {
+    mode_buttons_[i]->SetSelected(i == static_cast<size_t>(theme_.mode));
+  }
+  remove_button_->SetEnabled(!colors.empty());
+  add_button_->SetEnabled(colors.size() < SpaceTheme::kMaxColors);
+  palette_->SetSelectedColor(
+      colors.empty() ? std::nullopt
+                     : std::optional<SkColor>(colors[selected_color_]));
+  intensity_slider_->SetValue(theme_.intensity);
+  grain_dial_->SetValue(theme_.grain);
+}
