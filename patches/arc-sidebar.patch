+ArcFavoritesDropZoneView::ArcFavoritesDropZoneView() {
+  constexpr int kIconSize = 16;
+  constexpr int kIconLabelSpacing = 6;
+  // Dimmed like the new tab button.
+  constexpr ui::ColorId kForegroundColor = kColorToolbarButtonIconDisabled;
+
+  auto* const layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+      kIconLabelSpacing));
+  layout->set_main_axis_alignment(views::BoxLayout::MainAxisAlignment::kCenter);
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+
+  AddChildView(std::make_unique<views::ImageView>(
+      ui::ImageModel::FromVectorIcon(kStarIcon, kForegroundColor, kIconSize)));
+  auto* const label =
+      AddChildView(std::make_unique<views::Label>(u"Drag to add favorites"));
+  label->SetEnabledColor(kForegroundColor);
+  label->SetAutoColorReadabilityEnabled(false);
+  // The tab strip paints to a transparent layer.
+  label->SetSubpixelRenderingEnabled(false);
