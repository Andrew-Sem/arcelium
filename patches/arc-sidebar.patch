+// Helium: opens the page of another app in a little window of its own, like
+// Little Arc's, which its toolbar moves into the last active window, see
+// ToolbarView.
+bool OpenStartupTabInLittleWindow(const StartupTabs& tabs, Profile* profile) {
+  if (tabs.size() != 1 || !tabs.front().url.SchemeIsHTTPOrHTTPS() ||
+      !arc_spaces::IsChosenForProfile(profile) ||
+      GetBrowserWindowCreationStatusForProfile(*profile) !=
+          BrowserWindowInterface::CreationStatus::kOk) {
+    return false;
+  }
+  // As large as Little Arc's, in the middle of the screen with the pointer.
+  display::Screen* const screen = display::Screen::Get();
+  gfx::Rect bounds =
+      screen->GetDisplayNearestPoint(screen->GetCursorScreenPoint())
+          .work_area();
+  constexpr gfx::Size kLittleWindowSize(1147, 718);
+  bounds.ClampToCenteredSize(
+      gfx::Size(std::min(kLittleWindowSize.width(), bounds.width() * 4 / 5),
+                std::min(kLittleWindowSize.height(), bounds.height() * 4 / 5)));
+  // The bounds of a popup are its page's, below its header, see ToolbarView.
+  constexpr int kLittleWindowHeaderHeight = 44;
+  bounds.set_height(bounds.height() - kLittleWindowHeaderHeight);
+  BrowserWindowCreateParams create_params(BrowserWindowInterface::TYPE_POPUP,
+                                          *profile,
+                                          /*from_user_gesture=*/true);
+  create_params.initial_bounds = bounds;
+  create_params.omit_from_session_restore = true;
+  BrowserWindowInterface* const browser =
+      CreateBrowserWindow(std::move(create_params));
+  NavigateParams params(browser, tabs.front().url,
+                        ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+  return true;
+}
