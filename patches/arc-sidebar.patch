+ArcFavoritesDropZoneView::~ArcFavoritesDropZoneView() = default;
+
+gfx::Size ArcFavoritesDropZoneView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(views::View::CalculatePreferredSize(available_size).width(),
+                   kArcPinnedTabHeight);
+}
+
+void ArcFavoritesDropZoneView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+
+  constexpr float kStrokeWidth = 1.f;
+  constexpr SkScalar kDashIntervals[] = {4.f, 3.f};
+  constexpr float kStrokeAlpha = 0.6f;
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(kStrokeWidth);
+  flags.setColor(color_utils::AlphaBlend(
+      GetColorProvider()->GetColor(kColorToolbarButtonIconDisabled),
+      SK_ColorTRANSPARENT, kStrokeAlpha));
+  flags.setPathEffect(cc::PathEffect::MakeDash(kDashIntervals, 2, 0));
+  gfx::RectF bounds(GetLocalBounds());
+  bounds.Inset(kStrokeWidth / 2);
+  canvas->DrawRoundRect(
+      bounds, GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius),
+      flags);
+}
