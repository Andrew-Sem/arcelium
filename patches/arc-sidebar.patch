+// The grid of icons in the space editor.
+class SpaceIconPicker : public views::View {
+  METADATA_HEADER(SpaceIconPicker, views::View)
+
+ public:
+  explicit SpaceIconPicker(std::string selected_id)
+      : selected_id_(std::move(selected_id)) {
+    constexpr int kColumns = 8;
+    constexpr int kCellSize = 32;
+    constexpr int kCellSpacing = 4;
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(),
+        kCellSpacing));
+
+    views::BoxLayoutView* row = nullptr;
+    const base::span<const arc_spaces::SpaceIcon> icons =
+        arc_spaces::GetSpaceIcons();
+    for (size_t i = 0; i < icons.size(); ++i) {
+      if (i % kColumns == 0) {
+        row = AddChildView(std::make_unique<views::BoxLayoutView>());
+        row->SetBetweenChildSpacing(kCellSpacing);
+      }
+      const arc_spaces::SpaceIcon& icon = icons[i];
+      const std::string id(icon.id);
+      auto cell = std::make_unique<views::LabelButton>(base::BindRepeating(
+          &SpaceIconPicker::Select, base::Unretained(this), id));
+      cell->SetImageModel(views::Button::STATE_NORMAL,
+                          ui::ImageModel::FromVectorIcon(
+                              icon.icon, ui::kColorIcon, kSpaceIconSize));
+      const std::u16string name(icon.name);
+      cell->SetTooltipText(name);
+      cell->GetViewAccessibility().SetName(name);
+      cell->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+      cell->SetBorder(views::CreateEmptyBorder(gfx::Insets()));
+      cell->SetPreferredSize(gfx::Size(kCellSize, kCellSize));
+      ConfigureInkDrop(cell.get());
+      cells_.push_back({id, row->AddChildView(std::move(cell))});
+    }
+    UpdateSelection();
+  }
+  SpaceIconPicker(const SpaceIconPicker&) = delete;
+  SpaceIconPicker& operator=(const SpaceIconPicker&) = delete;
+  ~SpaceIconPicker() override = default;
+
+  const std::string& selected_id() const { return selected_id_; }
+
+ private:
+  struct Cell {
+    std::string id;
+    raw_ptr<views::View> view;
+  };
+
+  void Select(const std::string& id) {
+    selected_id_ = id;
+    UpdateSelection();
+  }
+
+  void UpdateSelection() {
+    for (const Cell& cell : cells_) {
+      cell.view->SetBackground(
+          cell.id == selected_id_
+              ? views::CreateRoundedRectBackground(
+                    ui::kColorSysTonalContainer,
+                    GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius))
+              : nullptr);
+    }
+  }
+
+  std::string selected_id_;
+  std::vector<Cell> cells_;
+};
