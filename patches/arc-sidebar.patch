+// The space of a tab, kept with its contents so that it moves along.
+const char kTabSpaceDataKey[] = "helium_arc_space";
+
+// The storage partitions of spaces with their own logins, named by space id.
+constexpr char kSpacePartitionDomain[] = "heliumspace";
+
+// A new BrowsingInstance in `partition`, kept across navigations, or null for
+// the default one.
+scoped_refptr<content::SiteInstance> CreateSiteInstance(
+    Profile* profile,
+    const GURL& url,
+    const content::StoragePartitionConfig& partition) {
+  if (partition.is_default()) {
+    return nullptr;
+  }
+  return content::SiteInstance::CreateForFixedStoragePartition(profile, url,
+                                                               partition);
+}
+
+const content::StoragePartitionConfig& GetContentsPartition(
+    content::WebContents* contents) {
+  return contents->GetPrimaryMainFrame()->GetStoragePartition()->GetConfig();
+}
+
+// Contents in `partition` for the page of `contents`, with its history. Not
+// with its pages' state, which belongs to the other partition.
+std::unique_ptr<content::WebContents> CreateContentsInPartition(
+    Profile* profile,
+    content::WebContents* contents,
+    const content::StoragePartitionConfig& partition) {
+  content::WebContents::CreateParams params(
+      profile, CreateSiteInstance(profile, GURL(), partition));
+  params.initially_hidden =
+      contents->GetVisibility() == content::Visibility::HIDDEN;
+  params.desired_renderer_state =
+      content::WebContents::CreateParams::kNoRendererProcess;
+  params.last_active_time = contents->GetLastActiveTime();
+  params.last_active_time_ticks = contents->GetLastActiveTimeTicks();
+  std::unique_ptr<content::WebContents> new_contents =
+      content::WebContents::Create(params);
+  content::NavigationController& controller = contents->GetController();
+  content::NavigationController& new_controller = new_contents->GetController();
+  if (controller.IsInitialNavigation()) {
+    // Nothing committed yet: the page it opens.
+    if (const GURL url = contents->GetVisibleURL();
+        url.is_valid() && !url.IsAboutBlank()) {
+      new_controller.LoadURL(url, content::Referrer(),
+                             ui::PAGE_TRANSITION_AUTO_TOPLEVEL, std::string());
+    }
+    return new_contents;
+  }
+  std::vector<sessions::SerializedNavigationEntry> navigations;
+  for (int i = 0; i < controller.GetEntryCount(); ++i) {
+    navigations.push_back(
+        sessions::ContentSerializedNavigationBuilder::FromNavigationEntry(
+            i, controller.GetEntryAtIndex(i)));
+  }
+  std::vector<std::unique_ptr<content::NavigationEntry>> entries =
+      sessions::ContentSerializedNavigationBuilder::ToNavigationEntries(
+          navigations, profile);
+  new_controller.Restore(controller.GetLastCommittedEntryIndex(),
+                         content::RestoreType::kRestored, &entries);
+  // Hidden ones load once shown.
+  if (!params.initially_hidden) {
+    new_controller.LoadIfNecessary();
+  }
+  return new_contents;
+}
