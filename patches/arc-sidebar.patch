+}  // namespace tabs
+
+// Arc-style spaces for the sidebar address bar mode. A window's tabs, pinned
+// ones included, come in spaces, and its sidebar lists those of one space at a
+// time: the space of the active tab, however that tab got activated. New tabs
+// join the space showing, and a space whose last tab closes shows an empty
+// page. A space has a name, an icon from the set below and a theme, which
+// tints the window frame while it shows. A space may also keep its own
+// logins: its tabs then use a storage partition of their own, with separate
+// cookies and site data, e.g. for another Google account. Spaces and the space
+// of each tab are saved with the session.
+namespace arc_spaces {
+
+// Window and tab extra data in the session.
+inline constexpr char kWindowSpacesKey[] = "helium_arc_spaces";
+inline constexpr char kTabSpaceKey[] = "helium_arc_space";
+
+// How a space themes its window, like Arc's: the frame tint runs through its
+// colors from top to bottom, none for the theme's frame color. `intensity` and
+// `grain`, 0 to 1, set how strongly the tint and the film grain of the frame
+// material show, and `mode` may keep the window light or dark.
+struct SpaceTheme {
+  enum class Mode { kSystem, kLight, kDark };
+  static constexpr size_t kMaxColors = 3;
+  static constexpr float kDefaultIntensity = 0.5f;
+  static constexpr float kDefaultGrain = 0.5f;
+
+  // Opaque, at most kMaxColors.
+  std::vector<SkColor> colors;
+  Mode mode = Mode::kSystem;
+  float intensity = kDefaultIntensity;
+  float grain = kDefaultGrain;
+
+  friend bool operator==(const SpaceTheme&, const SpaceTheme&) = default;
+};
+
+struct Space {
+  std::string id;
+  std::u16string name;
+  // One of GetSpaceIcons().
+  std::string icon_id;
+  SpaceTheme theme;
+  // Whether the tabs of the space keep their own cookies and site data.
+  bool isolated = false;
+};
+
+// How the space showing in a window themes it: by its theme, blended
+// `progress` of the way into the theme of a space a swipe previews. `tracking`
+// while fingers move the swipe, which the tint follows without fading.
+struct FrameTint {
+  SpaceTheme theme;
+  std::optional<SpaceTheme> preview_theme;
+  float progress = 0;
+  bool tracking = false;
+};
+
+class SpacesController : public TabStripModelObserver {
+ public:
+  // The spaces of `browser`, made on first use unless `create` is false. Only
+  // normal windows of regular profiles have spaces.
+  static SpacesController* From(BrowserWindowInterface* browser,
+                                bool create = true);
+
+  // Runs `callback` with the window whenever the spaces of a window change,
+  // see RegisterOnChanged(), or a window gets them.
+  static base::CallbackListSubscription RegisterOnAnyChanged(
+      base::RepeatingCallback<void(BrowserWindowInterface*)> callback);
+
+  explicit SpacesController(BrowserWindowInterface* browser);
+  SpacesController(const SpacesController&) = delete;
+  SpacesController& operator=(const SpacesController&) = delete;
+  ~SpacesController() override;
+
+  // Whether the sidebar address bar mode, where spaces show, is on.
+  bool IsEnabled() const { return enabled_; }
+
+  const std::vector<Space>& spaces() const { return spaces_; }
+  const std::string& active_space_id() const { return active_space_id_; }
+  const Space* FindSpace(const std::string& id) const;
+
+  // The space whose tabs the sidebar lists: the active one, or another one a
+  // swipe between spaces previews.
+  const std::string& shown_space_id() const {
+    return preview_space_id_.empty() ? active_space_id_ : preview_space_id_;
+  }
+  // Lists the tabs of the space with `id` without activating any, for a swipe
+  // `progress` (0 to 1) of the way there, which blends the frame tint. Ends
+  // with SwitchTo() or ClearPreviewSpace(). `tracking` while fingers move it.
+  void SetPreviewSpace(const std::string& id, float progress, bool tracking);
+  void ClearPreviewSpace();
+  bool IsPreviewing() const { return !preview_space_id_.empty(); }
+  FrameTint GetFrameTint() const;
+
+  // Shows the space with `id`, its most recently used tab active.
+  void SwitchTo(const std::string& id);
+  // Shows the space `delta` places after the one showing, if any.
+  void SwitchBy(int delta);
+
+  // Adds a space after the others and shows it. Returns its id.
+  std::string CreateSpace();
+  // The icon that CreateSpace() gives the space.
+  std::string GetNewSpaceIcon() const;
+  void SetSpaceName(const std::string& id, const std::u16string& name);
+  void SetSpaceIcon(const std::string& id, const std::string& icon_id);
+  // Unless `save`, only previews `theme`, which a later call saves, e.g. while
+  // a picker changes it.
+  void SetSpaceTheme(const std::string& id, SpaceTheme theme, bool save = true);
+  // Moves the tabs of the space into the storage partition it gets, which
+  // reloads them.
+  void SetSpaceIsolated(const std::string& id, bool isolated);
+  // The storage partition of the tabs of the space with `id`.
+  content::StoragePartitionConfig GetSpacePartition(const std::string& id) const;
+  // The space that new tabs join.
+  const std::string& new_tab_space_id() const {
+    return pending_space_id_.empty() ? active_space_id_ : pending_space_id_;
+  }
+  bool CanCloseSpace() const { return spaces_.size() > 1; }
+  // Closes the tabs of the space and removes it.
+  void CloseSpace(const std::string& id);
+  // Moves `tab`, with its group or split, to the space with `id` and shows it.
+  void MoveTabToSpace(tabs::TabInterface* tab, const std::string& id);
+
+  // The space of `tab`, a tab of this window.
+  const std::string& GetTabSpace(const tabs::TabInterface* tab) const;
+  // Whether `tab` shows in the sidebar: in the space shown, or spaces off.
+  bool IsTabShown(const tabs::TabInterface* tab) const;
+  // Changes whenever a tab of this window changes spaces.
+  int tab_spaces_version() const { return tab_spaces_version_; }
+
+  // Runs `callback` when spaces are added, removed, edited or switched.
+  base::CallbackListSubscription RegisterOnChanged(
+      base::RepeatingClosure callback);
+
+  base::WeakPtr<SpacesController> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+  std::string SerializeForSession() const;
+  void RestoreFromSession(const std::string& data);
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+ private:
+  void OnModeChanged();
+  void EnsureSpace();
+  // Whether the space has tabs to activate: not in collapsed groups.
+  bool SpaceHasActivatableTabs(const std::string& id) const;
+  // Gives tabs of no known space the space showing.
+  void AdoptUnknownTabs();
+  void SetTabSpace(content::WebContents* contents, const std::string& id);
+  // Opens an empty page in the space with `id`, which then shows.
+  void OpenEmptyTab(const std::string& id);
+  // Does so once no tab drag needs the tab strip, if the space still has no
+  // tab to activate.
+  void OpenEmptyTabIfNeeded(const std::string& id);
+  void SetActiveSpace(const std::string& id);
+  // Moves tabs whose contents aren't in the storage partition of their space,
+  // e.g. ones opened elsewhere, into it, once no tab drag needs the tab strip.
+  void FixTabPartitionsSoon();
+  void FixTabPartitions();
+  void SaveWindow();
+  void NotifyChanged();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  PrefChangeRegistrar pref_change_registrar_;
+  bool enabled_ = false;
+  std::vector<Space> spaces_;
+  std::string active_space_id_;
+  std::string preview_space_id_;
+  int tab_spaces_version_ = 0;
+  float preview_progress_ = 0;
+  bool preview_tracking_ = false;
+  // Whether a theme shows unsaved, see SetSpaceTheme().
+  bool theme_previewing_ = false;
+  // The space that tabs opened by this controller join.
+  std::string pending_space_id_;
+  bool fixing_tab_partitions_ = false;
+  base::RepeatingClosureList on_changed_callbacks_;
+  base::WeakPtrFactory<SpacesController> weak_factory_{this};
+};
+
+// Whether the windows of `profile` show the sidebar address bar mode, which
+// spaces go with.
+bool IsEnabledForProfile(Profile* profile);
+
+// Whether `profile` chose the sidebar address bar mode, even while zen mode
+// hides the sidebar. Arc-like behavior outside of the sidebar, such as little
+// windows for pages from other apps, goes with it.
+bool IsChosenForProfile(Profile* profile);
+
+// Whether `browser` is a little window: a popup, such as the one a page from
+// another app opens in, in the sidebar address bar mode. Like Little Arc, it
+// has a slim header with the page's address and a button that moves the page
+// into the last active window, also on Cmd+O.
+bool IsLittleWindow(const BrowserWindowInterface* browser);
+
+// The window the page of the little window `browser` moves into: the last
+// active one of its profile, if any.
+BrowserWindowInterface* GetLittleWindowTarget(BrowserWindowInterface* browser);
+
+// Whether `tab` shows in the sidebar of its window, see
+// SpacesController::IsTabShown(). Tabs of windows without spaces always do.
+bool IsTabShown(const tabs::TabInterface* tab);
+
+// Whether the sidebar lists `tab`: shown, and not an empty page, which the
+// sidebar address bar mode leaves out. For keyboard tab switching.
+bool IsTabListed(const tabs::TabInterface* tab);
+
+// Whether `tab` is in the space of `reference`, both tabs of one window, or
+// that window has no spaces showing.
+bool AreTabsInSameSpace(const tabs::TabInterface* tab,
+                        const tabs::TabInterface* reference);
+
+// See FrameTint. A little window takes the theme of the space its page would
+// move into, see GetLittleWindowTarget().
+FrameTint GetFrameTint(BrowserWindowInterface* browser);
+
+// A new BrowsingInstance in the storage partition of the space a new tab of
+// `browser`, opening `url`, joins, or null for the profile's own.
+scoped_refptr<content::SiteInstance> GetSiteInstanceForNewTab(
+    BrowserWindowInterface* browser,
+    const GURL& url);
+// The same for a tab restored into `browser` from the session.
+scoped_refptr<content::SiteInstance> GetSiteInstanceForRestoredTab(
+    BrowserWindowInterface* browser,
+    const std::map<std::string, std::string>& extra_data);
+
+// Session support. Restored tabs keep their space if their window has it.
+void RestoreTabSpace(content::WebContents* contents,
+                     const std::map<std::string, std::string>& extra_data);
+void RestoreWindowSpaces(BrowserWindowInterface* browser,
+                         const std::map<std::string, std::string>& extra_data);
+std::string GetTabSpaceForSession(const content::WebContents* contents);
+std::string GetWindowSpacesForSession(BrowserWindowInterface* browser);
+
+// The icons a space can have, like the symbols of Arc's.
+struct SpaceIcon {
+  std::string_view id;
+  const gfx::VectorIcon& icon;
+  std::u16string_view name;
+};
+base::span<const SpaceIcon> GetSpaceIcons();
+// The icon with `id`, if any.
+const gfx::VectorIcon* FindSpaceIcon(std::string_view id);
+
+// The name a space goes by: its own, else its position (`index` is 0-based).
+std::u16string GetSpaceDisplayName(const Space& space, size_t index);
+
+}  // namespace arc_spaces
+
