+void TabDragController::UpdateSidebarTabDragPreview(
+    const gfx::Point& point_in_screen) {
+  BrowserView* const browser_view = GetBrowserViewForContext(source_context_);
+  if (!browser_view || !browser_view->IsSidebarAddressBarActive() ||
+      attached_context_ != source_context_ ||
+      drag_data_.num_dragging_tabs() != 1 ||
+      !drag_data_.dragging_groups.empty() ||
+      !browser_view->multi_contents_view()->GetBoundsInScreen().Contains(
+          point_in_screen)) {
+    sidebar_drag_preview_.reset();
+    return;
+  }
+  if (!sidebar_drag_preview_) {
+    sidebar_drag_preview_ = std::make_unique<views::Widget>();
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_TOOLTIP);
+    params.parent = source_context_->GetWidget()->GetNativeView();
+    params.context = source_context_->GetWidget()->GetNativeWindow();
+    params.activatable = views::Widget::InitParams::Activatable::kNo;
+    params.accept_events = false;
+    params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+    params.shadow_type = views::Widget::InitParams::ShadowType::kDrop;
+    params.name = "ArcTabDragPreview";
+    sidebar_drag_preview_->Init(std::move(params));
+    sidebar_drag_preview_->SetVisibilityChangedAnimationsEnabled(false);
+    auto* const preview = sidebar_drag_preview_->SetContentsView(
+        std::make_unique<ArcTabDragPreview>(
+            drag_data_.source_view_drag_data()->contents));
+    if (!drag_image_.isNull()) {
+      preview->SetThumbnail(drag_image_);
+    }
+  }
+  const gfx::Size size =
+      sidebar_drag_preview_->GetContentsView()->GetPreferredSize();
+  const gfx::Rect work_area =
+      display::Screen::Get()->GetDisplayNearestPoint(point_in_screen).work_area();
+  gfx::Rect bounds(point_in_screen + gfx::Vector2d(16, 20), size);
+  if (bounds.right() > work_area.right()) {
+    bounds.set_x(point_in_screen.x() - size.width() - 16);
+  }
+  if (bounds.bottom() > work_area.bottom()) {
+    bounds.set_y(point_in_screen.y() - size.height() - 20);
+  }
+  bounds.AdjustToFit(work_area);
+  sidebar_drag_preview_->SetBounds(bounds);
+  sidebar_drag_preview_->ShowInactive();
+}
