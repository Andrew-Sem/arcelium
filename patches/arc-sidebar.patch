+base::RepeatingCallbackList<void(BrowserWindowInterface*)>&
+GetAnyChangedCallbacks() {
+  static base::NoDestructor<
+      base::RepeatingCallbackList<void(BrowserWindowInterface*)>>
+      callbacks;
+  return *callbacks;
+}
+
+// Colors are saved as "#RRGGBB".
+std::string ColorToString(SkColor color) {
+  return base::StringPrintf("#%02X%02X%02X", SkColorGetR(color),
+                            SkColorGetG(color), SkColorGetB(color));
+}
+
+std::optional<SkColor> ColorFromString(std::string_view text) {
+  uint32_t rgb = 0;
+  if (text.size() != 7 || text[0] != '#' ||
+      !base::HexStringToUInt(text.substr(1), &rgb)) {
+    return std::nullopt;
+  }
+  return SkColorSetA(rgb, SK_AlphaOPAQUE);
+}
+
+// At most SpaceTheme::kMaxColors opaque colors, amounts within 0 to 1.
+SpaceTheme NormalizeTheme(SpaceTheme theme) {
+  if (theme.colors.size() > SpaceTheme::kMaxColors) {
+    theme.colors.resize(SpaceTheme::kMaxColors);
+  }
+  for (SkColor& color : theme.colors) {
+    color = SkColorSetA(color, SK_AlphaOPAQUE);
+  }
+  theme.intensity = std::clamp(theme.intensity, 0.0f, 1.0f);
+  theme.grain = std::clamp(theme.grain, 0.0f, 1.0f);
+  return theme;
+}
+
+struct TabSpaceData : public base::SupportsUserData::Data {
+  std::string space_id;
+  // Whether `space_id` comes from the session, for the tab to keep once it
+  // joins its window. Tabs joining otherwise take the space showing.
+  bool restored = false;
+};
+
+TabSpaceData* GetTabSpaceData(const content::WebContents* contents) {
+  return static_cast<TabSpaceData*>(contents->GetUserData(&kTabSpaceDataKey));
+}
+
+TabSpaceData& GetOrCreateTabSpaceData(content::WebContents* contents) {
+  if (TabSpaceData* const data = GetTabSpaceData(contents)) {
+    return *data;
+  }
+  auto data = std::make_unique<TabSpaceData>();
+  TabSpaceData& data_ref = *data;
+  contents->SetUserData(&kTabSpaceDataKey, std::move(data));
+  return data_ref;
+}
+
+// Owns the controllers, one per window, until their window closes.
+class ControllerRegistry : public BrowserCollectionObserver {
+ public:
+  static ControllerRegistry& Get() {
+    static base::NoDestructor<ControllerRegistry> registry;
+    return *registry;
+  }
+
+  SpacesController* Find(const BrowserWindowInterface* browser) {
+    const auto it = controllers_.find(browser->GetSessionID().id());
+    return it != controllers_.end() ? it->second.get() : nullptr;
+  }
+
+  SpacesController* Create(BrowserWindowInterface* browser) {
+    if (!observation_.IsObserving()) {
+      observation_.Observe(GlobalBrowserCollection::GetInstance());
+    }
+    std::unique_ptr<SpacesController>& controller =
+        controllers_[browser->GetSessionID().id()];
+    controller = std::make_unique<SpacesController>(browser);
+    return controller.get();
+  }
+
+  // BrowserCollectionObserver:
+  void OnBrowserClosed(BrowserWindowInterface* browser) override {
+    controllers_.erase(browser->GetSessionID().id());
+  }
+
+ private:
+  std::map<SessionID::id_type, std::unique_ptr<SpacesController>> controllers_;
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      observation_{this};
+};
+
+
+// Spaces only last across restarts if those restore the last session: turns
+// that on unless a policy decides. Not LAST_AND_URLS for startup pages, which
+// would open in the session's windows.
+void KeepSpacesAcrossRestarts(Profile* profile) {
+  PrefService* const prefs = profile->GetPrefs();
+  if (SessionStartupPref::TypeIsManaged(prefs)) {
+    return;
+  }
+  SessionStartupPref startup = SessionStartupPref::GetStartupPref(prefs);
+  if (startup.ShouldRestoreLastSession()) {
+    return;
+  }
+  startup.type = SessionStartupPref::LAST;
+  SessionStartupPref::SetStartupPref(prefs, startup);
+}
+
+// The first icon no space of `spaces` has, else one by their count.
+std::string PickSpaceIcon(const std::vector<Space>& spaces) {
+  const base::span<const SpaceIcon> icons = GetSpaceIcons();
+  for (const SpaceIcon& icon : icons) {
+    if (std::ranges::find(spaces, icon.id, &Space::icon_id) == spaces.end()) {
+      return std::string(icon.id);
+    }
+  }
+  return std::string(icons[spaces.size() % icons.size()].id);
+}
+
+// Gives spaces without an icon of the set, e.g. from older sessions, one.
+void EnsureSpaceIcons(std::vector<Space>& spaces) {
+  for (Space& space : spaces) {
+    if (!FindSpaceIcon(space.icon_id)) {
+      space.icon_id = PickSpaceIcon(spaces);
+    }
+  }
+}
+
+}  // namespace
+
+bool IsEnabledForProfile(Profile* profile) {
+  // As HeliumLayoutStateController::IsSidebarAddressBarEnabled(), which is
+  // per window and not there yet while session restore creates windows.
+  return IsChosenForProfile(profile) &&
+         !profile->GetPrefs()->GetBoolean(prefs::kHeliumZenMode);
+}
+
+bool IsChosenForProfile(Profile* profile) {
+  const PrefService* const prefs = profile->GetPrefs();
+  return prefs->GetInteger(prefs::kHeliumLayout) ==
+             std::to_underlying(HeliumLayoutType::kVertical) &&
+         prefs->GetBoolean(prefs::kHeliumSidebarAddressBar);
+}
+
+bool IsLittleWindow(const BrowserWindowInterface* browser) {
+  return browser &&
+         browser->GetType() == BrowserWindowInterface::TYPE_POPUP &&
+         IsChosenForProfile(
+             const_cast<BrowserWindowInterface*>(browser)->GetProfile());
+}
+
+BrowserWindowInterface* GetLittleWindowTarget(BrowserWindowInterface* browser) {
+  return ProfileBrowserCollection::GetForProfile(browser->GetProfile())
+      ->FindTabbedBrowser();
+}
+
+// static
+SpacesController* SpacesController::From(BrowserWindowInterface* browser,
+                                         bool create) {
+  if (!browser || browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      browser->GetProfile()->IsOffTheRecord()) {
+    return nullptr;
+  }
+  ControllerRegistry& registry = ControllerRegistry::Get();
+  if (SpacesController* const controller = registry.Find(browser)) {
+    return controller;
+  }
+  if (!create || browser->IsDeleteScheduled()) {
+    return nullptr;
+  }
+  SpacesController* const controller = registry.Create(browser);
+  GetAnyChangedCallbacks().Notify(browser);
+  return controller;
+}
