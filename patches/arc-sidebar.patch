+}
+
+void ArcSidebarFooterView::Layout(PassKey) {
+  constexpr int kSpacesBarGap = 4;
+  const int row_height = GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
+  const int row_y = std::max(0, height() - row_height);
+  // The switcher scrolls its spaces rather than crowd out the actions, which
+  // get all the room it doesn't need, not just their preferred width: their
+  // animating layout hides what doesn't fit. The room they'll take once done
+  // animating: the switcher taking what they take on the way squeezes them
+  // back, over and over.
+  const int actions_width = GetActionsTargetWidth(actions_host_);
+  const int bar_width =
+      spaces_bar_
+          ? std::min(spaces_bar_->GetPreferredSize().width(),
+                     std::max(0, width() - actions_width - kSpacesBarGap))
+          : 0;
+  actions_host_->SetBounds(
+      0, row_y,
+      std::max(0, width() - (bar_width ? bar_width + kSpacesBarGap : 0)),
+      std::min(height(), row_height));
+  if (!spaces_bar_) {
+    return;
+  }
+  // The rest of the row, where the switcher centers its spaces and puts its
+  // new space button at the end.
+  const int bar_height = std::min(spaces_bar_->GetPreferredSize().height(),
+                                  height());
+  const int x =
+      actions_width ? std::min(width(), actions_width) + kSpacesBarGap : 0;
+  spaces_bar_->SetBounds(
+      x, row_y + std::max(0, (std::min(height(), row_height) - bar_height) / 2),
+      std::max(0, width() - x), bar_height);
+}
+
+void ArcSidebarFooterView::ViewHierarchyChanged(
+    const views::ViewHierarchyChangedDetails& details) {
+  // The sidebar paints to a translucent layer, so text in it can't use
+  // subpixel rendering.
+  if (details.is_add && Contains(details.child)) {
+    DisableSubpixelRendering(details.child);
+  }
+}
+
+void ArcSidebarFooterView::ChildPreferredSizeChanged(views::View* child) {
+  InvalidateLayout();
+}
+
+bool ArcSidebarFooterView::DoesIntersectRect(const views::View* target,
+                                             const gfx::Rect& rect) const {
+  if (GetRowBounds().Intersects(rect)) {
+    return true;
+  }
+  if (!spaces_bar_) {
+    return false;
+  }
+  gfx::Rect rect_in_bar = rect;
+  rect_in_bar.Offset(-spaces_bar_->x(), -spaces_bar_->y());
+  return spaces_bar_->HitTestRect(rect_in_bar);
+}
+
+gfx::Rect ArcSidebarFooterView::GetRowBounds() const {
+  const int row_height = GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
+  const int row_width =
+      std::min(width(), actions_host_->GetPreferredSize().width());
+  return gfx::Rect(0, std::max(0, height() - row_height), row_width,
+                   std::min(height(), row_height));
+}
