+
+// The field of colors, like Arc's, over a fine grid of dots: hues around the
+// center, more saturated further out, and grays, darker in the center. The
+// colors of the theme show as large dots to drag, the selected one on top.
+// Dragging the first color turns the others with it, keeping the gradient's
+// harmony.
+class SpaceThemeColorField : public views::View {
+  METADATA_HEADER(SpaceThemeColorField, views::View)
+
+ public:
+  using ChangedCallback =
+      base::RepeatingCallback<void(std::vector<SkColor>, size_t)>;
+
+  SpaceThemeColorField(ChangedCallback on_changed,
+                       std::unique_ptr<views::View> top_row,
+                       std::unique_ptr<views::View> bottom_row)
+      : on_changed_(std::move(on_changed)) {
+    dots_ = AddChildView(std::make_unique<SpaceThemeColorDots>(
+        base::BindRepeating(&SpaceThemeColorField::GetPosition,
+                            base::Unretained(this))));
+    top_row_ = AddChildView(std::move(top_row));
+    bottom_row_ = AddChildView(std::move(bottom_row));
+    GetViewAccessibility().SetRole(ax::mojom::Role::kGroup);
+    GetViewAccessibility().SetName(u"Colors");
+  }
+  SpaceThemeColorField(const SpaceThemeColorField&) = delete;
+  SpaceThemeColorField& operator=(const SpaceThemeColorField&) = delete;
+  ~SpaceThemeColorField() override = default;
+
+  void SetColors(const std::vector<SkColor>& colors, size_t selected) {
+    colors_ = colors;
+    selected_ = selected;
+    gray_angles_.resize(colors_.size(), kGrayAngle);
+    dots_->SetColors(colors, selected);
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kPickerWidth, kFieldHeight);
+  }
+
+  void Layout(PassKey) override {
+    dots_->SetBoundsRect(GetLocalBounds());
+    const auto place = [&](views::View* row, int y) {
+      const gfx::Size size = row->GetPreferredSize();
+      row->SetBounds((width() - size.width()) / 2, y, size.width(),
+                     size.height());
+    };
+    place(top_row_, kFieldRowInset);
+    place(bottom_row_, height() - kFieldRowInset - kGlyphButtonSize);
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const gfx::RectF bounds(GetLocalBounds());
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(GetForeground(this, IsDark(this) ? 0x0D : 0x08));
+    canvas->DrawRoundRect(bounds, kFieldCornerRadius, flags);
+
+    // The grid, centered.
+    flags.setColor(GetForeground(this, 0x30));
+    const float columns =
+        std::floor((bounds.width() - 2 * kGridInset) / kGridSpacing);
+    const float rows =
+        std::floor((bounds.height() - 2 * kGridInset) / kGridSpacing);
+    const float start_x = (bounds.width() - columns * kGridSpacing) / 2;
+    const float start_y = (bounds.height() - rows * kGridSpacing) / 2;
+    for (float row = 0; row <= rows; ++row) {
+      for (float column = 0; column <= columns; ++column) {
+        canvas->DrawCircle(gfx::PointF(start_x + column * kGridSpacing,
+                                       start_y + row * kGridSpacing),
+                           0.6f, flags);
+      }
+    }
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (!event.IsOnlyLeftMouseButton()) {
+      return false;
+    }
+    const gfx::PointF point(event.location());
+    // A dot pressed gets selected, to drag from where it was grabbed. The
+    // selected one is on top.
+    std::vector<size_t> order;
+    if (selected_ < colors_.size()) {
+      order.push_back(selected_);
+    }
+    for (size_t i = 0; i < colors_.size(); ++i) {
+      if (i != selected_) {
+        order.push_back(i);
+      }
+    }
+    for (size_t i : order) {
+      const gfx::PointF position = GetPosition(i);
+      const float radius = i == selected_ ? kSelectedDotRadius : kDotRadius;
+      if ((position - point).Length() <= radius + 3) {
+        dragging_ = i;
+        drag_offset_ = position - point;
+        on_changed_.Run(colors_, i);
+        return true;
+      }
+    }
+    // Elsewhere, the selected color moves there, or a first one shows up.
+    dragging_ = colors_.empty() ? 0 : selected_;
+    drag_offset_ = gfx::Vector2dF();
+    MoveTo(point);
+    return true;
+  }
+
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    if (dragging_) {
+      MoveTo(gfx::PointF(event.location()));
+    }
+    return true;
+  }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    dragging_.reset();
+  }
+
+  void OnMouseCaptureLost() override { dragging_.reset(); }
+
+ private:
+  gfx::PointF GetHueCenter() const {
+    return gfx::RectF(GetLocalBounds()).CenterPoint();
+  }
+
+  float GetHueRadius() const {
+    return std::max(1.0f, std::min(width(), height()) / 2.0f - kHueInset);
+  }
+
+  gfx::PointF GetPosition(size_t index) const {
+    const Hsv hsv = ToHsv(colors_[index]);
+    const bool gray = hsv.saturation < kGraySaturation;
+    const float angle =
+        ToRadians(gray && index < gray_angles_.size() ? gray_angles_[index]
+                                                      : hsv.hue);
+    const float distance =
+        (gray ? (hsv.value - kMinGrayValue) / (1 - kMinGrayValue)
+              : hsv.saturation) *
+        GetHueRadius();
+    return GetHueCenter() + gfx::Vector2dF(std::sin(angle) * distance,
+                                           -std::cos(angle) * distance);
+  }
+
+  // Gives the color dragged what's at `point`, as far as the field goes: a
+  // gray its brightness, another color its hue and saturation, keeping its
+  // brightness. The first color turns the others with it.
+  void MoveTo(const gfx::PointF& point) {
+    const gfx::Vector2dF offset = point + drag_offset_ - GetHueCenter();
+    const float angle = AngleOf(offset);
+    const float distance = std::min(offset.Length() / GetHueRadius(), 1.0f);
+    std::vector<SkColor> colors = colors_;
+    const size_t index = std::min(*dragging_, colors.size());
+    if (index == colors.size()) {
+      colors.push_back(FromHsv(angle, distance, kDefaultValue));
+      on_changed_.Run(std::move(colors), index);
+      return;
+    }
+    const Hsv hsv = ToHsv(colors[index]);
+    if (hsv.saturation < kGraySaturation) {
+      gray_angles_[index] = angle;
+      colors[index] = FromHsv(
+          0, 0, kMinGrayValue + (1 - kMinGrayValue) * distance);
+      on_changed_.Run(std::move(colors), index);
+      return;
+    }
+    colors[index] = FromHsv(angle, std::max(distance, kGraySaturation),
+                            hsv.value);
+    if (index == 0) {
+      const float turn = angle - hsv.hue;
+      for (size_t i = 1; i < colors.size(); ++i) {
+        const Hsv other = ToHsv(colors[i]);
+        if (other.saturation >= kGraySaturation) {
+          colors[i] = FromHsv(other.hue + turn, other.saturation, other.value);
+        }
+      }
+    }
+    on_changed_.Run(std::move(colors), index);
+  }
+
+  const ChangedCallback on_changed_;
+  raw_ptr<SpaceThemeColorDots> dots_ = nullptr;
+  raw_ptr<views::View> top_row_ = nullptr;
+  raw_ptr<views::View> bottom_row_ = nullptr;
+  std::vector<SkColor> colors_;
+  // Where grays show around the center, which their color doesn't tell.
+  std::vector<float> gray_angles_;
+  size_t selected_ = 0;
+  std::optional<size_t> dragging_;
+  gfx::Vector2dF drag_offset_;
+};
+
+BEGIN_METADATA(SpaceThemeColorField)
+END_METADATA
