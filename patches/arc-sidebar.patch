+void ToolbarView::SetSidebarHosts(views::View* navigation_host,
+                                  views::View* actions_host) {
+  const bool sidebar_mode = navigation_host && actions_host;
+  if (sidebar_mode == sidebar_mode_ || display_mode_ != DisplayMode::kNormal) {
+    return;
+  }
+  sidebar_mode_ = sidebar_mode;
+
+  // The floating command bar paints the card behind the toolbar.
+  if (auto* const toolbar_background =
+          background() ? background()->AsA<CustomCornersBackground>()
+                       : nullptr) {
+    toolbar_background->SetVisible(!sidebar_mode_);
+  }
+
+  if (sidebar_mode_) {
+    // Remember where each view lived, in toolbar order, so that the hosts
+    // receive them in the same order and they can be put back later.
+    for (views::View* view :
+         std::array<views::View*, 5>{back_, forward_, reload_,
+                                     extensions_container_,
+                                     pinned_toolbar_actions_container_}) {
+      if (view && view->parent() == this) {
+        sidebar_moved_views_.emplace_back(view, GetIndexOf(view).value());
+      }
+    }
+    std::ranges::sort(sidebar_moved_views_, {},
+                      &std::pair<raw_ptr<views::View>, size_t>::second);
+    const std::array<views::View*, 3> navigation_views{back_, forward_,
+                                                       reload_};
+    // Pinned actions (downloads, ...) live at the bottom of the sidebar.
+    views::View* const pinned_actions_host =
+        ArcSidebarHeaderView::GetPinnedActionsHostFor(actions_host);
+    for (auto& [view, index] : sidebar_moved_views_) {
+      const bool is_navigation =
+          std::ranges::find(navigation_views, view.get()) !=
+          navigation_views.end();
+      views::View* const host =
+          is_navigation ? navigation_host
+          : view.get() == pinned_toolbar_actions_container_
+              ? pinned_actions_host
+              : actions_host;
+      host->AddChildView(view.get());
+      // The toolbar's layout may have hidden them, e.g. the pinned actions
+      // while empty, but the sidebar always shows them, the downloads button
+      // included.
+      if (is_navigation || view.get() == pinned_toolbar_actions_container_) {
+        view->SetVisible(true);
+      }
+    }
+
+    // Everything else that would compete with the location bar in the
+    // floating command bar is hidden.
+    for (views::View* view :
+         std::array<views::View*, 5>{home_, avatar_, app_menu_button_,
+                                     vertical_tabs_collapse_button_,
+                                     dynamic_new_tab_button_}) {
+      if (view) {
+        sidebar_hidden_views_.emplace_back(view, view->GetVisible());
+        view->SetVisible(false);
+      }
+    }
+  } else {
+    // Indices are re-inserted in ascending order, which restores the original
+    // positions.
+    for (auto& [view, index] : sidebar_moved_views_) {
+      AddChildViewAt(view.get(), std::min(index, children().size()));
+    }
+    sidebar_moved_views_.clear();
+    for (auto& [view, visible] : sidebar_hidden_views_) {
+      view->SetVisible(visible);
+    }
+    sidebar_hidden_views_.clear();
+
+    if (back_) {
+      back_->SetVisible(show_back_button_.GetValue());
+    }
+    if (forward_) {
+      SetForwardButtonVisibility(show_forward_button_.GetValue());
+    }
+    if (reload_) {
+      reload_->SetVisible(show_reload_button_.GetValue());
+    }
+    UpdateToolbarLayout();
+  }
+
+  InvalidateLayout();
+}
