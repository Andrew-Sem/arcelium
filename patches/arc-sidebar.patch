+namespace {
+
+// Like Arc, the new tab page is an empty window in the sidebar address bar
+// mode: the frame shows through instead of the page.
+void UpdateArcEmptyPage(BrowserView& browser_view) {
+  MultiContentsView* const multi_contents = browser_view.multi_contents_view();
+  views::WebView* const active_view = browser_view.GetActiveContentsWebView();
+  if (!multi_contents || !active_view) {
+    return;
+  }
+  content::WebContents* const contents = browser_view.GetActiveWebContents();
+  // The mode's pref rather than IsSidebarAddressBarActive(), which only turns
+  // on once the window is set up, so the page does not flash at startup.
+  auto* const layout_controller =
+      HeliumLayoutStateController::From(browser_view.browser());
+  const bool hide_active =
+      !browser_view.IsInSplitView() && layout_controller &&
+      layout_controller->IsSidebarAddressBarEnabled() && contents &&
+      IsArcEmptyPage(contents->GetVisibleURL(),
+                     contents->GetLastCommittedURL());
+  // Each pane but the active one shows: a pane hidden for an empty page may
+  // show another page since, e.g. one of a split.
+  bool changed = false;
+  for (const auto& container : multi_contents->contents_container_views()) {
+    views::WebView* const view = container->contents_view();
+    const bool visible = !hide_active || view != active_view;
+    if (view->GetVisible() != visible) {
+      view->SetVisible(visible);
+      changed = true;
+    }
+  }
+  if (!changed) {
+    return;
+  }
+  // The background behind it paints the empty window.
+  for (views::View* child : multi_contents->children()) {
+    if (views::IsViewClass<MultiContentsBackgroundView>(child)) {
+      child->SchedulePaint();
+    }
+  }
+}
