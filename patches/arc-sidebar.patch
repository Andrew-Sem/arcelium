+Hsv ToHsv(SkColor color) {
+  SkScalar hsv[3];
+  SkColorToHSV(color, hsv);
+  return {hsv[0], hsv[1], hsv[2]};
+}
+
+SkColor FromHsv(float hue, float saturation, float value) {
+  const SkScalar hsv[3] = {std::fmod(hue + 360, 360.0f),
+                           std::clamp(saturation, 0.0f, 1.0f),
+                           std::clamp(value, 0.0f, 1.0f)};
+  return SkHSVToColor(hsv);
+}
+
+float ToRadians(float degrees) {
+  return degrees * std::numbers::pi_v<float> / 180;
+}
