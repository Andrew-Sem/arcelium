+// The top-level window that `window` is a (possibly nested) child of.
+NSWindow* TopLevelWindow(NSWindow* window) {
+  while (window.parentWindow) {
+    window = window.parentWindow;
+  }
+  return window;
+}
+
+std::string WindowClassName(NSWindow* window) {
+  return window ? base::SysNSStringToUTF8(NSStringFromClass([window class]))
+                : "nil";
+}
