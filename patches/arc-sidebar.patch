+// The palette, a page of swatches at a time, like Arc's.
+class SpaceThemePalette : public views::View {
+  METADATA_HEADER(SpaceThemePalette, views::View)
+
+ public:
+  explicit SpaceThemePalette(base::RepeatingCallback<void(SkColor)> pick)
+      : pick_(std::move(pick)) {
+    previous_ = AddChildView(std::make_unique<SpaceThemeGlyphButton>(
+        base::BindRepeating(&SpaceThemePalette::ShowPageBy,
+                            base::Unretained(this), -1),
+        Glyph::kPrevious, u"Previous colors", kPaletteArrowWidth));
+    for (size_t i = 0; i < kSwatchesPerPage; ++i) {
+      swatches_.push_back(AddChildView(std::make_unique<SpaceThemeSwatch>(
+          base::BindRepeating(&SpaceThemePalette::Pick, base::Unretained(this),
+                              i))));
+    }
+    next_ = AddChildView(std::make_unique<SpaceThemeGlyphButton>(
+        base::BindRepeating(&SpaceThemePalette::ShowPageBy,
+                            base::Unretained(this), 1),
+        Glyph::kNext, u"More colors", kPaletteArrowWidth));
+    ShowPage(0);
+  }
+  SpaceThemePalette(const SpaceThemePalette&) = delete;
+  SpaceThemePalette& operator=(const SpaceThemePalette&) = delete;
+  ~SpaceThemePalette() override = default;
+
+  // Rings the swatch of `color`, if any, turning to its page as it changes.
+  void SetSelectedColor(std::optional<SkColor> color) {
+    if (selected_ == color) {
+      return;
+    }
+    selected_ = color;
+    const auto it = std::ranges::find(kPalette, color, &PaletteColor::color);
+    ShowPage(it != kPalette.end()
+                 ? static_cast<size_t>(it - kPalette.begin()) /
+                       kSwatchesPerPage
+                 : page_);
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kPickerWidth, kGlyphButtonSize);
+  }
+
+  void Layout(PassKey) override {
+    const int content_width =
+        2 * (kPaletteArrowWidth + kSwatchSpacing) +
+        static_cast<int>(kSwatchesPerPage) * (kSwatchSize + kSwatchSpacing) -
+        kSwatchSpacing;
+    int x = std::max(0, (width() - content_width) / 2);
+    previous_->SetBounds(x, (height() - kGlyphButtonSize) / 2,
+                         kPaletteArrowWidth, kGlyphButtonSize);
+    x += kPaletteArrowWidth + kSwatchSpacing;
+    for (views::View* swatch : swatches_) {
+      swatch->SetBounds(x, (height() - kSwatchSize) / 2, kSwatchSize,
+                        kSwatchSize);
+      x += kSwatchSize + kSwatchSpacing;
+    }
+    next_->SetBounds(x, (height() - kGlyphButtonSize) / 2, kPaletteArrowWidth,
+                     kGlyphButtonSize);
+  }
+
+ private:
+  void ShowPageBy(int delta) {
+    ShowPage(static_cast<size_t>(
+        std::clamp(static_cast<int>(page_) + delta, 0,
+                   static_cast<int>(kPalettePages) - 1)));
+  }
+
+  void ShowPage(size_t page) {
+    page_ = page;
+    for (size_t i = 0; i < swatches_.size(); ++i) {
+      const size_t index = page_ * kSwatchesPerPage + i;
+      swatches_[i]->SetVisible(index < kPalette.size());
+      if (index < kPalette.size()) {
+        swatches_[i]->SetColor(kPalette[index].color, kPalette[index].name,
+                               selected_ == kPalette[index].color);
+      }
+    }
+    previous_->SetEnabled(page_ > 0);
+    next_->SetEnabled(page_ + 1 < kPalettePages);
+  }
+
+  void Pick(size_t swatch) {
+    const size_t index = page_ * kSwatchesPerPage + swatch;
+    if (index < kPalette.size()) {
+      pick_.Run(kPalette[index].color);
+    }
+  }
+
+  const base::RepeatingCallback<void(SkColor)> pick_;
+  raw_ptr<SpaceThemeGlyphButton> previous_ = nullptr;
+  raw_ptr<SpaceThemeGlyphButton> next_ = nullptr;
+  std::vector<raw_ptr<SpaceThemeSwatch>> swatches_;
+  size_t page_ = 0;
+  std::optional<SkColor> selected_;
+};
