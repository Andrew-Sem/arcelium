+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(SkColorSetA(SK_ColorBLACK, 0x45));
+  gfx::RectF shadow = bounds;
+  shadow.Offset(0, 1);
+  shadow.Outset(0.5f);
+  canvas->DrawRoundRect(shadow, radius + 0.5f, flags);
+}
