+  constexpr float kMaxAlpha = 0.97f;
+  const float default_alpha = GetDefaultTintAlpha(is_dark);
+  const float intensity = std::clamp(theme.intensity, 0.0f, 1.0f);
+  tint.alpha = intensity <= 0.5f
+                   ? default_alpha * intensity * 2
