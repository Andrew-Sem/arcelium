+bool IsArcEmptyPageUrl(const GURL& url) {
+  return url.is_empty() ||
+         (url.SchemeIs(content::kChromeUIScheme) &&
+          (url.host() == chrome::kChromeUINewTabHost ||
+           url.host() == chrome::kChromeUINewTabPageHost));
+}
+
+bool IsArcEmptyTab(const GURL& visible_url, const GURL& last_committed_url) {
+  return IsArcEmptyPageUrl(visible_url) ||
+         (last_committed_url.is_empty() && visible_url.IsAboutBlank());
+}
+
+bool IsArcEmptyPage(const GURL& visible_url, const GURL& last_committed_url) {
+  return IsArcEmptyTab(visible_url, last_committed_url) ||
+         (!last_committed_url.is_empty() &&
+          IsArcEmptyPageUrl(last_committed_url));
+}
