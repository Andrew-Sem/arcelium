+// How much grain shows, like Arc's: a knob, itself grainy, turned by the
+// pointer.
+class SpaceThemeGrainDial : public views::View {
+  METADATA_HEADER(SpaceThemeGrainDial, views::View)
+
+ public:
+  explicit SpaceThemeGrainDial(base::RepeatingCallback<void(float)> on_changed)
+      : on_changed_(std::move(on_changed)) {
+    GetViewAccessibility().SetRole(ax::mojom::Role::kSlider);
+    GetViewAccessibility().SetName(u"Grain");
+  }
+  SpaceThemeGrainDial(const SpaceThemeGrainDial&) = delete;
+  SpaceThemeGrainDial& operator=(const SpaceThemeGrainDial&) = delete;
+  ~SpaceThemeGrainDial() override = default;
+
+  void SetValue(float value) {
+    if (value_ != value) {
+      value_ = value;
+      GetViewAccessibility().SetValue(
+          base::NumberToString16(std::round(value * 100)) + u"%");
+      SchedulePaint();
+    }
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kControlHeight, kControlHeight);
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const gfx::PointF center = gfx::RectF(GetLocalBounds()).CenterPoint();
+    const float angle = GetAngle();
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+
+    // Dots around, lit up to the marker.
+    constexpr int kTicks = 24;
+    constexpr float kTickRadius = 21;
+    for (int i = 0; i < kTicks; ++i) {
+      float tick = i * 360.0f / kTicks;
+      if (tick > 180) {
+        tick -= 360;
+      }
+      const bool lit = tick >= -kDialSweep && tick <= angle;
+      flags.setColor(GetForeground(this, lit ? 0xC0 : 0x40));
+      const float radians = ToRadians(tick);
+      canvas->DrawCircle(
+          center + gfx::Vector2dF(std::sin(radians) * kTickRadius,
+                                  -std::cos(radians) * kTickRadius),
+          1.5f, flags);
+    }
+
+    // The knob, as grainy as the window.
+    constexpr float kKnobRadius = 15;
+    const bool dark = IsDark(this);
+    flags.setColor(dark ? SkColorSetRGB(0x34, 0x34, 0x38)
+                        : SkColorSetRGB(0xE2, 0xE2, 0xE6));
+    canvas->DrawCircle(center, kKnobRadius, flags);
+    uint32_t seed = 0x9E3779B9u;
+    const SkAlpha grain_alpha = static_cast<SkAlpha>(value_ * 0xB0);
+    for (int i = 0; i < 260; ++i) {
+      seed = seed * 1664525u + 1013904223u;
+      const float x = ((seed >> 8) & 0xFFFF) / 65535.0f * 2 - 1;
+      seed = seed * 1664525u + 1013904223u;
+      const float y = ((seed >> 8) & 0xFFFF) / 65535.0f * 2 - 1;
+      if (x * x + y * y > 0.9f) {
+        continue;
+      }
+      flags.setColor(SkColorSetA((seed >> 4) & 1 ? SK_ColorWHITE : SK_ColorBLACK,
+                                 grain_alpha));
+      canvas->DrawCircle(center + gfx::ScaleVector2d(gfx::Vector2dF(x, y),
+                                                     kKnobRadius),
+                         0.6f, flags);
+    }
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(1);
+    flags.setColor(GetForeground(this, 0x1A));
+    canvas->DrawCircle(center, kKnobRadius - 0.5f, flags);
+
+    // The marker, on the ring of dots.
+    const float radians = ToRadians(angle);
+    const gfx::Vector2dF direction(std::sin(radians), -std::cos(radians));
+    flags.setStrokeWidth(3.5f);
+    flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+    flags.setColor(SkColorSetA(SK_ColorBLACK, 0x45));
+    const gfx::Vector2dF shadow(0, 1);
+    canvas->DrawLine(center + gfx::ScaleVector2d(direction, 18) + shadow,
+                     center + gfx::ScaleVector2d(direction, 23.5f) + shadow,
+                     flags);
+    // White, like Arc's, but dark against light backgrounds.
+    flags.setColor(dark ? SK_ColorWHITE : GetForeground(this, 0xE6));
+    canvas->DrawLine(center + gfx::ScaleVector2d(direction, 18),
+                     center + gfx::ScaleVector2d(direction, 23.5f), flags);
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (!event.IsOnlyLeftMouseButton()) {
+      return false;
+    }
+    SetFromPoint(gfx::PointF(event.location()));
+    return true;
+  }
+
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    SetFromPoint(gfx::PointF(event.location()));
+    return true;
+  }
+
+ private:
+  float GetAngle() const { return -kDialSweep + 2 * kDialSweep * value_; }
+
+  void SetFromPoint(const gfx::PointF& point) {
+    const gfx::Vector2dF offset =
+        point - gfx::RectF(GetLocalBounds()).CenterPoint();
+    if (offset.Length() < 4) {
+      return;
+    }
+    // Past either end, the end nearer.
+    const float angle = std::clamp(AngleOf(offset), -kDialSweep, kDialSweep);
+    const float value = (angle + kDialSweep) / (2 * kDialSweep);
+    if (value != value_) {
+      on_changed_.Run(value);
+    }
+  }
+
+  const base::RepeatingCallback<void(float)> on_changed_;
+  float value_ = -1;
+};
