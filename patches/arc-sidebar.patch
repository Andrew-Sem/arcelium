+// static
+base::CallbackListSubscription SpacesController::RegisterOnAnyChanged(
+    base::RepeatingCallback<void(BrowserWindowInterface*)> callback) {
+  return GetAnyChangedCallbacks().Add(std::move(callback));
+}
+
+SpacesController::SpacesController(BrowserWindowInterface* browser)
+    : browser_(browser) {
+  // A new window starts with the spaces of the last one used, so that tabs
+  // dragged between them keep their space.
+  if (ProfileBrowserCollection* const collection =
+          ProfileBrowserCollection::GetForProfile(browser_->GetProfile())) {
+    collection->ForEach(
+        [this](BrowserWindowInterface* other) {
+          if (other == browser_.get()) {
+            return true;
+          }
+          SpacesController* const controller =
+              ControllerRegistry::Get().Find(other);
+          if (!controller) {
+            return true;
+          }
+          spaces_ = controller->spaces_;
+          active_space_id_ = controller->active_space_id_;
+          return false;
+        },
+        BrowserCollection::Order::kActivation);
+  }
+  pref_change_registrar_.Init(browser_->GetProfile()->GetPrefs());
+  pref_change_registrar_.AddMultiple(
+      {prefs::kHeliumLayout, prefs::kHeliumZenMode,
+       prefs::kHeliumSidebarAddressBar},
+      base::BindRepeating(&SpacesController::OnModeChanged,
+                          base::Unretained(this)));
+  enabled_ = IsEnabledForProfile(browser_->GetProfile());
+  EnsureSpace();
+  browser_->GetTabStripModel()->AddObserver(this);
+  AdoptUnknownTabs();
+  // The space showing is the one of the active tab.
+  if (const tabs::TabInterface* const active_tab =
+          browser_->GetTabStripModel()->GetActiveTab()) {
+    active_space_id_ = GetTabSpace(active_tab);
+  }
+  SaveWindow();
+}
+
+SpacesController::~SpacesController() = default;
+
+const Space* SpacesController::FindSpace(const std::string& id) const {
+  for (const Space& space : spaces_) {
+    if (space.id == id) {
+      return &space;
+    }
+  }
+  return nullptr;
+}
+
+void SpacesController::SwitchTo(const std::string& id) {
+  if (!FindSpace(id)) {
+    return;
+  }
+  if (id == active_space_id_) {
+    ClearPreviewSpace();
+    return;
+  }
+  // Without notifying: activating the space does.
+  preview_space_id_.clear();
+  preview_progress_ = 0;
+  preview_tracking_ = false;
+  TabStripModel* const model = browser_->GetTabStripModel();
+  int most_recent = TabStripModel::kNoTab;
+  base::TimeTicks most_recent_time;
+  for (int i = 0; i < model->count(); ++i) {
+    tabs::TabInterface* const tab = model->GetTabAtIndex(i);
+    // Not one in a collapsed group, which can't be active.
+    if (GetTabSpace(tab) != id || model->IsTabCollapsed(i)) {
+      continue;
+    }
+    const base::TimeTicks time = tab->GetContents()->GetLastActiveTimeTicks();
+    if (most_recent == TabStripModel::kNoTab || time > most_recent_time) {
+      most_recent = i;
+      most_recent_time = time;
+    }
+  }
+  SetActiveSpace(id);
+  if (most_recent != TabStripModel::kNoTab) {
+    model->ActivateTabAt(most_recent,
+                         TabStripUserGestureDetails(
+                             TabStripUserGestureDetails::GestureType::kOther));
+  } else {
+    OpenEmptyTab(id);
+  }
+}
+
+void SpacesController::SwitchBy(int delta) {
+  for (size_t i = 0; i < spaces_.size(); ++i) {
+    if (spaces_[i].id != active_space_id_) {
+      continue;
+    }
+    const int target = static_cast<int>(i) + delta;
+    if (target >= 0 && target < static_cast<int>(spaces_.size())) {
+      SwitchTo(spaces_[static_cast<size_t>(target)].id);
+    }
+    return;
+  }
+}
+
+std::string SpacesController::CreateSpace() {
+  Space space;
+  space.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  space.icon_id = PickSpaceIcon(spaces_);
+  spaces_.push_back(space);
+  KeepSpacesAcrossRestarts(browser_->GetProfile());
+  SaveWindow();
+  SwitchTo(space.id);
+  return space.id;
+}
+
+std::string SpacesController::GetNewSpaceIcon() const {
+  return PickSpaceIcon(spaces_);
+}
+
+void SpacesController::SetSpaceName(const std::string& id,
+                                    const std::u16string& name) {
+  for (Space& space : spaces_) {
+    if (space.id == id) {
+      base::TrimWhitespace(name, base::TRIM_ALL, &space.name);
+      KeepSpacesAcrossRestarts(browser_->GetProfile());
+      SaveWindow();
+      NotifyChanged();
+      return;
+    }
+  }
+}
+
+void SpacesController::SetSpaceIcon(const std::string& id,
+                                    const std::string& icon_id) {
+  if (!FindSpaceIcon(icon_id)) {
+    return;
+  }
+  for (Space& space : spaces_) {
+    if (space.id == id && space.icon_id != icon_id) {
+      space.icon_id = icon_id;
+      SaveWindow();
+      NotifyChanged();
+      return;
+    }
+  }
+}
+
+void SpacesController::SetSpaceTheme(const std::string& id,
+                                     SpaceTheme theme,
+                                     bool save) {
+  theme = NormalizeTheme(std::move(theme));
+  for (Space& space : spaces_) {
+    if (space.id != id) {
+      continue;
+    }
+    const bool changed = space.theme != theme || theme_previewing_ == save;
+    space.theme = std::move(theme);
+    theme_previewing_ = !save;
+    if (save) {
+      SaveWindow();
+    }
+    if (changed) {
+      NotifyChanged();
+    }
+    return;
+  }
+}
+
+void SpacesController::SetSpaceIsolated(const std::string& id,
+                                        bool isolated) {
+  for (Space& space : spaces_) {
+    if (space.id == id && space.isolated != isolated) {
+      space.isolated = isolated;
+      SaveWindow();
+      NotifyChanged();
+      FixTabPartitionsSoon();
+      return;
+    }
+  }
+}
+
+content::StoragePartitionConfig SpacesController::GetSpacePartition(
+    const std::string& id) const {
+  Profile* const profile = browser_->GetProfile();
+  const Space* const space = FindSpace(id);
+  if (!space || !space->isolated) {
+    return content::StoragePartitionConfig::CreateDefault(profile);
+  }
+  return content::StoragePartitionConfig::Create(
+      profile, kSpacePartitionDomain, space->id, /*in_memory=*/false);
+}
+
+void SpacesController::CloseSpace(const std::string& id) {
+  if (!CanCloseSpace()) {
+    return;
+  }
+  const auto it = std::ranges::find(spaces_, id, &Space::id);
+  if (it == spaces_.end()) {
+    return;
+  }
+  if (id == active_space_id_) {
+    SwitchTo(std::next(it) != spaces_.end() ? std::next(it)->id
+                                            : std::prev(it)->id);
+  }
+  TabStripModel* const model = browser_->GetTabStripModel();
+  std::vector<tabs::TabInterface*> closing;
+  for (int i = model->count() - 1; i >= 0; --i) {
+    tabs::TabInterface* const tab = model->GetTabAtIndex(i);
+    if (GetTabSpace(tab) == id) {
+      closing.push_back(tab);
+    }
+  }
+  for (tabs::TabInterface* const tab : closing) {
+    if (const int index = model->GetIndexOfTab(tab);
+        index != TabStripModel::kNoTab) {
+      model->CloseWebContentsAt(
+          index, TabCloseTypes::CLOSE_USER_GESTURE |
+                     TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+    }
+  }
+  if (id == preview_space_id_) {
+    ClearPreviewSpace();
+  }
+  std::erase_if(spaces_, [&id](const Space& space) { return space.id == id; });
+  // Tabs that didn't close yet, asking whether to leave their page.
+  AdoptUnknownTabs();
+  SaveWindow();
+  NotifyChanged();
+}
+
+void SpacesController::MoveTabToSpace(tabs::TabInterface* tab,
+                                      const std::string& id) {
+  if (!FindSpace(id) || GetTabSpace(tab) == id) {
+    return;
+  }
+  TabStripModel* const model = browser_->GetTabStripModel();
+  std::vector<tabs::TabInterface*> moving = {tab};
+  if (const std::optional<tab_groups::TabGroupId> group = tab->GetGroup();
+      group && model->group_model()) {
+    moving.clear();
+    const gfx::Range range =
+        model->group_model()->GetTabGroup(*group)->ListTabs();
+    for (size_t i = range.start(); i < range.end(); ++i) {
+      moving.push_back(model->GetTabAtIndex(static_cast<int>(i)));
+    }
+  } else if (const std::optional<split_tabs::SplitTabId> split =
+                 tab->GetSplit()) {
+    moving = model->GetSplitData(*split)->ListTabs();
+  }
+  const bool moves_active_tab =
+      std::ranges::contains(moving, model->GetActiveTab());
+  for (tabs::TabInterface* const moving_tab : moving) {
+    SetTabSpace(moving_tab->GetContents(), id);
+  }
+  FixTabPartitionsSoon();
+  if (moves_active_tab) {
+    SetActiveSpace(id);
+  } else {
+    NotifyChanged();
+  }
+}
+
+const std::string& SpacesController::GetTabSpace(
+    const tabs::TabInterface* tab) const {
+  const TabSpaceData* const data = GetTabSpaceData(tab->GetContents());
+  if (data && FindSpace(data->space_id)) {
+    return data->space_id;
+  }
+  return spaces_.front().id;
+}
+
+bool SpacesController::IsTabShown(const tabs::TabInterface* tab) const {
+  return !IsEnabled() || GetTabSpace(tab) == shown_space_id();
+}
+
+void SpacesController::SetPreviewSpace(const std::string& id,
+                                       float progress,
+                                       bool tracking) {
+  if (!enabled_ || !FindSpace(id) || id == active_space_id_) {
+    ClearPreviewSpace();
+    return;
+  }
+  progress = std::clamp(progress, 0.0f, 1.0f);
+  if (id != preview_space_id_) {
+    preview_space_id_ = id;
+    preview_progress_ = progress;
+    preview_tracking_ = tracking;
+    NotifyChanged();
+    return;
+  }
+  if (progress == preview_progress_ && tracking == preview_tracking_) {
+    return;
+  }
+  preview_progress_ = progress;
+  preview_tracking_ = tracking;
+  // Only the frame tint changes.
+  GetAnyChangedCallbacks().Notify(browser_);
+}
+
+void SpacesController::ClearPreviewSpace() {
+  if (preview_space_id_.empty()) {
+    return;
+  }
+  preview_space_id_.clear();
+  preview_progress_ = 0;
+  preview_tracking_ = false;
+  NotifyChanged();
+}
+
+FrameTint SpacesController::GetFrameTint() const {
+  FrameTint tint;
+  if (const Space* const space = FindSpace(active_space_id_)) {
+    tint.theme = space->theme;
+  }
+  // A picker's changes show at once, without fading.
+  tint.tracking = theme_previewing_;
+  if (const Space* const preview = FindSpace(preview_space_id_)) {
+    tint.preview_theme = preview->theme;
+    tint.progress = preview_progress_;
+    tint.tracking = preview_tracking_ || theme_previewing_;
+  }
+  return tint;
+}
+
+base::CallbackListSubscription SpacesController::RegisterOnChanged(
+    base::RepeatingClosure callback) {
+  return on_changed_callbacks_.Add(std::move(callback));
+}
+
+std::string SpacesController::SerializeForSession() const {
+  base::ListValue spaces;
+  for (const Space& space : spaces_) {
+    base::DictValue entry;
+    entry.Set("id", space.id);
+    entry.Set("name", base::UTF16ToUTF8(space.name));
+    entry.Set("icon", space.icon_id);
+    const SpaceTheme& theme = space.theme;
+    if (!theme.colors.empty()) {
+      // Also as the single color earlier versions read.
+      entry.Set("color", ColorToString(theme.colors.front()));
+      base::ListValue colors;
+      for (SkColor color : theme.colors) {
+        colors.Append(ColorToString(color));
+      }
+      entry.Set("colors", std::move(colors));
+    }
+    if (theme.mode != SpaceTheme::Mode::kSystem) {
+      entry.Set("mode",
+                theme.mode == SpaceTheme::Mode::kLight ? "light" : "dark");
+    }
+    if (theme.intensity != SpaceTheme::kDefaultIntensity) {
+      entry.Set("intensity", theme.intensity);
+    }
+    if (theme.grain != SpaceTheme::kDefaultGrain) {
+      entry.Set("grain", theme.grain);
+    }
+    if (space.isolated) {
+      entry.Set("isolated", true);
+    }
+    spaces.Append(std::move(entry));
+  }
+  base::DictValue root;
+  root.Set("active", active_space_id_);
+  root.Set("spaces", std::move(spaces));
+  return base::WriteJson(root).value_or(std::string());
+}
+
+void SpacesController::RestoreFromSession(const std::string& data) {
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(data, base::JSON_PARSE_RFC);
+  const base::ListValue* const entries =
+      root ? root->FindList("spaces") : nullptr;
+  if (!entries) {
+    return;
+  }
+  std::vector<Space> spaces;
+  for (const base::Value& value : *entries) {
+    const base::DictValue* const entry = value.GetIfDict();
+    const std::string* const id = entry ? entry->FindString("id") : nullptr;
+    if (!id || id->empty()) {
+      continue;
+    }
+    Space space;
+    space.id = *id;
+    if (const std::string* const name = entry->FindString("name")) {
+      space.name = base::UTF8ToUTF16(*name);
+    }
+    if (const std::string* const icon_id = entry->FindString("icon")) {
+      space.icon_id = *icon_id;
+    }
+    SpaceTheme& theme = space.theme;
+    if (const base::ListValue* const colors = entry->FindList("colors")) {
+      for (const base::Value& color : *colors) {
+        if (const std::string* const text = color.GetIfString()) {
+          if (std::optional<SkColor> parsed = ColorFromString(*text)) {
+            theme.colors.push_back(*parsed);
+          }
+        }
+      }
+    } else if (const std::string* const color = entry->FindString("color")) {
+      if (std::optional<SkColor> parsed = ColorFromString(*color)) {
+        theme.colors.push_back(*parsed);
+      }
+    }
+    if (const std::string* const mode = entry->FindString("mode")) {
+      theme.mode = *mode == "light"  ? SpaceTheme::Mode::kLight
+                   : *mode == "dark" ? SpaceTheme::Mode::kDark
+                                     : SpaceTheme::Mode::kSystem;
+    }
+    theme.intensity = static_cast<float>(
+        entry->FindDouble("intensity").value_or(theme.intensity));
+    theme.grain =
+        static_cast<float>(entry->FindDouble("grain").value_or(theme.grain));
+    theme = NormalizeTheme(std::move(theme));
+    space.isolated = entry->FindBool("isolated").value_or(false);
+    spaces.push_back(std::move(space));
+  }
+  if (spaces.empty()) {
+    return;
+  }
+  EnsureSpaceIcons(spaces);
+  spaces_ = std::move(spaces);
+  const std::string* const active = root->FindString("active");
+  active_space_id_ =
+      active && FindSpace(*active) ? *active : spaces_.front().id;
+  AdoptUnknownTabs();
+  SaveWindow();
+  NotifyChanged();
+}
+
+void SpacesController::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (change.type() == TabStripModelChange::kInserted) {
+    for (const TabStripModelChange::ContentsWithIndex& inserted :
+         change.GetInsert()->contents) {
+      TabSpaceData* const data = GetTabSpaceData(inserted.contents);
+      if (data && data->restored && FindSpace(data->space_id)) {
+        SetTabSpace(inserted.contents, data->space_id);
+      } else {
+        SetTabSpace(inserted.contents, pending_space_id_.empty()
+                                           ? active_space_id_
+                                           : pending_space_id_);
+      }
+    }
+  } else if (change.type() == TabStripModelChange::kReplaced) {
+    // The new contents of a tab take its space.
+    const TabStripModelChange::Replace* const replace = change.GetReplace();
+    if (const TabSpaceData* const data =
+            GetTabSpaceData(replace->old_contents)) {
+      SetTabSpace(replace->new_contents, data->space_id);
+    }
+  }
+  if (change.type() == TabStripModelChange::kInserted ||
+      change.type() == TabStripModelChange::kReplaced) {
+    FixTabPartitionsSoon();
+  }
+
+  // Without the sidebar, tabs only keep their space.
+  if (!enabled_ || !selection.active_tab_changed() || !selection.new_tab ||
+      tab_strip_model->closing_all()) {
+    return;
+  }
+  const std::string& space = GetTabSpace(selection.new_tab);
+  if (space == active_space_id_) {
+    return;
+  }
+  if (change.type() == TabStripModelChange::kRemoved &&
+      !SpaceHasActivatableTabs(active_space_id_)) {
+    // The last tab of the space showing closed: the space keeps showing, with
+    // an empty page. Not from within the tab strip's own notification.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&SpacesController::OpenEmptyTabIfNeeded,
+                                  weak_factory_.GetWeakPtr(),
+                                  active_space_id_));
+    return;
+  }
+  SetActiveSpace(space);
+}
+
+void SpacesController::EnsureSpace() {
+  if (spaces_.empty()) {
+    Space space;
+    space.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    spaces_.push_back(std::move(space));
+  }
+  EnsureSpaceIcons(spaces_);
+  if (!FindSpace(active_space_id_)) {
+    active_space_id_ = spaces_.front().id;
+  }
+}
+
+void SpacesController::OnModeChanged() {
+  const bool enabled = IsEnabledForProfile(browser_->GetProfile());
+  if (enabled == enabled_) {
+    return;
+  }
+  enabled_ = enabled;
+  // The space of the active tab shows again.
+  if (enabled_) {
+    if (const tabs::TabInterface* const active_tab =
+            browser_->GetTabStripModel()->GetActiveTab()) {
+      active_space_id_ = GetTabSpace(active_tab);
+      SaveWindow();
+    }
+  }
+  NotifyChanged();
+}
+
+bool SpacesController::SpaceHasActivatableTabs(const std::string& id) const {
+  TabStripModel* const model = browser_->GetTabStripModel();
+  for (int i = 0; i < model->count(); ++i) {
+    if (GetTabSpace(model->GetTabAtIndex(i)) == id &&
+        !model->IsTabCollapsed(i)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void SpacesController::AdoptUnknownTabs() {
+  TabStripModel* const model = browser_->GetTabStripModel();
+  for (int i = 0; i < model->count(); ++i) {
+    content::WebContents* const contents = model->GetWebContentsAt(i);
+    const TabSpaceData* const data = GetTabSpaceData(contents);
+    if (!data || !FindSpace(data->space_id)) {
+      SetTabSpace(contents, active_space_id_);
+    }
+  }
+  FixTabPartitionsSoon();
+}
+
+void SpacesController::SetTabSpace(content::WebContents* contents,
+                                   const std::string& id) {
+  TabSpaceData& data = GetOrCreateTabSpaceData(contents);
+  if (data.space_id != id) {
+    ++tab_spaces_version_;
+  }
+  data.space_id = id;
+  data.restored = false;
+  if (SessionService* const session_service =
+          SessionServiceFactory::GetForProfile(browser_->GetProfile())) {
+    session_service->AddTabExtraData(
+        browser_->GetSessionID(),
+        sessions::SessionTabHelper::IdForTab(contents), kTabSpaceKey, id);
+  }
+}
+
+void SpacesController::OpenEmptyTab(const std::string& id) {
+  if (!enabled_ || !FindSpace(id) || browser_->IsDeleteScheduled()) {
+    return;
+  }
+  pending_space_id_ = id;
+  chrome::AddTabAt(browser_, GURL(), -1, /*foreground=*/true);
+  pending_space_id_.clear();
+}
+
+void SpacesController::OpenEmptyTabIfNeeded(const std::string& id) {
+  if (TabDragController::IsActive()) {
+    constexpr base::TimeDelta kRetryDelay = base::Milliseconds(200);
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&SpacesController::OpenEmptyTabIfNeeded,
+                       weak_factory_.GetWeakPtr(), id),
+        kRetryDelay);
+    return;
+  }
+  // Unless another space showed meanwhile.
+  if (id == active_space_id_ && !SpaceHasActivatableTabs(id)) {
+    OpenEmptyTab(id);
+  }
+}
+
+void SpacesController::SetActiveSpace(const std::string& id) {
+  if (id == active_space_id_) {
+    return;
+  }
+  active_space_id_ = id;
+  preview_space_id_.clear();
+  preview_progress_ = 0;
+  preview_tracking_ = false;
+  SaveWindow();
+  NotifyChanged();
+}
+
+void SpacesController::FixTabPartitionsSoon() {
+  if (fixing_tab_partitions_) {
+    return;
+  }
+  fixing_tab_partitions_ = true;
+  // Not from within the tab strip's own notification.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&SpacesController::FixTabPartitions,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void SpacesController::FixTabPartitions() {
+  if (TabDragController::IsActive()) {
+    constexpr base::TimeDelta kRetryDelay = base::Milliseconds(200);
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&SpacesController::FixTabPartitions,
+                       weak_factory_.GetWeakPtr()),
+        kRetryDelay);
+    return;
+  }
+  fixing_tab_partitions_ = false;
+  if (browser_->IsDeleteScheduled()) {
+    return;
+  }
+  Profile* const profile = browser_->GetProfile();
+  TabStripModel* const model = browser_->GetTabStripModel();
+  for (int i = 0; i < model->count(); ++i) {
+    content::WebContents* const contents = model->GetWebContentsAt(i);
+    const content::StoragePartitionConfig partition =
+        GetSpacePartition(GetTabSpace(model->GetTabAtIndex(i)));
+    if (GetContentsPartition(contents) == partition) {
+      continue;
+    }
+    std::unique_ptr<content::WebContents> new_contents =
+        CreateContentsInPartition(profile, contents, partition);
+    // A page that can't be in the partition stays where it is, rather than
+    // moving again with every check.
+    if (GetContentsPartition(new_contents.get()) != partition) {
+      continue;
+    }
+    model->DiscardWebContents(contents, std::move(new_contents));
+  }
+}
+
+void SpacesController::SaveWindow() {
+  if (SessionService* const session_service =
+          SessionServiceFactory::GetForProfile(browser_->GetProfile())) {
+    session_service->AddWindowExtraData(
+        browser_->GetSessionID(), kWindowSpacesKey, SerializeForSession());
+  }
+}
+
+void SpacesController::NotifyChanged() {
+  on_changed_callbacks_.Notify();
+  GetAnyChangedCallbacks().Notify(browser_);
+}
+
+bool IsTabShown(const tabs::TabInterface* tab) {
+  if (!tab) {
+    return true;
+  }
+  const SpacesController* const controller = SpacesController::From(
+      const_cast<BrowserWindowInterface*>(tab->GetBrowserWindowInterface()),
+      /*create=*/false);
+  return !controller || controller->IsTabShown(tab);
+}
+
+bool IsTabListed(const tabs::TabInterface* tab) {
+  if (!IsTabShown(tab)) {
+    return false;
+  }
+  const SpacesController* const controller = SpacesController::From(
+      const_cast<BrowserWindowInterface*>(tab->GetBrowserWindowInterface()),
+      /*create=*/false);
+  content::WebContents* const contents = tab->GetContents();
+  return !controller || !controller->IsEnabled() || !contents ||
+         !IsArcEmptyTab(contents->GetVisibleURL(),
+                        contents->GetLastCommittedURL());
+}
+
+bool AreTabsInSameSpace(const tabs::TabInterface* tab,
+                        const tabs::TabInterface* reference) {
+  if (!tab || !reference) {
+    return true;
+  }
+  const SpacesController* const controller = SpacesController::From(
+      const_cast<BrowserWindowInterface*>(
+          reference->GetBrowserWindowInterface()),
+      /*create=*/false);
+  return !controller || !controller->IsEnabled() ||
+         controller->GetTabSpace(tab) == controller->GetTabSpace(reference);
+}
+
+void RestoreTabSpace(content::WebContents* contents,
+                     const std::map<std::string, std::string>& extra_data) {
+  const auto it = extra_data.find(kTabSpaceKey);
+  if (it == extra_data.end() || it->second.empty()) {
+    return;
+  }
+  TabSpaceData& data = GetOrCreateTabSpaceData(contents);
+  data.space_id = it->second;
+  data.restored = true;
+}
+
+void RestoreWindowSpaces(BrowserWindowInterface* browser,
+                         const std::map<std::string, std::string>& extra_data) {
+  const auto it = extra_data.find(kWindowSpacesKey);
+  if (it == extra_data.end()) {
+    return;
+  }
+  if (SpacesController* const controller = SpacesController::From(browser)) {
+    controller->RestoreFromSession(it->second);
+  }
+}
+
+std::string GetTabSpaceForSession(const content::WebContents* contents) {
+  const TabSpaceData* const data = GetTabSpaceData(contents);
+  return data ? data->space_id : std::string();
+}
+
+std::string GetWindowSpacesForSession(BrowserWindowInterface* browser) {
+  const SpacesController* const controller =
+      SpacesController::From(browser, /*create=*/false);
+  return controller ? controller->SerializeForSession() : std::string();
+}
+
+scoped_refptr<content::SiteInstance> GetSiteInstanceForNewTab(
+    BrowserWindowInterface* browser,
+    const GURL& url) {
+  const SpacesController* const controller =
+      SpacesController::From(browser, /*create=*/false);
+  if (!controller) {
+    return nullptr;
+  }
+  return CreateSiteInstance(
+      browser->GetProfile(), url,
+      controller->GetSpacePartition(controller->new_tab_space_id()));
+}
+
+scoped_refptr<content::SiteInstance> GetSiteInstanceForRestoredTab(
+    BrowserWindowInterface* browser,
+    const std::map<std::string, std::string>& extra_data) {
+  const SpacesController* const controller =
+      SpacesController::From(browser, /*create=*/false);
+  const auto it = extra_data.find(kTabSpaceKey);
+  if (!controller || it == extra_data.end() ||
+      !controller->FindSpace(it->second)) {
+    return nullptr;
+  }
+  return CreateSiteInstance(browser->GetProfile(), GURL(),
+                            controller->GetSpacePartition(it->second));
+}
+
+FrameTint GetFrameTint(BrowserWindowInterface* browser) {
+  if (IsLittleWindow(browser)) {
+    FrameTint tint;
+    if (BrowserWindowInterface* const target = GetLittleWindowTarget(browser)) {
+      tint.theme = GetFrameTint(target).theme;
+    }
+    return tint;
+  }
+  const SpacesController* const controller =
+      SpacesController::From(browser, /*create=*/false);
+  if (!controller || !controller->IsEnabled()) {
+    return FrameTint();
+  }
+  return controller->GetFrameTint();
+}
+
