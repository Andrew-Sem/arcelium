+// Pins or unpins the dragged tabs, keeping their order, and splits whole, as
+// the drag takes all of a split's tabs.
+void SetDraggedTabsPinned(TabStripModel& tab_strip_model,
+                          const DragSessionData& drag_session_data,
+                          bool pinned) {
+  std::vector<int> indices;
+  bool has_split = false;
+  for (const TabDragData& tab_drag_data : drag_session_data.tab_drag_data_) {
+    if (!tab_drag_data.contents) {
+      continue;
+    }
+    const int index =
+        tab_strip_model.GetIndexOfWebContents(tab_drag_data.contents);
+    if (index != TabStripModel::kNoTab &&
+        tab_strip_model.IsTabPinned(index) != pinned) {
+      indices.push_back(index);
+      has_split |= tab_strip_model.GetTabAtIndex(index)->IsSplit();
+    }
+  }
+  if (indices.empty()) {
+    return;
+  }
+  std::ranges::sort(indices);
+  if (has_split) {
+    // As the tabs' context menu does, which moves splits whole, for the tabs
+    // the drag selects: it pins them unless all are, as dragged out.
+    tab_strip_model.ExecuteContextMenuCommand(
+        indices.front(), TabStripModel::CommandTogglePinned);
+    return;
+  }
+  // Pinning moves a tab to the end of the pinned tabs and unpinning to the
+  // start of the unpinned ones, so pinning front to back and unpinning back to
+  // front keeps both the tabs' order and the indices still to process.
+  if (!pinned) {
+    std::ranges::reverse(indices);
+  }
+  for (const int index : indices) {
+    tab_strip_model.SetTabPinned(index, pinned);
+  }
+}
