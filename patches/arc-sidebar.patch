+                                 gfx::ShadowValue(
+                                     gfx::Vector2d(), 18,
+                                     SkColorSetA(glow_color, 0x4D))}
+             : gfx::ShadowValues{
+                   gfx::ShadowValue(gfx::Vector2d(-1, 1), 12,
+                                    SkColorSetA(SK_ColorBLACK, 0x0D)),
+                   gfx::ShadowValue(gfx::Vector2d(-2, 3), 24,
+                                    SkColorSetA(SK_ColorBLACK, 0x18))}));
+    canvas->DrawPath(path, flags);
+  }
+
+  // The empty window is a slightly lighter shade of the sidebar, like Arc's:
+  // where a page shows nothing, hidden as empty or before it first paints, see
+  // ContentsWebView::UpdateBackgroundColor(), and is opaque over this else.
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(SkColorSetA(SK_ColorWHITE, 0x0D));
