+ui::ColorProviderKey::ColorMode BrowserNativeWidgetMac::GetAutoColorMode(
+    const arc_spaces::SpaceTheme& theme) {
+  using ColorMode = ui::ColorProviderKey::ColorMode;
+  // The window's color mode without spaces.
+  const ColorMode system_mode =
+      ThemeServiceFactory::GetForProfile(browser_view_->GetProfile())
+              ->BrowserUsesDarkColors()
+          ? ColorMode::kDark
+          : ColorMode::kLight;
+  // Roughly the frame's luminance in `mode`, the material taken as gray, see
+  // the little window's header in ToolbarView.
+  const auto get_luminance = [&](ColorMode mode) {
+    const helium::FrameMaterialTint tint =
+        helium::GetFrameMaterialTint(theme, mode, SK_ColorTRANSPARENT);
+    return color_utils::GetRelativeLuminance(color_utils::AlphaBlend(
+        tint.GetAverageColor(),
+        mode == ColorMode::kDark ? SkColorSetRGB(0x1E, 0x1E, 0x1E)
+                                 : SkColorSetRGB(0xEC, 0xEC, 0xEC),
+        tint.alpha));
+  };
+  // Leaving the system's only for colors far off it, so that mid tones don't
+  // flip.
+  constexpr float kLightLuminance = 0.25f;
+  constexpr float kDarkLuminance = 0.15f;
+  if (system_mode == ColorMode::kDark) {
+    return get_luminance(ColorMode::kDark) > kLightLuminance ? ColorMode::kLight
+                                                             : ColorMode::kDark;
+  }
+  return get_luminance(ColorMode::kLight) < kDarkLuminance ? ColorMode::kDark
+                                                           : ColorMode::kLight;
+}
+
+void BrowserNativeWidgetMac::UpdateSpaceColorMode() {
+  views::Widget* const widget = GetWidget();
+  if (!widget || !browser_view_) {
+    return;
+  }
+  std::optional<ui::ColorProviderKey::ColorMode> color_mode;
+  const arc_spaces::SpaceTheme theme =
+      arc_spaces::GetFrameTint(browser_view_->browser()).theme;
+  switch (theme.mode) {
+    case arc_spaces::SpaceTheme::Mode::kSystem:
+      // Like Arc's, light or dark by how the colors come out over the frame
+      // material, keeping text readable.
+      if (!theme.colors.empty() &&
+          helium::ShouldUseNativeFrameMaterials(browser_view_)) {
+        color_mode = GetAutoColorMode(theme);
+      }
+      break;
+    case arc_spaces::SpaceTheme::Mode::kLight:
+      color_mode = ui::ColorProviderKey::ColorMode::kLight;
+      break;
+    case arc_spaces::SpaceTheme::Mode::kDark:
+      color_mode = ui::ColorProviderKey::ColorMode::kDark;
+      break;
+  }
+  // Leaving alone the color modes of other windows, such as picture in
+  // picture ones.
+  if (!color_mode && !has_space_color_mode_) {
+    return;
+  }
+  has_space_color_mode_ = color_mode.has_value();
+  if (widget->color_mode_override() == color_mode) {
+    return;
+  }
+  widget->SetColorModeOverride(color_mode);
+  // Bubbles and dialogs on the window take it too, but only re-theme with it.
+  for (views::Widget* owned :
+       views::Widget::GetAllOwnedWidgets(widget->GetNativeView())) {
+    owned->ThemeChanged();
+  }
