+// static
+void ArcSpacesBarView::ShowSpaceEditor(BrowserWindowInterface* browser,
+                                       const std::string& space_id) {
+  arc_spaces::SpacesController* const controller =
+      arc_spaces::SpacesController::From(browser, /*create=*/false);
+  if (!controller) {
+    return;
+  }
+  const bool is_new = space_id.empty();
+  // A new space opens only once saved, like Arc's.
+  arc_spaces::Space new_space;
+  new_space.icon_id = controller->GetNewSpaceIcon();
+  const arc_spaces::Space* const space =
+      is_new ? &new_space : controller->FindSpace(space_id);
+  if (!space) {
+    return;
+  }
+  auto icon_picker = std::make_unique<SpaceIconPicker>(space->icon_id);
+  SpaceIconPicker* const icon_picker_ptr = icon_picker.get();
+  ui::DialogModel::Builder builder;
+  builder.SetInternalName("ArcSpaceEditor")
+      .SetTitle(is_new ? u"New Space" : u"Edit Space")
+      .AddTextfield(
+          kSpaceNameFieldId, u"Name", space->name,
+          ui::DialogModelTextfield::Params().SetAccessibleName(u"Space name"))
+      .AddCustomField(
+          std::make_unique<views::BubbleDialogModelHost::CustomView>(
+              std::move(icon_picker),
+              views::BubbleDialogModelHost::FieldType::kControl))
+      .AddCheckbox(kSpaceIsolatedFieldId,
+                   ui::DialogModelLabel(u"Separate logins and cookies"),
+                   ui::DialogModelCheckbox::Params().SetIsChecked(
+                       space->isolated))
+      .AddOkButton(base::BindOnce(&SaveSpace, browser, space_id,
+                                  builder.model(),
+                                  base::Unretained(icon_picker_ptr)),
+                   ui::DialogModel::Button::Params().SetLabel(u"Save"))
+      .AddCancelButton(base::DoNothing())
+      .SetInitiallyFocusedField(kSpaceNameFieldId);
+  chrome::ShowBrowserModal(browser, builder.Build());
+}
+
+gfx::Size ArcSpacesBarView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  const int count = static_cast<int>(space_buttons_.size());
+  if (count == 0) {
+    return gfx::Size();
+  }
+  return gfx::Size(count * kButtonSize + (count - 1) * kButtonSpacing +
+                       kNewSpaceButtonGap + kButtonSize,
+                   kButtonSize);
+}
+
+void ArcSpacesBarView::Layout(PassKey) {
+  if (space_buttons_.empty()) {
+    return;
+  }
+  // The new space button at the end, the spaces centered in the sidebar, like
+  // Arc's, as long as they keep clear of the button. Those that don't fit
+  // scroll, see ScrollSpacesBy().
+  const int y = std::max(0, (height() - kButtonSize) / 2);
+  const int new_space_x = std::max(0, width() - kButtonSize);
+  new_space_button_->SetBounds(new_space_x, y, kButtonSize, kButtonSize);
+  const int count = static_cast<int>(space_buttons_.size());
+  const int spaces_width = count * kButtonSize + (count - 1) * kButtonSpacing;
+  const int strip_width = std::max(0, new_space_x - kNewSpaceButtonGap);
+  const int max_offset = std::max(0, spaces_width - strip_width);
+  spaces_scroll_ = max_offset > 0;
+  if (!spaces_scroll_) {
+    // As wide as the spaces, which leaves the room around them to the sidebar.
+    scroll_offset_ = 0;
+    const int sidebar_center =
+        parent() ? parent()->width() / 2 - x() : width() / 2;
+    strip_->SetBounds(std::clamp(sidebar_center - spaces_width / 2, 0,
+                                 strip_width - spaces_width),
+                      y, spaces_width, kButtonSize);
+  } else {
+    strip_->SetBounds(0, y, strip_width, kButtonSize);
+    // Also once the spaces stop fitting, or fit less.
+    if (scroll_to_active_ || strip_width != last_strip_width_) {
+      // The space showing in full, clear of the fades.
+      const auto active =
+          std::ranges::find(button_states_, active_space_id_,
+                            &SpaceButtonState::id);
+      if (active != button_states_.end()) {
+        const int left = static_cast<int>(active - button_states_.begin()) *
+                         (kButtonSize + kButtonSpacing);
+        const int min_offset =
+            left + kButtonSize + kSpacesFadeWidth - strip_width;
+        const int max_visible_offset = left - kSpacesFadeWidth;
+        scroll_offset_ =
+            min_offset > max_visible_offset
+                ? max_visible_offset
+                : std::clamp(scroll_offset_, min_offset, max_visible_offset);
+      }
+    }
+    scroll_offset_ = std::clamp(scroll_offset_, 0, max_offset);
+    scroll_to_active_ = false;
+  }
+  last_strip_width_ = strip_width;
+  spaces_view_->SetBounds(-scroll_offset_, 0, spaces_width, kButtonSize);
+  int button_x = 0;
+  for (views::View* button : space_buttons_) {
+    button->SetBounds(button_x, 0, kButtonSize, kButtonSize);
+    button_x += kButtonSize + kButtonSpacing;
+  }
+
+  // Fade out the edges past which spaces hide.
+  gfx::LinearGradient fade(/*angle=*/0);
+  if (spaces_scroll_ && strip_width > 2 * kSpacesFadeWidth) {
+    const float fade_fraction =
+        static_cast<float>(kSpacesFadeWidth) / strip_width;
+    fade.AddStep(0, scroll_offset_ > 0 ? 0 : 255);
+    fade.AddStep(fade_fraction, 255);
+    fade.AddStep(1 - fade_fraction, 255);
+    fade.AddStep(1, scroll_offset_ < max_offset ? 0 : 255);
+  }
+  strip_->layer()->SetGradientMask(fade);
+}
+
+bool ArcSpacesBarView::IsScrollingSpacesAt(const views::View* target) const {
+  return spaces_scroll_ && strip_->Contains(target);
+}
+
+std::string ArcSpacesBarView::GetSpaceAt(
+    const gfx::Point& point_in_screen) const {
+  if (!IsDrawn() || !strip_->GetBoundsInScreen().Contains(point_in_screen)) {
+    return std::string();
+  }
+  for (size_t i = 0; i < space_buttons_.size(); ++i) {
+    if (space_buttons_[i]->GetBoundsInScreen().Contains(point_in_screen)) {
+      return button_states_[i].id;
+    }
+  }
+  return std::string();
+}
+
+void ArcSpacesBarView::HighlightSpace(const std::string& id) {
+  if (highlighted_space_ == id) {
+    return;
+  }
+  highlighted_space_ = id;
+  for (size_t i = 0; i < space_buttons_.size(); ++i) {
+    static_cast<views::Button*>(space_buttons_[i].get())
+        ->SetHighlighted(!id.empty() && button_states_[i].id == id);
+  }
+}
+
+TabDragTarget* ArcSpacesBarView::GetTabDragTarget(
+    const gfx::Point& point_in_screen) {
+  return GetController() && !GetSpaceAt(point_in_screen).empty()
+             ? drop_target_.get()
+             : nullptr;
+}
+
+bool ArcSpacesBarView::ScrollSpacesBy(float delta) {
+  if (!spaces_scroll_) {
+    return false;
+  }
+  // Content follows the fingers.
+  scroll_offset_ -= base::ClampRound(delta);
+  InvalidateLayout();
+  return true;
+}
+
+bool ArcSpacesBarView::AcceleratorPressed(const ui::Accelerator& accelerator) {
+  arc_spaces::SpacesController* const controller = GetController();
+  // Tab drags keep to their space.
+  if (!controller || TabDragController::IsActive()) {
+    return false;
+  }
+  const size_t index =
+      static_cast<size_t>(accelerator.key_code() - ui::VKEY_1);
+  if (index >= controller->spaces().size()) {
+    return false;
+  }
+  slide_->SlideTo(controller->spaces()[index].id);
+  return true;
+}
+
+void ArcSpacesBarView::VisibilityChanged(views::View* starting_from,
+                                         bool is_visible) {
+  // The sidebar mode turned on or off.
+  ScheduleUpdate();
+}
+
+void ArcSpacesBarView::AddedToWidget() {
+  if (!swipe_handler_) {
+    swipe_handler_ = std::make_unique<SwipeHandler>(this);
+  }
+  if (swipe_handler_host_) {
+    swipe_handler_host_->RemovePreTargetHandler(swipe_handler_.get());
+  }
+  swipe_handler_host_ = GetWidget()->GetRootView();
+  swipe_handler_host_->AddPreTargetHandler(swipe_handler_.get());
+}
+
+void ArcSpacesBarView::RemovedFromWidget() {
+  if (swipe_handler_host_) {
+    swipe_handler_host_->RemovePreTargetHandler(swipe_handler_.get());
+    swipe_handler_host_ = nullptr;
+  }
+}
+
+bool ArcSpacesBarView::DoesIntersectRect(const views::View* target,
+                                         const gfx::Rect& rect) const {
+  return std::ranges::any_of(children(), [&rect](const views::View* child) {
+    return child->GetVisible() && child->bounds().Intersects(rect);
+  });
+}
+
+void ArcSpacesBarView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  const auto it = std::ranges::find(space_buttons_, source);
+  if (it != space_buttons_.end()) {
+    ShowSpaceMenu(
+        button_states_[static_cast<size_t>(it - space_buttons_.begin())].id,
+        point, source_type);
+  }
+}
+
+// static
+ArcSpacesBarView* ArcSpacesBarView::FindForView(views::View* view) {
+  views::View* sidebar = view;
+  while (sidebar && !views::IsViewClass<VerticalTabStripRegionView>(sidebar)) {
+    sidebar = sidebar->parent();
+  }
+  std::vector<views::View*> pending;
+  if (sidebar) {
+    pending.push_back(sidebar);
+  }
+  while (!pending.empty()) {
+    views::View* const candidate = pending.back();
+    pending.pop_back();
+    if (auto* const bar = views::AsViewClass<ArcSpacesBarView>(candidate)) {
+      return bar;
+    }
+    for (views::View* const child : candidate->children()) {
+      pending.push_back(child);
+    }
+  }
+  return nullptr;
+}
+
+void ArcSpacesBarView::ShowSpaceMenu(const std::string& space_id,
+                                     const gfx::Point& point,
+                                     ui::mojom::MenuSourceType source_type) {
+  if (!GetController() || !GetWidget()) {
+    return;
+  }
+  context_menu_space_ = space_id;
+  context_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  context_menu_model_->AddItem(kEditSpace, u"Edit Space…");
+  context_menu_model_->AddItem(kEditTheme, u"Edit Theme…");
+  context_menu_model_->AddItem(kMoveTabToSpace, u"Move Current Tab Here");
+  context_menu_model_->AddItem(kNewSpace, u"New Space");
+  context_menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  context_menu_model_->AddItem(kCloseSpace, u"Close Space");
+  context_menu_runner_ = std::make_unique<views::MenuRunner>(
+      context_menu_model_.get(),
+      views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+  context_menu_runner_->RunMenuAt(GetWidget(), nullptr,
+                                  gfx::Rect(point, gfx::Size()),
+                                  views::MenuAnchorPosition::kTopLeft,
+                                  source_type);
+}
+
+bool ArcSpacesBarView::IsCommandIdEnabled(int command_id) const {
+  const arc_spaces::SpacesController* const controller = GetController();
+  if (!controller) {
+    return false;
+  }
+  switch (command_id) {
+    case kMoveTabToSpace:
+      return context_menu_space_ != controller->active_space_id();
+    case kCloseSpace:
+      return controller->CanCloseSpace();
+    default:
+      return true;
+  }
+}
+
+void ArcSpacesBarView::ExecuteCommand(int command_id, int event_flags) {
+  // Runs once the menu is gone.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<ArcSpacesBarView> bar, int command_id,
+             const std::string& space_id) {
+            arc_spaces::SpacesController* const controller =
+                bar ? bar->GetController() : nullptr;
+            if (!controller || !controller->FindSpace(space_id)) {
+              return;
+            }
+            switch (command_id) {
+              case kEditSpace:
+                ShowSpaceEditor(bar->browser_, space_id);
+                break;
+              case kEditTheme:
+                bar->ShowThemePicker(space_id);
+                break;
+              case kMoveTabToSpace:
+                if (tabs::TabInterface* const tab =
+                        bar->browser_->GetTabStripModel()->GetActiveTab()) {
+                  controller->MoveTabToSpace(tab, space_id);
+                }
+                break;
+              case kNewSpace:
+                bar->CreateSpace();
+                break;
+              case kCloseSpace:
+                controller->CloseSpace(space_id);
+                break;
+            }
+          },
+          weak_factory_.GetWeakPtr(), command_id, context_menu_space_));
+}
+
+void ArcSpacesBarView::ShowThemePicker(const std::string& space_id) {
+  arc_spaces::SpacesController* const controller = GetController();
+  const arc_spaces::Space* const space =
+      controller ? controller->FindSpace(space_id) : nullptr;
+  if (!space || !GetWidget()) {
+    return;
+  }
+  // Over the space's button, like Arc's.
+  views::View* anchor = this;
+  for (size_t i = 0; i < button_states_.size(); ++i) {
+    if (button_states_[i].id == space_id && i < space_buttons_.size()) {
+      anchor = space_buttons_[i];
+    }
+  }
+  theme_bubble_.reset();
+  theme_bubble_delegate_ = std::make_unique<views::BubbleDialogDelegate>(
+      anchor, views::BubbleBorder::BOTTOM_LEFT,
+      views::BubbleBorder::DIALOG_SHADOW, /*autosize=*/true);
+  theme_bubble_delegate_->SetButtons(
+      static_cast<int>(ui::mojom::DialogButton::kNone));
+  theme_bubble_delegate_->SetShowCloseButton(false);
+  theme_bubble_delegate_->set_margins(gfx::Insets(14));
+  theme_bubble_delegate_->set_corner_radius(18);
+  theme_bubble_delegate_->SetAccessibleTitle(u"Space Theme");
+  theme_bubble_delegate_->SetContentsView(std::make_unique<ArcSpaceThemePicker>(
+      controller->GetWeakPtr(), space_id, space->theme));
+  theme_bubble_ = views::BubbleDialogDelegate::CreateBubble(
+      theme_bubble_delegate_.get(),
+      base::BindOnce(
+          [](base::WeakPtr<ArcSpacesBarView> bar,
+             uintptr_t delegate, views::Widget::ClosedReason) {
+            // Not from within the bubble's own closing, and only this bubble,
+            // not one that replaced it. The picker saves the theme as it goes.
+            base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+                FROM_HERE,
+                base::BindOnce(
+                    [](base::WeakPtr<ArcSpacesBarView> bar,
+                       uintptr_t delegate) {
+                      if (bar && reinterpret_cast<uintptr_t>(
+                                     bar->theme_bubble_delegate_.get()) ==
+                                     delegate) {
+                        bar->theme_bubble_.reset();
+                        bar->theme_bubble_delegate_.reset();
+                      }
+                    },
+                    bar, delegate));
+          },
+          weak_factory_.GetWeakPtr(),
+          reinterpret_cast<uintptr_t>(theme_bubble_delegate_.get())));
+  theme_bubble_->Show();
+}
+
+arc_spaces::SpacesController* ArcSpacesBarView::GetController() const {
+  arc_spaces::SpacesController* const controller =
+      arc_spaces::SpacesController::From(browser_);
+  return controller && controller->IsEnabled() ? controller : nullptr;
+}
+
+void ArcSpacesBarView::OnSpacesChanged() {
+  // Laying the tabs out again takes a while, too long for a slide to start, so
+  // only when other tabs show.
+  arc_spaces::SpacesController* const controller = GetController();
+  if (!controller || controller->shown_space_id() != listed_space_id_ ||
+      controller->tab_spaces_version() != listed_tab_spaces_version_) {
+    UpdateTabLists();
+  }
+  ScheduleUpdate();
+}
+
+void ArcSpacesBarView::ScheduleUpdate() {
+  if (update_scheduled_) {
+    return;
+  }
+  update_scheduled_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&ArcSpacesBarView::Update, weak_factory_.GetWeakPtr()));
+}
+
+void ArcSpacesBarView::Update() {
+  update_scheduled_ = false;
+
+  std::vector<SpaceButtonState> states;
+  std::string active_space_id;
+  if (arc_spaces::SpacesController* const controller = GetController()) {
+    if (!spaces_changed_subscription_) {
+      spaces_changed_subscription_ =
+          controller->RegisterOnChanged(base::BindRepeating(
+              &ArcSpacesBarView::OnSpacesChanged, base::Unretained(this)));
+      // The tabs of the other spaces may show yet.
+      UpdateTabLists();
+    }
+    active_space_id = controller->active_space_id();
+    for (size_t i = 0; i < controller->spaces().size(); ++i) {
+      const arc_spaces::Space& space = controller->spaces()[i];
+      states.push_back({space.id, space.icon_id,
+                        arc_spaces::GetSpaceDisplayName(space, i)});
+    }
+  }
+  if (states == button_states_ && active_space_id == active_space_id_) {
+    return;
+  }
+  if (states == button_states_) {
+    // Only another space shows, as often as spaces switch.
+    active_space_id_ = std::move(active_space_id);
+    for (size_t i = 0; i < space_buttons_.size(); ++i) {
+      static_cast<SpaceButton*>(space_buttons_[i].get())
+          ->SetCurrent(button_states_[i].id == active_space_id_);
+    }
+    scroll_to_active_ = true;
+    InvalidateLayout();
+    return;
+  }
+  button_states_ = std::move(states);
+  if (active_space_id != active_space_id_) {
+    scroll_to_active_ = true;
+  }
+  active_space_id_ = std::move(active_space_id);
+
+  space_buttons_.clear();
+  spaces_view_->RemoveAllChildViews();
+  if (new_space_button_) {
+    RemoveChildViewT(new_space_button_.ExtractAsDangling());
+  }
+  if (!button_states_.empty()) {
+    for (size_t i = 0; i < button_states_.size(); ++i) {
+      const SpaceButtonState& state = button_states_[i];
+      auto button = std::make_unique<SpaceButton>(
+          base::BindRepeating(&ArcSpacesBarView::SwitchToSpace,
+                              base::Unretained(this), state.id),
+          GetIconForSpace(state.icon_id), state.id == active_space_id_);
+      button->SetTooltipText(
+          i < kSpaceShortcutCount
+              ? state.name + u" (⌃" + base::NumberToString16(i + 1) + u")"
+              : state.name);
+      button->GetViewAccessibility().SetName(state.name);
+      button->set_context_menu_controller(this);
+      space_buttons_.push_back(spaces_view_->AddChildView(std::move(button)));
+    }
+
+    auto new_space_button = std::make_unique<views::ImageButton>(
+        base::BindRepeating(&ArcSpacesBarView::CreateSpace,
+                            base::Unretained(this)));
+    // Drawn on the 24 dp grid of the downloads icon, so that both match.
+    new_space_button->SetImageModel(
+        views::Button::STATE_NORMAL,
+        ui::ImageModel::FromVectorIcon(vector_icons::kAddWeight500CustomIcon,
+                                       kColorToolbarButtonIcon,
+                                       kNewSpaceIconSize));
+    new_space_button->SetImageHorizontalAlignment(
+        views::ImageButton::ALIGN_CENTER);
+    new_space_button->SetImageVerticalAlignment(
+        views::ImageButton::ALIGN_MIDDLE);
+    new_space_button->SetPreferredSize(gfx::Size(kButtonSize, kButtonSize));
+    new_space_button->SetTooltipText(u"New Space");
+    new_space_button->GetViewAccessibility().SetName(u"New Space");
+    ConfigureInkDrop(new_space_button.get());
+    new_space_button_ = AddChildView(std::move(new_space_button));
+  }
+  PreferredSizeChanged();
+}
+
+void ArcSpacesBarView::UpdateTabLists() {
+  if (const arc_spaces::SpacesController* const controller = GetController()) {
+    listed_space_id_ = controller->shown_space_id();
+    listed_tab_spaces_version_ = controller->tab_spaces_version();
+  }
+  // The pinned and the other tabs of the sidebar; see their layouts.
+  views::View* sidebar = this;
+  while (sidebar && !views::IsViewClass<VerticalTabStripRegionView>(sidebar)) {
+    sidebar = sidebar->parent();
+  }
+  if (!sidebar) {
+    return;
+  }
+  std::vector<views::View*> pending = {sidebar};
+  while (!pending.empty()) {
+    views::View* const view = pending.back();
+    pending.pop_back();
+    if (views::IsViewClass<PinnedTabContainerView>(view) ||
+        views::IsViewClass<UnpinnedTabContainerView>(view)) {
+      // At once: tabs sliding in and out read as tabs opening and closing.
+      if (view->GetProperty(kHasAnimatingLayoutManagerKey)) {
+        const std::vector<const views::View*> children(
+            view->children().begin(), view->children().end());
+        static_cast<TabCollectionAnimatingLayoutManager*>(
+            view->GetLayoutManager())
+            ->ResetViewsToTargetLayout(children);
+        // A container left without tabs prefers no size, which its scroll
+        // view takes as keeping the size it had: drop that, or the tabs
+        // overflow, scrolling and drawing the overflow line.
+        if (view->GetPreferredSize().IsEmpty()) {
+          view->SetSize(gfx::Size(view->width(), 0));
+        }
+      } else {
+        view->InvalidateLayout();
+      }
+      continue;
+    }
+    for (views::View* const child : view->children()) {
+      pending.push_back(child);
+    }
+  }
+}
+
+void ArcSpacesBarView::SwitchToSpace(const std::string& id) {
+  if (GetController() && !TabDragController::IsActive()) {
+    slide_->SlideTo(id);
+  }
+}
+
+void ArcSpacesBarView::BeginSwipe(int direction) {
+  swipe_follows_ = GetController() && !TabDragController::IsActive() &&
+                   slide_->BeginTracking(direction);
+}
+
+void ArcSpacesBarView::UpdateSwipe(float offset) {
+  if (swipe_follows_) {
+    slide_->UpdateTracking(offset);
+  }
+}
+
+void ArcSpacesBarView::EndSwipe(float offset, float velocity) {
+  // Unless the slide gave up, e.g. for want of a snapshot.
+  const bool followed = swipe_follows_ && slide_->IsActive();
+  swipe_follows_ = false;
+  if (followed) {
+    slide_->EndTracking(velocity);
+    return;
+  }
+  // The tabs couldn't follow: switch once the swipe went far enough.
+  constexpr float kSwitchDistance = 60;
+  arc_spaces::SpacesController* const controller = GetController();
+  if (controller && !TabDragController::IsActive() &&
+      std::abs(offset) >= kSwitchDistance) {
+    controller->SwitchBy(offset < 0 ? 1 : -1);
+  }
+}
+
+void ArcSpacesBarView::CreateSpace() {
+  if (GetController()) {
+    ShowSpaceEditor(browser_, std::string());
+  }
+}
+
+views::View* ArcSpacesBarView::GetSwipeArea() {
+  // The footer, then the column of the sidebar's contents.
+  return parent() ? parent()->parent() : nullptr;
+}
