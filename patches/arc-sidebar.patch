+void ArcSidebarHeaderView::UpdateAddress() {
+  std::u16string address;
+  std::u16string full_url;
+  const gfx::VectorIcon* security_icon = nullptr;
+  ToolbarView* const toolbar = browser_view_->toolbar();
+  LocationBarView* const location_bar =
+      toolbar ? toolbar->location_bar_view() : nullptr;
+  if (location_bar && location_bar->GetLocationBarModel()) {
+    const LocationBarModel* const model = location_bar->GetLocationBarModel();
+    address = model->GetURLForDisplay(/*trim_after_host_name=*/true);
+    full_url = model->GetFormattedFullURL();
+    security_icon = &model->GetVectorIcon();
+  }
+
+  // The site's info button, for a site only.
+  const bool show_page_info = !address.empty() && security_icon;
+  page_info_button_->SetVisible(show_page_info);
+  if (show_page_info) {
+    page_info_button_->SetImageModel(
+        views::Button::STATE_NORMAL,
+        ui::ImageModel::FromVectorIcon(*security_icon, kColorOmniboxText,
+                                       kPageInfoIconSize));
+  }
+
+  if (base::StartsWith(address, kWwwPrefix)) {
+    address = address.substr(std::char_traits<char16_t>::length(kWwwPrefix));
+  }
+
+  if (address.empty()) {
+    address_button_->SetText(kEmptyAddressText);
+    address_button_->SetEnabledTextColors(ui::kColorSysStateDisabled);
+  } else {
+    address_button_->SetText(address);
+    address_button_->SetEnabledTextColors(kColorOmniboxText);
+  }
+  address_button_->SetTooltipText(full_url);
+  address_button_->GetViewAccessibility().SetName(
+      full_url.empty() ? std::u16string(address_button_->GetText())
+                       : full_url);
+}
+
+bool ArcSidebarHeaderView::IsPositionInWindowCaption(const gfx::Point& point) {
+  const auto hits = [&](views::View* view) {
+    return view->GetVisible() &&
+           view->HitTestPoint(views::View::ConvertPointToTarget(this, view,
+                                                                point));
+  };
+  if (hits(sidebar_button_)) {
+    return false;
+  }
+  for (views::View* child : navigation_host_->children()) {
+    if (hits(child)) {
+      return false;
+    }
+  }
+  return !hits(address_pill_);
+}
+
+gfx::Size ArcSidebarHeaderView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(0, GetCaptionRowHeight() + kRowSpacing +
+                          address_pill_->GetPreferredSize().height() +
+                          kBottomPadding);
+}
+
+void ArcSidebarHeaderView::Layout(PassKey) {
+  const int caption_row_height = GetCaptionRowHeight();
+  navigation_host_->SetBounds(0, 0, width(), caption_row_height);
+  sidebar_button_->SetBounds(browser_view_->GetWidget() &&
+                                     browser_view_->IsFullscreen()
+                                 ? kFullscreenSidebarButtonX
+                                 : kSidebarButtonX,
+                             (caption_row_height - kSidebarButtonSize) / 2,
+                             kSidebarButtonSize, kSidebarButtonSize);
+  address_pill_->SetBounds(0, caption_row_height + kRowSpacing, width(),
+                           address_pill_->GetPreferredSize().height());
+}
