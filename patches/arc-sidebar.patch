+// The dots of the colors on the field, on a layer of their own so that
+// dragging them leaves the grid painted.
+class SpaceThemeColorDots : public views::View {
+  METADATA_HEADER(SpaceThemeColorDots, views::View)
+
+ public:
+  using PositionCallback = base::RepeatingCallback<gfx::PointF(size_t)>;
+
+  explicit SpaceThemeColorDots(PositionCallback get_position)
+      : get_position_(std::move(get_position)) {
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    SetCanProcessEventsWithinSubtree(false);
+  }
+  SpaceThemeColorDots(const SpaceThemeColorDots&) = delete;
