+  // A soft shadow around the page, like Arc's, in place of the outline. It
+  // falls to the bottom left, within the padding around the page. The active
+  // pane of a split glows instead, light on a dark frame, like Arc's.
+  {
+    gfx::ScopedCanvas scoped_canvas(canvas);
+    canvas->sk_canvas()->clipPath(path, SkClipOp::kDifference,
+                                  /*do_anti_alias=*/true);
