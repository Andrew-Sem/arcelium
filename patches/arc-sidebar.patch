+  // pane of a split, see ContentsContainerView.
+  const auto get_path = [this](const views::View* container)
+      -> std::optional<SkPath> {
+    const ContentsContainerOutline* outline = nullptr;
+    for (const views::View* child : container->children()) {
+      if ((outline = views::AsViewClass<ContentsContainerOutline>(child))) {
+        break;
+      }
+    }
+    if (!outline) {
+      return std::nullopt;
+    }
+    const float inset = container->GetInsets().left();
+    const gfx::RoundedCornersF& outer_radii = outline->corner_radii();
+    const auto inner = [inset](float radius) {
+      return std::max(0.0f, radius - inset);
+    };
